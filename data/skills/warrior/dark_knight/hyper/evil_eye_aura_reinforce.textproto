# The eye's own aura pours a flat 24 HP every 24 seconds, which is a rounding
# error against a 4th job pool -- and is the whole reason this exists. The
# share stands BESIDE that pulse rather than replacing it: two fountains are
# two pulses here, and what the flat one adds at this level is nothing.
name: "Evil Eye - Aura Reinforce"
description: "Increases the amount healed by the Evil Eye."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 6 }
hyper: true
required_level: 180
max_level: 1
base {
  regen_pct: 0.10
  regen_interval_seconds: 24.0
}
