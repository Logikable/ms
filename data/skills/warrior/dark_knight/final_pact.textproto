# GMS offers four pacts and the player accepts one; this is the Full pact, the
# one whose invincibility is worth having and whose cooldown is longest. The
# invincibility isn't modelled: 40 seconds of it just means fighting on, which a
# full HP bar already gives. The kills that shorten the cooldown are dropped
# with it.
name: "Final Pact"
description:
  "When your HP reaches 0, your dark contract keeps you alive. Permanently "
  "increases Final Damage, Critical Rate, and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 4 }
max_level: 30
exceeds_master_level: true
base {
  final_dmg_pct: 0.01
  crit_rate: 0.013
  crit_dmg: 0.0485
  revive_cooldown_seconds: 1103
}
per_level {
  final_dmg_pct: 0.01
  crit_rate: 0.003
  crit_dmg: 0.0035
  revive_cooldown_seconds: -7
}
