# One skill, and the fight decides how long to hold it (see
# CombatSim::ChannelPulses): released at the minimum on a map, held for all 26
# pulses on a boss.
#
# GMS heals 1% of HP per attack and 10% per final attack, a full heal on
# purpose. Both are stated as GMS states them, so anything that ever reduces
# healing reduces the right number.
name: "Calamitous Cyclone"
description:
  "Swings a spear so fast it creates a dark storm and devastates the area in "
  "front of you."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 870
cooldown_seconds: 120.0
max_enemies: 12
lines: 8
base {
  skill_pct: 2.64
  crit_rate: 1.00
  ied_pct: 0.50
  hp_recover_pct: 0.01
}
per_level { skill_pct: 0.11 }
channel {
  pulse_interval_ms: 140
  max_pulses: 26
  finish_delay_ms: 720
  damage_taken_pct: 0.50
  finish {
    label: "Shockwave"
    lines: 15
    casts: 8
    base {
      skill_pct: 5.87
      hp_recover_pct: 0.10
    }
    per_level { skill_pct: 0.23 }
  }
}
