# GMS casts this on the party for 300 seconds at a time, a buff only in the way
# Hyper Body is: a player keeps it up all the time. Here it is a permanent
# passive for the whole party, like every such skill.
#
# Maxed at 20 instead of GMS's 30 to fill the book's 200, ending at GMS's top
# pair: 20% critical rate and 15% critical damage. Both ladders step by their
# level-1 value, so each level is an equal share.
name: "Sharp Eyes"
description:
  "Grants party members the ability to locate an enemy's weak spot to deal "
  "fatal damage to that enemy."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 5 }
exclusive_group: "Sharp Eyes"
max_level: 20
exceeds_master_level: true
base {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
per_level {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
ally_base {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
ally_per_level {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
