# GMS only gives the final damage against an enemy already pierced or held;
# Scarring Sword is what pierces, so the condition is real here.
name: "Chance Attack"
description:
  "Deals greater damage when attacking weakened enemies. Permanently "
  "increases Critical Rate."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 6 }
max_level: 10
base {
  final_dmg_pct_when_scarred: 0.07
  crit_rate: 0.02
}
per_level {
  final_dmg_pct_when_scarred: 0.02
  crit_rate: 0.02
}
