# GMS: 10+x% final damage, jumping 5 at 10, 5 at 20 and 10 at 30.
# GMS's "Repeating Crossbow Cartridge Boost" is cut to fit the panel.
# The cartridge's damage is the Full Burst Shot it loads, filed under that name.
name: "Crossbow Cartridge Boost"
description: "Boosts Repeating Crossbow Cartridge."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_VI skill_order: 4 }
hexa_node: HEXA_NODE_KIND_ENHANCEMENT
max_level: 30
required_skill { skill_name: "Repeating Crossbow Cartridge" level: 30 }
boost {
  skill_name: "Full Burst Shot"
  effect { final_dmg_pct: 0.11 }
  effect_per_level { final_dmg_pct: 0.01 }
  step { from_level: 10 effect { final_dmg_pct: 0.05 } }
  step { from_level: 20 effect { final_dmg_pct: 0.05 } }
  step { from_level: 30 effect { final_dmg_pct: 0.10 } }
}
