# GMS's thirty levels are twenty here, ending at GMS's level-30 figures.
#
# GMS's critical damage adds 5% for the weapon held, and every weapon this skill
# works with got it, so it is folded into the base. The blunt weapon's Ignore
# DEF is the only weapon bonus left.
name: "High Paladin"
description:
  "Increases Weapon Mastery, DEF, Critical Rate, Critical Damage, Ignore "
  "Defense, and Final Damage through your extensive experience as a Paladin."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 7 }
max_level: 20
exceeds_master_level: true
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
required_skill {
  skill_name: "Weapon Mastery"
  level: 10
}
base {
  mastery: 0.51
  def: 115
  crit_rate: 0.115
  crit_dmg: 0.125
  ied_pct: 0.167
  final_dmg_pct: 0.16
}
per_level {
  mastery: 0.01
  def: 15
  crit_rate: 0.015
  crit_dmg: 0.005
  ied_pct: 0.007
  final_dmg_pct: 0.01
}
weapon_bonus {
  required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
  effect { ied_pct: 0.10 }
}
