# The mastery skill, over 20 levels instead of GMS's 10 so the book costs the 90
# SP the Bandit's levels give. Mastery goes from 12% to 50%, the same climb as
# every other 20-level mastery, and final damage ends at GMS's 9%.
name: "Dagger Mastery"
description: "Increases Dagger Mastery and Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BANDIT skill_order: 6 }
max_level: 20
required_equip_type: EQUIP_TYPE_DAGGER
base {
  mastery: 0.12
  final_dmg_pct: 0.033
}
per_level {
  mastery: 0.02
  final_dmg_pct: 0.003
}
