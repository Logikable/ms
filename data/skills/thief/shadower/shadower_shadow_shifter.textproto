# The Night Lord's, to the number: GMS gives both branches a 45% chance at
# master that a wooden doll takes the hit instead. The knockback resistance
# beside it goes, as every other one has.
name: "Shadow Shifter"
description:
  "Grants a chance to summon a wooden doll to take damage in your place."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 8 }
max_level: 10
exceeds_master_level: true
base { dodge_chance: 0.36 }
per_level { dodge_chance: 0.01 }
