# GMS names Piercing Arrow, which Piercing Arrow II supersedes. A boost keyed to
# the superseded name reaches nothing, so this targets the arrow a Marksman
# actually fires. GMS also names the empowered form, which Greater Empowered
# Arrows grants, so each grant covers both.
name: "Piercing Arrow II Boost"
description: "Strengthens Piercing Arrow II and its empowered form."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 9 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Piercing Arrow II"
  reach: BOOST_REACH_BOTH
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Piercing Arrow II"
  reach: BOOST_REACH_BOTH
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Piercing Arrow II"
  reach: BOOST_REACH_BOTH
  min_level: 40
  effect { ied_pct: 0.20 }
}
