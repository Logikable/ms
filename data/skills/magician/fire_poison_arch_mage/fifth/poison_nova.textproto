# The F/P's second job node, and the branch's other half: DoT Punisher pays for
# the poison already laid, this one lays a nuke and waits to set it off.
#
# Fifteen clouds ride out in a ring, and GMS is explicit that an enemy takes
# only one of them -- so the cast itself is a plain wide swing rather than a
# scattered one, twelve lines on each of the fifteen it can find. The reach is
# the cloud count: sixteen enemies and the sixteenth is untouched.
#
# The detonation is where the damage is, and it is not a key of its own. GMS
# leaves the clouds standing and lets Mist Eruption set them off, so it is a
# magazine spent by that press: one charge, gone with the clouds whether or not
# it was used, and the swing costs the player nothing beyond the button they
# were pressing anyway. Fifteen bursts spread over twelve enemies, no enemy
# taking more than the three GMS allows -- so a lone boss takes three of the
# fifteen and the rest find nothing.
#
# GMS's "1 sec. or more after" is not modelled and cannot bind: Poison Nova's
# own 660ms plus Mist Eruption's wait is always longer than the second.
#
# The clouds' own lifetime is unpublished. Ten seconds is the burn they lay,
# which is the same thing said the other way -- the cloud IS the poison.
name: "Poison Nova"
description:
  "Releases a poisonous cloud that spreads in all directions, striking "
  "nearby enemies. You can detonate the cloud to inflict additional damage. "
  "Unaffected by attack reflection."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
cooldown_seconds: 25.0
max_enemies: 15
lines: 12
base { skill_pct: 2.60 }
per_level { skill_pct: 0.10 }
dot {
  interval_seconds: 1.0
  duration_seconds: 10.0
  lines: 1
  base { skill_pct: 3.12 }
  per_level { skill_pct: 0.12 }
}
buff {
  duration_seconds: 10.0
  raised_on_cast: true
  magazine {
    label: "Nova Detonation"
    spent_by_skill_name: "Mist Eruption"
    charges: 1
    max_enemies: 12
    lines: 12
    scatter {
      hits: 15
      max_hits_per_enemy: 3
    }
    base { skill_pct: 7.02 }
    per_level { skill_pct: 0.27 }
  }
}
