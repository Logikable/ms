# GMS's Opportunity charges two orbs at once; orbs are always full here, so it
# is renamed for the DEF it gives instead, worthless on purpose (see
# SkillEffect.def_pct).
name: "Advanced Combo Attack - Barricade"
description:
  "DEF increased for each additional Combo Orb."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 5 }
hyper: true
required_level: 150
max_level: 1
base { def_per_combo_orb: 100 }
