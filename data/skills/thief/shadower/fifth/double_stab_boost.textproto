# GMS's fifth node is Phase Dash alone, which isn't built here: Midnight
# Carnival already carries Phase Dash's damage, and one button was chosen over
# two. Double Stab takes the node at 5% a level instead of GMS's 3%: it is the
# one swing no other node in the book takes, and a 1st job attack needs the
# better rate to be worth 80 VP. The dagger it needs keeps it the Shadower's, as
# the claw keeps Lucky Seven the Night Lord's.
name: "Double Stab Boost"
description: "Strengthens Double Stab."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 9 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Double Stab"
  effect { final_dmg_pct: 0.05 }
  effect_per_level { final_dmg_pct: 0.05 }
}
boost {
  skill_name: "Double Stab"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Double Stab"
  min_level: 40
  effect { ied_pct: 0.20 }
}
