# The Paladin's single-target swing: ten strikes on three enemies, where Divine
# Charge spreads four across eight. It is mainly for bosses, and on a map it is
# what a Paladin uses when one enemy is left.
#
# GMS's own ladder, 250+3x%, so a maxed Blast strikes ten times for 340%.
name: "Blast"
description:
  "Call upon the full divine might of the Paladin to deal a powerful blow to "
  "your enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 2 }
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
exceeds_master_level: true
tags: SKILL_TAG_HOLY_POWER
base_delay_ms: 660
max_enemies: 3
lines: 10
base { skill_pct: 2.53 }
per_level { skill_pct: 0.03 }
