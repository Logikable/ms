name: "Gloom"
difficulties {
  # GMS's own level (255) is kept, fifteen over the gate.
  name: "Normal"
  phases {
    bgm: "FerociousBattlefield"
    spawns {
      mob: "gloom"
      spots { x: 4 y: 2 }
      giant: true
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    # The two tentacles GMS strikes with every 55 seconds, stood on as
    # platforms until they retract.
    timed_spots {
      interval_ms: 55000
      open_ms: 20000
      spots { x: 1 y: 4 }
      spots { x: 7 y: 4 }
      spots { x: 2 y: 3 }
      spots { x: 6 y: 3 }
      spots { x: 2 y: 1 }
      spots { x: 6 y: 1 }
      spots { x: 1 y: 0 }
      spots { x: 7 y: 0 }
    }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 1800
  unlock_level: 240
  arcane_force: 730
  # Five Intense Power Crystals at GMS's price (59,535,000), divided by seven and
  # rounded to the nearest 50k.
  meso: 42550000
  # GMS lists no EXP on the body.
  exp: 0
  drops {
    item: "glooms_soul_shard"
    per_kill: 1.0
  }
  # GMS never published the odds. Dawn is tier 2: 1/10 days x 2, split with
  # Darknell.
  drops {
    equip: "estella_earrings"
    per_kill: 0.1
  }
}
difficulties {
  name: "Chaos"
  phases {
    bgm: "FerociousBattlefield"
    spawns {
      mob: "chaos_gloom"
      spots { x: 4 y: 2 }
      giant: true
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    # The two tentacles GMS strikes with every 55 seconds, stood on as
    # platforms until they retract.
    timed_spots {
      interval_ms: 55000
      open_ms: 20000
      spots { x: 1 y: 4 }
      spots { x: 7 y: 4 }
      spots { x: 2 y: 3 }
      spots { x: 6 y: 3 }
      spots { x: 2 y: 1 }
      spots { x: 6 y: 1 }
      spots { x: 1 y: 0 }
      spots { x: 7 y: 0 }
    }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 1800
  unlock_level: 240
  arcane_force: 730
  # Five Intense Power Crystals at GMS's price (112,789,000), divided by seven and
  # rounded to the nearest 50k.
  meso: 80550000
  # GMS lists no EXP on the body.
  exp: 0
  drops {
    item: "glooms_soul_shard"
    per_kill: 1.0
  }
  # GMS never published the odds. Dawn is tier 2: 1/10 days x 2, split with
  # Darknell, x2 for Chaos.
  drops {
    equip: "estella_earrings"
    per_kill: 0.2
  }
  # GMS never published the odds. The boxes pay one piece for every three the
  # coins buy across the tier, shared with fights that drop no coin.
  drops {
    item: "arcane_umbra_weapon_box"
    per_kill: 0.0222
  }
  drops {
    item: "arcane_umbra_armor_box"
    per_kill: 0.0667
  }
  # GMS never published the odds. Pitched is tier 3: 1/20 days x 2, x2 for Hard.
  drops {
    equip: "endless_terror"
    per_kill: 0.2
  }
  # The user's planned rate (2026-10-04): GMS publishes none.
  drops {
    item: "black_jade_boss_ring_box"
    per_kill: 0.02
  }
  # The scroll rates are the user's (2026-10-04); GMS publishes none.
  drops {
    item: "premium_scroll_for_accessory"
    per_kill: 0.5
  }
  drops {
    item: "premium_scroll_for_pet"
    per_kill: 0.5
  }
  drops {
    item: "magical_scroll_for_weapon"
    per_kill: 0.1
  }
}
