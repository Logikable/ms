# The avoidability is left out: GMS's is the avoid stat, not the flat roll
# dodge_chance models. The DEF is worth nothing (see SkillEffect.def_pct).
name: "Shield Mastery"
description:
  "Increases DEF and Attack Power when a secondary weapon is equipped, and "
  "reduces damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BANDIT skill_order: 8 }
max_level: 10
requires_secondary: true
base {
  damage_taken_pct: 0.06
  def_pct: 0.11
  attack: 2
}
per_level {
  damage_taken_pct: 0.06
  def_pct: 0.11
  attack: 2
}
