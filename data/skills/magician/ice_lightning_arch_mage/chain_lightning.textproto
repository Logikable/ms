# The swing the class lives on, wide enough to mob with and heavy enough to
# boss with: ten strikes on six enemies, and a critical rate that rides this
# swing and hands nothing to the next one.
#
# GMS's stun is dropped -- nothing here can be stunned -- and with it the line
# about the bolt arcing between nearby targets, which is only how GMS draws
# reaching six enemies at once.
name: "Chain Lightning"
skill_order: 1
description:
  "Attack the target with a high-voltage lightning-attribute attack with a "
  "high critical rate. Chain Lightning can chain attack targets near the "
  "target."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_LIGHTNING
job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 6
lines: 10
base {
  skill_pct: 1.33
  crit_rate: 0.105
}
per_level {
  skill_pct: 0.03
  crit_rate: 0.005
}
