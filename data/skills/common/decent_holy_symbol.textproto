# See decent_sharp_eyes.textproto for the shape all six share. The exception:
# GMS gives this one no All Stats; its two halves climb instead, 20+floor(x/2)%
# EXP and 14+floor(x/3)% drop rate, ending at 35 and 24. Both keep those tops
# with a simple step of half a point a level, which only moves where they start.
#
# The Priest's own skill beats the EXP from its tenth level. It has no drop
# rate, so that half always applies; the group decides one lever at a time.
name: "Decent Holy Symbol"
description:
  "Gain extra EXP and items when hunting monsters. Does not stack with Holy "
  "Symbol."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 8 }
v_node: V_NODE_KIND_COMMON
exclusive_group: "Holy Symbol"
max_level: 30
base {
  exp_pct: 0.205
  item_drop_pct: 0.095
}
per_level {
  exp_pct: 0.005
  item_drop_pct: 0.005
}
