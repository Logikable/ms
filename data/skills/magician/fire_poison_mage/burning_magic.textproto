# GMS lists the same five conditions as Storm Magic and gives 5+x% against an
# enemy with any of them. The F/P's is a burn, so it pays on whatever Poison
# Breath, Poison Mist, Flame Sweep or Ifrit has set burning, which is nearly
# everything the class fights, as intended.
#
# GMS's other half is dropped: it lengthens every burn by 50+5x%, and a burn
# already lasts longer than it takes to relight it, so nothing would change.
name: "Burning Magic"
description:
  "Increases your Final Damage against enemies taking continuous damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 7 }
max_level: 10
base { final_dmg_pct_when_afflicted: 0.06 }
per_level { final_dmg_pct_when_afflicted: 0.01 }
