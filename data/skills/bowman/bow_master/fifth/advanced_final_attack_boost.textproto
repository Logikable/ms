# GMS's node 5 is Covering Fire and Swift Surge, which don't exist here, and
# every other swing in the line is taken. So Final Attack gets the page alone,
# at GMS's node-5 rate of 3% a level instead of the 2% it gets sharing node 1.
#
# It targets Advanced Final Attack, not Final Attack: Bow, which GMS names. The
# later skill supersedes the earlier one, and a boost keyed to the superseded
# name reaches nothing.
name: "Advanced Final Attack Boost"
description: "Strengthens Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_V skill_order: 9 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Advanced Final Attack"
  effect { final_dmg_pct: 0.03 }
  effect_per_level { final_dmg_pct: 0.03 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 40
  effect { ied_pct: 0.20 }
}
