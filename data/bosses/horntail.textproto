name: "Horntail"
difficulties {
  name: "Normal"
  # Two heads fought one at a time before the dragon himself, as in GMS. Each
  # stands against the edge its name says, at the top of the arena, with the
  # player out at that same end of it rather than back in the middle.
  phases {
    spawns { mob: "horntail_left_head" spots { x: 8 y: 0 } }
    # Three along the top and three along the bottom, running from under the
    # head out across the floor.
    player_spots { x: 6 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 6 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 5 y: 0 }
    player_spots { x: 5 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "horntail_right_head" spots { x: 0 y: 0 } }
    # The same six, mirrored: this head stands in the other corner.
    player_spots { x: 2 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 2 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 3 y: 0 }
    player_spots { x: 3 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  # The whole dragon at once, laid out the way his sprite is: three heads over
  # a pair of hands and the wings, the legs and the tail beneath them, and the
  # player on the floor to the left of all of it.
  phases {
    spawns { mob: "horntail_head_a" spots { x: 2 y: 0 } }
    spawns { mob: "horntail_head_b" spots { x: 4 y: 0 } }
    spawns { mob: "horntail_head_c" spots { x: 6 y: 0 } }
    spawns { mob: "horntail_left_hand" spots { x: 2 y: 2 } }
    spawns { mob: "horntail_wings" spots { x: 4 y: 2 } }
    spawns { mob: "horntail_right_hand" spots { x: 6 y: 2 } }
    spawns { mob: "horntail_legs" spots { x: 4 y: 4 } }
    spawns { mob: "horntail_tails" spots { x: 6 y: 4 } }
    # Down both edges of the arena, level with the heads, the hands and the
    # legs: the dragon fills the middle, so the player goes around him.
    player_spots { x: 0 y: 4 }
    player_spots { x: 0 y: 0 }
    player_spots { x: 8 y: 0 }
    player_spots { x: 0 y: 2 }
    player_spots { x: 8 y: 2 }
    player_spots { x: 8 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twice what the other two allow, and still out of reach at the level he
  # opens at: the field kills him in 10 to 29 minutes on the gear of the day.
  # What the clock is for is the player who comes back twenty levels later.
  time_limit_seconds: 600
  unlock_level: 150
  # Five Intense Power Crystals at what his level fetches, as Zakum's and
  # Hilla's meso is.
  meso: 5062500
  # GMS pays the EXP for the clear and says no boost touches it, so it is
  # here rather than on the eight bodies.
  exp: 4611597
  drops {
    item: "horntails_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "silver_blossom_ring"
    per_kill: 1.0
  }
  drops {
    equip: "horntail_necklace"
    per_kill: 1.0
  }
  drops {
    equip: "dea_sidus_earring"
    per_kill: 1.0
  }
}
# The same three phases at the numbers GMS gives Chaos: 26.6B across the
# fight, the most HP in the game, and every part behind 50% PDR.
difficulties {
  name: "Chaos"
  phases {
    spawns { mob: "chaos_horntail_left_head" spots { x: 8 y: 0 } }
    # Three along the top and three along the bottom, running from under the
    # head out across the floor.
    player_spots { x: 6 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 6 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 5 y: 0 }
    player_spots { x: 5 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "chaos_horntail_right_head" spots { x: 0 y: 0 } }
    # The same six, mirrored: this head stands in the other corner.
    player_spots { x: 2 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 2 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 3 y: 0 }
    player_spots { x: 3 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "chaos_horntail_head_a" spots { x: 2 y: 0 } }
    spawns { mob: "chaos_horntail_head_b" spots { x: 4 y: 0 } }
    spawns { mob: "chaos_horntail_head_c" spots { x: 6 y: 0 } }
    spawns { mob: "chaos_horntail_left_hand" spots { x: 2 y: 2 } }
    spawns { mob: "chaos_horntail_wings" spots { x: 4 y: 2 } }
    spawns { mob: "chaos_horntail_right_hand" spots { x: 6 y: 2 } }
    spawns { mob: "chaos_horntail_legs" spots { x: 4 y: 4 } }
    spawns { mob: "chaos_horntail_tails" spots { x: 6 y: 4 } }
    # Down both edges of the arena, level with the heads, the hands and the
    # legs: the dragon fills the middle, so the player goes around him.
    player_spots { x: 0 y: 4 }
    player_spots { x: 0 y: 0 }
    player_spots { x: 8 y: 0 }
    player_spots { x: 0 y: 2 }
    player_spots { x: 8 y: 2 }
    player_spots { x: 8 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # What every fight past the level-160 gate allows.
  time_limit_seconds: 600
  unlock_level: 190
  # Five Intense Power Crystals at what GMS prices Chaos Horntail's, as every
  # boss's meso is. Well under Arkarium's and Hard Hilla's for far more HP:
  # GMS's own number, kept.
  meso: 6760000
  # Paid for the clear, flat and untouched by any EXP bonus, as the other
  # seven are. GMS pays the hardest fight in the game the least of the late
  # bosses; the clear is for the necklace and the shard.
  exp: 8473319
  # What Normal drops, with the Chaos necklace in the plain one's place. The
  # shard is the same: a soul belongs to the boss, not to the rung.
  drops {
    item: "horntails_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "silver_blossom_ring"
    per_kill: 1.0
  }
  drops {
    equip: "chaos_horntail_necklace"
    per_kill: 1.0
  }
  drops {
    equip: "dea_sidus_earring"
    per_kill: 1.0
  }
}
