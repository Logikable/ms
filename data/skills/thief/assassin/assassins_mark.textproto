# GMS marks an enemy on hit and uses the mark on the next attack, throwing two
# stars for 150%. One level in GMS; ten here, climbing to GMS's figures from a
# little over half of them.
#
# In GMS the mark and its use are one beat apart; here they happen together, so
# what is left is a Final Attack: a chance, on every enemy the swing reached, of
# two more stars. It names no tag, so every swing can trigger it.
#
# The two stars are two lines, not one line worth double, so each rolls its own
# crit and mastery. 300% at max level either way.
name: "Assassin's Mark"
description:
  "Has a chance to tag the enemy with the assassin's mark when attacking. The "
  "next attack on a marked enemy will cause throwing stars to form on that "
  "enemy and attack other enemies nearby."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ASSASSIN skill_order: 2 }
max_level: 10
final_attack_label: "Mark"
base {
  final_attack_chance: 0.22
  final_attack_pct: 0.78
  final_attack_lines: 2
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.08
}
