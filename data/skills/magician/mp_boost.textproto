# The magician's counterpart to Archery Mastery: +1 attack speed stage flat, so
# the first point buys the swing, and a deepening MP pool for the rest. Its
# "+5% critical rate while holding a wand" is a weapon-type condition, which
# nothing here models.
name: "MP Boost"
description:
  "Increases Max MP and Attack Speed. Also increases MP proportional to your "
  "level."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MAGICIAN skill_order: 4 }
max_level: 20
base {
  attack_speed: 1
  max_mp_pct: 0.01
  max_mp_per_level: 25
}
per_level {
  max_mp_pct: 0.01
  max_mp_per_level: 5
}
