# Fourteen enemies against GMS's fifteen: the 500x400 sphere fits seven across
# over two storeys (see Skill.max_enemies).
#
# It picks its targets when the hold starts, so the fight holds it only while
# the pulses still have targets (see Channel).
name: "Lightning Orb"
description:
  "Creates a large, unstable sphere of electricity to continuously zap "
  "enemies."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_LIGHTNING
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 2 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 960
max_enemies: 14
lines: 15
cooldown_seconds: 60.0
base { skill_pct: 1.35 }
channel {
  pulse_interval_ms: 150
  max_pulses: 12
  finish_delay_ms: 200
  damage_taken_pct: 0.50
  finish {
    label: "Final Attack"
    lines: 15
    base { skill_pct: 7.02 }
  }
}
