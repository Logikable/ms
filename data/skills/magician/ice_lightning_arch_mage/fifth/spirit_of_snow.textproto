# A buff with a pulse instead of its own summon: Elquines and Thunder Sphere are
# permanent, and this one is up a quarter of its cooldown.
#
# Three seconds is GMS's `x`, the one number in its common block the tooltip
# never uses. The 810ms animation reading would make it 761,460%, far outside
# the balance range.
#
# GMS gives 3 Freeze Stacks "when attacking 1 enemy", a bossing bonus written
# into the skill, so the skill states both counts.
name: "Spirit of Snow"
description:
  "Summon the devastating frosts of the El Nath Mountains. They freeze what "
  "they touch."
kind: SKILL_KIND_ACTIVE
tags: SKILL_TAG_ICE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
freeze_seconds: 8.0
freeze_build {
  alone: 3
  crowd: 1
}
buff {
  duration_seconds: 30.0
  pulse {
    label: "Blizzard"
    cast_interval_seconds: 3.0
    lines: 12
    max_enemies: 10
    base { skill_pct: 8.16 }
    per_level { skill_pct: 0.31 }
  }
}
