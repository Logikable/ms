name: "Hilla"
difficulties {
  name: "Normal"
  # One phase, one monster: she stands alone in the middle of the arena with
  # the player under her, and there is nothing else to kill.
  phases { spawns { mob: "hilla" count: 1 } }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  unlock_level: 130
  # What GMS pays as an Intense Power Crystal, the same drop nobody keeps that
  # Zakum's meso stands in for: five of them at the price her level fetches.
  meso: 4000000
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "stone_of_eternal_life"
    per_kill: 0.5
  }
}
