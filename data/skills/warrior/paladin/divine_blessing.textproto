# GMS keeps this up for a couple of minutes at a time, with nothing stopping the
# player recasting it at once, so this game makes it permanent, like Cross Surge
# and Hyper Body. See Skill.buff for when a buff really must be timed.
#
# Twenty levels instead of GMS's thirty, a point of final damage each, ending at
# GMS's 20%.
name: "Divine Blessing"
description: "A holy blessing increases your Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 5 }
max_level: 20
exceeds_master_level: true
base { final_dmg_pct: 0.01 }
per_level { final_dmg_pct: 0.01 }
