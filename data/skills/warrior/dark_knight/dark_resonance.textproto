# This buff really is timed: it lasts 30 seconds at max level on a 70-second
# cooldown, so a Dark Knight is buffed for part of a fight and not the rest, and
# every swing that lands takes a third of a second off the cooldown.
#
# The two Ignore DEF shares are one row because they apply as one source. GMS
# states 30% permanent and 10% while up; those combine to 37% instead of adding
# to 40%, and the ladder climbs to that.
name: "Dark Resonance"
description:
  "Resonate with your Evil Eye to unlock the power of pure darkness. Restores "
  "HP and increases Final Damage, Ignore Defense and Boss Damage for a time. "
  "Permanently increases Ignore Defense."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 3 }
max_level: 30
exceeds_master_level: true
base_delay_ms: 120
cooldown_seconds: 70.0
base { ied_pct: 0.01 }
per_level { ied_pct: 0.01 }
buff {
  duration_seconds: 15.5
  duration_seconds_per_level: 0.5
  cooldown_reduction_seconds: 0.35
  base {
    heal_pct: 0.13
    final_dmg_pct: 0.022
    ied_pct: 0.013
    boss_pct: 0.063
  }
  per_level {
    heal_pct: 0.03
    final_dmg_pct: 0.002
    ied_pct: 0.003
    boss_pct: 0.003
  }
}
