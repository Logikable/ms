# The orbs are assumed full: a fight paid in expected damage has no place for a
# counter. Stated per orb, because a later skill raises only the count.
name: "Combo Attack"
description: "Grants a chance to add each attack to the Combo Orb."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 3 }
max_level: 1
combo_orbs: 5
base { attack_per_combo_orb: 2 }
