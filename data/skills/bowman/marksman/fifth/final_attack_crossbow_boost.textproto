# GMS's node 5 is Covering Fire and Swift Surge, which don't exist here, and
# every other swing in the line is taken. So Final Attack gets the page alone,
# at GMS's node-5 rate of 3% a level instead of the 4% it gets sharing node 4
# with High Speed Shot.
#
# Unlike the Bow Master's, this Final Attack neither supersedes nor is
# superseded, so the boost uses GMS's name directly.
name: "Final Attack: Crossbow Boost"
description: "Strengthens Final Attack: Crossbow."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 12 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Final Attack: Crossbow"
  effect { final_dmg_pct: 0.03 }
  effect_per_level { final_dmg_pct: 0.03 }
}
boost {
  skill_name: "Final Attack: Crossbow"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Final Attack: Crossbow"
  min_level: 40
  effect { ied_pct: 0.20 }
}
