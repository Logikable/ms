name: "Damien"
difficulties {
  name: "Normal"
  phases {
    bgm: "Demian Spine"
    spawns {
      mob: "damien_phase_1"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Demian True"
    spawns {
      mob: "damien_phase_2"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # GMS allows thirty minutes; twenty-five makes the timer part of the fight.
  time_limit_seconds: 1500
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price, divided by seven (GMS clears him
  # once a week, this game once a day), rounded to the nearest 50k.
  meso: 24150000
  # GMS pays this on the second body; here the clear pays it.
  exp: 22000000
  drops {
    item: "absolab_coin"
    per_kill: 1.0
  }
  drops {
    item: "damiens_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  # Not built yet: no time limit, unlock level or reward until it is.
  name: "Hard"
  coming_soon: true
  phases {
    bgm: "Demian Spine"
    spawns {
      mob: "hard_damien_phase_1"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Demian True"
    spawns {
      mob: "hard_damien_phase_2"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
}
