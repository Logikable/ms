name: "Guardian Angel Slime"
difficulties {
  name: "Normal"
  phases {
    bgm: "GuardianSlime-Battle"
    spawns {
      mob: "guardian_angel_slime"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        jump { interval_ms: 30000 y: 2 hang_ms: 660 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # GMS allows thirty minutes.
  time_limit_seconds: 1500
  # GMS unlocks her at 210 with the Black Heaven fights; ten levels later marks
  # her as the step above them.
  unlock_level: 220
  # Five Intense Power Crystals at GMS's price, divided by seven (GMS clears her
  # once a week, this game once a day), rounded to the nearest 50k.
  meso: 33100000
  # GMS lists no EXP for her.
  exp: 0
  # GMS rolls her ring from a chest opened after the fight; only the roll is
  # kept here.
  drops {
    equip: "guardian_angel_ring"
    per_kill: 0.2
  }
  drops {
    item: "guardian_angel_slimes_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Chaos"
  phases {
    bgm: "GuardianSlime-Battle"
    spawns {
      mob: "chaos_guardian_angel_slime"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        jump { interval_ms: 30000 y: 2 hang_ms: 660 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 1800
  unlock_level: 220
  # Five Intense Power Crystals at GMS's price (120,115,625), divided by seven and
  # rounded to the nearest 50k.
  meso: 85800000
  # GMS lists no EXP for her.
  exp: 0
  # GMS rolls her ring from a chest opened after the fight; only the roll is
  # kept here.
  drops {
    equip: "guardian_angel_ring"
    per_kill: 0.4
  }
  drops {
    item: "guardian_angel_slimes_soul_shard"
    per_kill: 1.0
  }
  # The user's planned rate (2026-10-04): GMS publishes none.
  drops {
    item: "black_jade_boss_ring_box"
    per_kill: 0.02
  }
  # The scroll rates are the user's (2026-10-04); GMS publishes none.
  drops {
    item: "premium_scroll_for_accessory"
    per_kill: 0.5
  }
  drops {
    item: "premium_scroll_for_pet"
    per_kill: 0.5
  }
  drops {
    item: "magical_scroll_for_weapon"
    per_kill: 0.1
  }
}
