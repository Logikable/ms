# GMS's own numbers throughout. The client says 10 attacks and "Number of
# Explosions: 2" -- a cast sets off two mists at once, so an enemy caught by
# both takes the ten hits twice. Twenty lines of 95+x%.
#
# The final damage is GMS's too: it pays +20% for two explosions, climbing to
# +125% for five. Nothing here places a mist, so the count cannot vary and the
# skill keeps the figure its own pair of explosions earns. It rides this swing
# alone, the way an attack's ignored defence does.
#
# The defence it ignores climbs with the skill, as GMS's 10+x% does, and ends
# where GMS ends.
#
# The passive raises Poison Mist for good. What it lifts is the mist itself --
# the mark the cast leaves rather than the cast -- so it is points on the tick:
# 240% a second becomes 300% with this maxed.
name: "Mist Eruption"
skill_order: 2
description:
  "Permanently increases Poison Mist's continuous damage. Upon using the "
  "skill, nearby Poison Mists explode, dealing fatal poison damage to "
  "enemies."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
required_skill {
  skill_name: "Poison Mist"
  level: 20
}
base_delay_ms: 660
max_enemies: 12
lines: 20
cooldown_seconds: 10.0
base {
  skill_pct: 0.965
  ied_pct: 0.115
  final_dmg_pct: 0.20
}
per_level {
  skill_pct: 0.015
  ied_pct: 0.015
}
boost {
  skill_name: "Poison Mist"
  dot_skill_pct: 0.315
  dot_skill_pct_per_level: 0.015
}
