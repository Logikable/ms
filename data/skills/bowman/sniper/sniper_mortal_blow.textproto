# GMS rolls an L% chance of L*2% more damage and 1% of the pool back. Both are
# stated here as what one swing is worth, the way every chance in this game is:
# 2% of damage and a hundredth of a percent of HP a level.
#
# The damage is plain %Damage rather than final damage -- GMS files it beside
# Marksmanship, which sums with it.
#
# The MP half of the recovery is dropped: there is no MP pool to fill.
name: "Mortal Blow"
skill_order: 5
description: "Permanently increases your Damage, and puts HP back as you hit."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_SNIPER
max_level: 10
base {
  damage_pct: 0.002
  hp_recover_pct: 0.0001
}
per_level {
  damage_pct: 0.002
  hp_recover_pct: 0.0001
}
