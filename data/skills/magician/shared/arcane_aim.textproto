# GMS stacks this five times at a 95% chance per hit, so a character is always
# at five; that steady state is written flat, over twenty levels, not thirty.
name: "Arcane Aim"
description: "Ignores a portion of enemy DEF when attacking."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 8 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 9 }
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 10 }
max_level: 20
exceeds_master_level: true
base {
  damage_pct: 0.02
  ied_pct: 0.01
}
per_level {
  damage_pct: 0.02
  ied_pct: 0.01
}
