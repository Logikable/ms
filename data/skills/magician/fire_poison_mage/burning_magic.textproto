# GMS pays this out only against enemies already burning, poisoned or stunned,
# and stretches the burn besides. Nothing here suffers any of that and nothing
# tracks a duration, so what is left is GMS's 5+x% final damage, flat.
name: "Burning Magic"
skill_order: 7
description: "Permanently increases your Final Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE
max_level: 10
base { final_dmg_pct: 0.06 }
per_level { final_dmg_pct: 0.01 }
