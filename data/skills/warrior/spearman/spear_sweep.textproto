# Reach cut from GMS's 8 to 5. Its hitbox is 360x190, one storey of a map
# fitting 5 monsters side by side, so 8 is a cap GMS never fills but this fight
# would always fill. See Skill.max_enemies.
#
# GMS pulls and stuns everything it hits. The pull is dropped, since the fight
# has no positions. The two-second stun is our choice: GMS states no duration,
# which means the client hardcodes one.
name: "Spear Sweep"
description: "Swing your spear in a long arc, stunning the enemies around you."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 780
max_enemies: 5
lines: 4
stun { duration_seconds: 2.0 }
base { skill_pct: 0.67 }
per_level { skill_pct: 0.02 }
