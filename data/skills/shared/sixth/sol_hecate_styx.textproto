# GMS's Styx (500001006) stuns, which bosses here ignore, so only its damage
# is built. The Death Seed (500001011) ticks four times a second apart and
# then blooms (500001012) seven times. Both land with the wave, as Slash
# Shadow Formation's allies do: the seconds between them aren't priced.
#
# GMS halves the Night Lord's and Shadower's wave and bloom for Shadow Partner
# to double back. The seed is a debuff, so the shadow skips it.
#
# Cast mid-swing, like a bound skill. The client's action frames aren't
# traced; 960 is Phlegethon's first strike (multiAttackInfo), never charged.
name: "Sol Hecate: Styx"
description:
  "Releases a wave of concentrated Sol Erda to devastate enemies, sewing a "
  "seed of death into enemies struck. The seed will grow, dealing continuous "
  "damage to the host, before blooming to take their life."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_HERO_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_VI skill_order: 7 }
placement {
  job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE_VI
  skill_order: 7
}
placement {
  job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE_VI
  skill_order: 7
}
placement { job_advancement: JOB_ADVANCEMENT_BISHOP_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_VI skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_VI skill_order: 7 }
hexa_core: "Sol Hecate"
max_level: 30
base_delay_ms: 960
waives_cast: true
cooldown_seconds: 60.0
max_enemies: 15
lines: 8
base { skill_pct: 1.68 }
per_level { skill_pct: 0.11 }
step { from_level: 10 base { ied_pct: 0.20 boss_pct: 0.20 } }
step { from_level: 20 base { ied_pct: 0.20 boss_pct: 0.20 } }
extra_hit {
  label: "Death Seed"
  lines: 4
  casts: 4
  skips_mirror: true
  base { skill_pct: 1.63 }
  per_level { skill_pct: 0.11 }
}
extra_hit {
  label: "Death Seed Bloom"
  lines: 7
  casts: 7
  base { skill_pct: 2.02 }
  per_level { skill_pct: 0.12 }
}
# v271's per-job damage, from each part's attackInfo; the Hero's is the base.
# An override's extra hits replace the shared ones whole.
