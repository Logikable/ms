# GMS's twelve and five instead of one 48-line swing and a 25-line hit, so the
# log shows what GMS shows.
#
# The final damage starts at the cast: GMS says the explosions come "afterwards"
# and the final damage "upon use".
#
# Only an orb's final damage is raised, so a Hero with none gets nothing, which
# is GMS's "while Combo Attack is active" without a condition.
name: "Sword Illusion"
description:
  "Slice forward faster than the eye can see using a combo orb. Sword "
  "Illusion is unaffected by attack reflection."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
base_delay_ms: 660
cooldown_seconds: 30.0
max_enemies: 8
lines: 4
casts: 12
base { skill_pct: 1.30 }
per_level { skill_pct: 0.05 }
extra_hit {
  label: "Explosion"
  lines: 5
  casts: 5
  base { skill_pct: 2.60 }
  per_level { skill_pct: 0.10 }
}
buff {
  duration_seconds: 8.0
  raised_on_cast: true
  base { final_dmg_combo_orbs: 6 }
}
