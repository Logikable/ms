# One arrow to each of five enemies. GMS's "Arrows Fired: 3" is the AMMO a
# swing spends -- the client's bulletConsume -- and the skill states no attack
# count at all, unlike Wind Arrow, which states three.
name: "Arrow Blow"
skill_order: 1
description: "Shoot consecutive arrows at multiple enemies."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_ARCHER
max_level: 20
required_equip_type: EQUIP_TYPE_BOW
required_equip_type: EQUIP_TYPE_CROSSBOW
base_delay_ms: 750
max_enemies: 5
base { skill_pct: 1.22 }
per_level { skill_pct: 0.02 }
