description: "Increases the DEF ignored by Mist Eruption."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 11 }
hyper: true
required_level: 165
max_level: 1
boost {
  skill_name: "Mist Eruption"
  effect { ied_pct: 0.20 }
}
