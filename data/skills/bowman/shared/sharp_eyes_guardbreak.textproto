# The party half comes from the client. GMS stores this hyper's 5% in its own
# block with no psd flag and no target skill, the shape used for a value that is
# added to the Sharp Eyes buff. The Arrow Stream and Hurricane hypers all carry
# psd and name the skill they boost. Whatever is added to the buff reaches
# whoever the buff reaches.
#
# GMS states the party rule on Sharp Eyes's page, not here, so it is written out
# here instead of left out.
name: "Sharp Eyes - Guardbreak"
description:
  "Grants Sharp Eyes a bonus to Enemy DEF Ignored. Applies to party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 5 }
hyper: true
required_level: 150
max_level: 1
base { ied_pct: 0.05 }
ally_base { ied_pct: 0.05 }
