# Two halves, which GMS keeps separate: the Bishop's own is flat, and everyone
# else's grows with the Bishop's INT, then is capped to a share of what the
# Bishop kept (see AllyIntLever).
#
# GMS's INT steps are kept exactly, though a Bishop here tops out near 8,700 INT
# against GMS's 100,000+; rescaling them would make it a different skill.
#
# Both ladders are smoothed to end at GMS's max, `18+floor(x/2)` and
# `20+floor(x/3)`.
name: "Benediction"
description:
  "Calls upon your holy power to create a consecrated space that empowers and "
  "revitalizes your allies. Increases your Final Damage, and your party's "
  "Final Damage, Attack Speed and HP recovery in proportion to your INT."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP_V skill_order: 1 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 19.85
  duration_seconds_per_level: 0.35
  base { final_dmg_pct: 0.185 }
  per_level { final_dmg_pct: 0.005 }
  ally_base {
    final_dmg_pct: 0.06
    regen_pct: 0.01
    regen_interval_seconds: 2.0
    cures_conditions: true
  }
  ally_int_lever {
    int_step: 3000
    effect { final_dmg_pct: 0.01 }
    cap_is_party_share: true
  }
  ally_int_lever {
    int_step: 2000
    effect { regen_pct: 0.01 }
    cap { regen_pct: 0.10 }
  }
  ally_int_lever {
    int_step: 10000
    effect { attack_speed: 1 }
    cap { attack_speed: 3 }
  }
}
