name: EQUIP_SET_NAME_ABSOLAB_THIEF
# Eight slots, all filled: six armour pieces and the weapon in the version a
# class picks. There is one file per branch because every piece belongs to one
# class, like the Root Abyss set.
#
# GMS's set has seven slots, because Armor and Pants are one overall there. Here
# the tiers are spread over eight and add up to the same totals: all stats +30,
# HP/MP +1,500 and +20%, ATT/MATT +135, DEF +200, boss +30%, and two 10% Ignore
# DEF shares that combine to GMS's 19%.
complete_pieces: 8
members {
  slot: EQUIP_SLOT_HAT
  items { name: "AbsoLab Bandit Cap" }
}
members {
  slot: EQUIP_SLOT_TOP
  items { name: "AbsoLab Bandit Armor" }
}
members {
  slot: EQUIP_SLOT_BOTTOM
  items { name: "AbsoLab Bandit Pants" }
}
members {
  slot: EQUIP_SLOT_SHOES
  items { name: "AbsoLab Bandit Shoes" }
}
members {
  slot: EQUIP_SLOT_GLOVES
  items { name: "AbsoLab Bandit Gloves" }
}
members {
  slot: EQUIP_SLOT_CAPE
  items { name: "AbsoLab Bandit Cape" }
}
members {
  slot: EQUIP_SLOT_SHOULDER
  items { name: "AbsoLab Bandit Shoulder" }
}
# Named as a family: the branch's weapons are one piece with a version per job,
# and a player wears exactly one.
members {
  slot: EQUIP_SLOT_PRIMARY_WEAPON
  family: "AbsoLab Thief Weapon"
}
tiers {
  pieces: 2
  effect {
    max_hp: 1500
    max_mp: 1500
    attack: 15
    magic_attack: 15
    boss_pct: 0.10
  }
}
tiers {
  pieces: 3
  effect {
    str: 30
    dex: 30
    int: 30
    luk: 30
    attack: 20
    magic_attack: 20
  }
}
tiers {
  pieces: 4
  effect {
    attack: 20
    magic_attack: 20
    def: 200
    boss_pct: 0.10
  }
}
# The first of the two Ignore DEF shares. They are separate sources, so they
# multiply rather than add: 10% and 10% make 19%, GMS's own total.
tiers {
  pieces: 5
  effect {
    attack: 20
    magic_attack: 20
    ied_pct: 0.10
  }
}
tiers {
  pieces: 6
  effect {
    attack: 20
    magic_attack: 20
    boss_pct: 0.10
  }
}
tiers {
  pieces: 7
  effect {
    max_hp_pct: 0.20
    max_mp_pct: 0.20
    attack: 20
    magic_attack: 20
  }
}
tiers {
  pieces: 8
  effect {
    attack: 20
    magic_attack: 20
    ied_pct: 0.10
  }
}
