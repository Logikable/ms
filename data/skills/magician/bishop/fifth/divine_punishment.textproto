# GMS makes one light every 11 seconds, banks five, and uses one per second
# held. A flat 55-second cooldown would give the same damage but lock the player
# out for five seconds at a time on a map.
#
# `pulses_per_charge` is one second held at GMS's `attackDelay 240` beat, 4.17
# rounded to 4; the community DPM calculator's key-down tick agrees.
#
# `base_delay_ms` is the client's wind-up and release (`prepare/time 240` plus
# `keydownend/time 120`). masonym's 1320 is the loop action, not this minimum.
name: "Divine Punishment"
description:
  "Punish the wicked in the name of Heaven. Spends the holy light you have "
  "prepared, one for every second you hold the key, and shelters you from "
  "half of what you take while it runs."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_HOLY
placement { job_advancement: JOB_ADVANCEMENT_BISHOP_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 360
cooldown_seconds: 1.5
max_enemies: 6
lines: 10
base { skill_pct: 3.38 }
per_level { skill_pct: 0.13 }
channel {
  pulse_interval_ms: 240
  max_pulses: 20
  damage_taken_pct: 0.50
  charge_seconds: 11.0
  max_charges: 5
  pulses_per_charge: 4
}
