name: "Hilla"
difficulties {
  name: "Normal"
  phases {
    bgm: "RedWitch"
    spawns { mob: "hilla" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  unlock_level: 130
  # GMS pays Intense Power Crystals, a drop nobody keeps; this is five of them
  # at her level's price, as meso.
  meso: 4000000
  exp: 5820000
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "stone_of_eternal_life"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  phases {
    bgm: "RedWitch"
    spawns { mob: "hard_hilla" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 600
  unlock_level: 190
  # Five Intense Power Crystals at her level's price, divided by seven since GMS
  # clears her once a week and this game once a day.
  meso: 8050000
  exp: 20400000
  drops {
    equip: "will_o_the_wisps"
    per_kill: 1.0
  }
  # The same shard as Normal: a soul belongs to the boss, not the difficulty.
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
}
