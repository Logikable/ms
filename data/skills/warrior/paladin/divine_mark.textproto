# Two hits landed at once: the hammer, and the brand of light it leaves, which
# GMS detonates a moment later. Nothing here would do anything with the gap, so
# they are one swing -- but priced apart, because only the explosion hits an
# ordinary monster harder and a single averaged multiplier would spread that
# across the hammer's seven strikes as well. See Skill.extra_hit.
#
# The silence it also lands and the range it also grants are dropped: nothing
# here is ever silenced, and range is not a thing this game has.
#
# 660ms is Divine Charge's, the same hammer one tier down -- the animation
# frames for this one are not published anywhere we could read them.
name: "Divine Mark"
skill_order: 1
description:
  "Allows you to summon a more powerful holy hammer. Enhances the damage and "
  "range of Divine Charge. When Divine Mark is used, a brand of light appears "
  "at the target location, detonating after a set period and striking enemies "
  "in a wide area. This explosion deals additional damage to normal enemies."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_PALADIN
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
exceeds_master_level: true
required_skill {
  skill_name: "Divine Charge"
  level: 20
}
tags: SKILL_TAG_HOLY_POWER
base_delay_ms: 660
cooldown_seconds: 7.0
max_enemies: 10
lines: 7
base { skill_pct: 3.04 }
per_level { skill_pct: 0.04 }
boost {
  skill_name: "Divine Charge"
  effect { skill_pct: 0.42 }
  effect_per_level { skill_pct: 0.02 }
}
extra_hit {
  label: "Explosion"
  lines: 5
  base {
    skill_pct: 2.03
    normal_skill_pct: 0.609
  }
  per_level {
    skill_pct: 0.03
    normal_skill_pct: 0.009
  }
}
