# GMS's own figures: 154+5x% four times over 20 levels, on six enemies. The stun
# is the max value, 20+2x% for 2+ceil(3x/20) seconds.
#
# 900ms is the animation's own, from the frame data: the slowest swing in the
# game, on a Priest who already hits softest.
name: "Shining Ray"
description:
  "Attack multiple enemies at once with a ray of holy light."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_HOLY
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 900
max_enemies: 6
lines: 4
stun {
  duration_seconds: 5.0
  chance: 0.6
}
base { skill_pct: 1.59 }
per_level { skill_pct: 0.05 }
