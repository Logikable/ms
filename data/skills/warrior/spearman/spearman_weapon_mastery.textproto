name: "Weapon Mastery"
description:
  "Trains your grip until your spear lands where you mean it to, narrowing "
  "your weakest swings toward your best. A spear also swings faster and hits "
  "harder for it. Needs a spear or a polearm in hand."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_SPEARMAN
max_level: 10
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base { mastery: 0.14 }
per_level { mastery: 0.04 }
weapon_bonus {
  required_equip_type: EQUIP_TYPE_SPEAR
  effect {
    attack_speed: 1
    damage_pct: 0.05
  }
}
