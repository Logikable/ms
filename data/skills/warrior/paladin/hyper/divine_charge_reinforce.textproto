# GMS writes it "Damage: +20%": the %Damage stat for one swing, adding to what
# the character already has, not points on Divine Charge's multiplier.
#
# It boosts the White Knight's skill from the Paladin's page, since the Paladin
# still uses it.
name: "Divine Charge - Reinforce"
description:
  "Increases the damage of Divine Charge."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 4 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Divine Charge"
  effect { damage_pct: 0.20 }
}
