# +2% critical rate a level, to 40% at max. This is where an archer's critical
# rate comes from, on top of the 5% every character starts with.
name: "Critical Shot"
description: "Increases Critical Rate."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ARCHER skill_order: 2 }
max_level: 20
base { crit_rate: 0.02 }
per_level { crit_rate: 0.02 }
