# A party buff on a timer in GMS, at 10+x magic attack. Nothing runs out here,
# so it simply stands -- over the wizard and over everybody beside them.
#
# GMS asks for MP Eater Lv. 3 first. MP Eater is not in this book -- nothing
# spends MP -- so the requirement would name a skill that does not exist.
name: "Meditation"
description:
  "Enhances the Magic ATT of all nearby party members through meditation."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 4 }
max_level: 20
base { magic_attack: 11 }
per_level { magic_attack: 1 }
ally_base { magic_attack: 11 }
ally_per_level { magic_attack: 1 }
