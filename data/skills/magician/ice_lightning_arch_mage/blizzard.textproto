# Two skills on one ladder: the roomwide swing on a 45-second wait, and a
# Final Attack that follows everything else the character swings while it
# recharges. It freezes the room it lands on, as GMS says, for the eight
# seconds the family freezes for -- GMS states no number of its own. The fight falls back on Chain Lightning in between, which is what
# lets this one hit as hard as it does.
#
# The Final Attack falls on ONE enemy, as GMS states it -- the reading every
# Final Attack in the game takes. See Skill.final_attack_single_enemy.
name: "Blizzard"
description:
  "Summon spears of ice from the sky, showering multiple enemies with a nasty "
  "blizzard. Upon attacking, permanently grants a chance to damage a single "
  "enemy with a Blizzard."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_ICE
freeze_seconds: 8.0
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 2 }
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 900
max_enemies: 15
lines: 12
cooldown_seconds: 45.0
final_attack_single_enemy: true
base {
  skill_pct: 2.14
  final_attack_chance: 0.02
  final_attack_pct: 1.04
}
per_level {
  skill_pct: 0.03
  final_attack_chance: 0.02
  final_attack_pct: 0.04
}
