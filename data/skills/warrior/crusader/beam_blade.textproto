# GMS states the damage twice: 100 + 4*L% five times over, and the same figure
# again as percentage POINTS against normal monsters. So an ordinary monster
# takes double, which is what normal_skill_pct carries -- and since nothing in
# this game is a boss, it is what every monster takes.
#
# Flash Blade's animation, which is the same dash it is a bigger version of.
name: "Beam Blade"
skill_order: 2
description:
  "Launch blades that tear your enemies apart, and cut deeper into anything "
  "that is not a boss."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_CRUSADER
max_level: 20
base_delay_ms: 720
cooldown_seconds: 7.0
max_enemies: 8
lines: 5
base {
  skill_pct: 1.04
  normal_skill_pct: 1.04
}
per_level {
  skill_pct: 0.04
  normal_skill_pct: 0.04
}
