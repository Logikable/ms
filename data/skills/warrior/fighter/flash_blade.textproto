# GMS hands out two charges off one 4-second cooldown. One charge here, since
# the fight has no notion of a player saving one for later -- so the cooldown
# is simply how long it is until the next.
name: "Flash Blade"
description: "Zip forward in a flash, cutting enemies in your path."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 2 }
max_level: 9
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
base_delay_ms: 630
cooldown_seconds: 4.0
max_enemies: 6
lines: 5
base { skill_pct: 1.05 }
per_level { skill_pct: 0.05 }
