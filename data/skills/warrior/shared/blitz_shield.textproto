# GMS's shield is a shell the warrior detonates: 5% of their HP raises it, it
# absorbs 15 + floor(x/5)% of their max for five seconds, and a second press two
# seconds later blows it up. Only the blast is built. A shell nobody keeps isn't
# a shell, nothing here spends HP, and the client's own trigger is `condition:
# damaged`, a hit taken while it is up, which a character here is never asked to
# time.
#
# Damage is exactly GMS's 500 + 20x: 520% at level 1 and 1100% at 30, five lines
# on twelve enemies every fifteen seconds. The blast has no hitbox in the
# client, so its reach is GMS's cap and the reach rule has nothing to lower it
# with, like Flash Blade and Cry Valhalla.
#
# One weapon list covers all three books, like the Swordman's own attacks: every
# warrior can use this, whatever their line.
name: "Blitz Shield"
description:
  "Draws on your own lifeforce to raise a shield, then detonates it over the "
  "enemies around you."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 5 }
v_node: V_NODE_KIND_ARCHETYPE
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 600
cooldown_seconds: 15.0
max_enemies: 12
lines: 5
base { skill_pct: 5.20 }
per_level { skill_pct: 0.20 }
