# Agile Bows for crossbows: GMS's 2 DEX a level over 10 levels, spread over 5 at
# 4 each, ending at the same total for half the points.
name: "Agile Crossbows"
description: "Increases Attack Speed and DEX."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CROSSBOWMAN skill_order: 2 }
max_level: 5
required_skill {
  skill_name: "Crossbow Mastery"
  level: 5
}
base {
  dex: 4
  attack_speed: 2
}
per_level { dex: 4 }
