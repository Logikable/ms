# GMS requires a shield or dagger scabbard in the off hand and gives DEF,
# avoidability, attack and damage reduction for it. The avoidability is left
# out: GMS gives a share of the avoid stat here, the accuracy check, not the
# flat roll dodge_chance models. See Illusion Step for the other kind.
#
# The rest uses GMS's own figures: DEF and damage taken both 11% and 6% a level,
# and attack ending at +20. All of it needs the off hand. The DEF is worth
# nothing and is kept for the figure (see SkillEffect.def_pct).
name: "Shield Mastery"
description:
  "Increases DEF and Attack Power when a secondary weapon is equipped, and "
  "reduces damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BANDIT skill_order: 8 }
max_level: 10
requires_secondary: true
base {
  damage_taken_pct: 0.06
  def_pct: 0.11
  attack: 2
}
per_level {
  damage_taken_pct: 0.06
  def_pct: 0.11
  attack: 2
}
