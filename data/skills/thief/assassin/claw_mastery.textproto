# 20 levels instead of GMS's 10, so the book costs the 90 SP the Assassin's
# levels give. Stars never run out here, so there is no star count to raise.
name: "Claw Mastery"
description: "Increases Claw Mastery."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ASSASSIN skill_order: 3 }
max_level: 20
required_equip_type: EQUIP_TYPE_CLAW
base { mastery: 0.12 }
per_level { mastery: 0.02 }
