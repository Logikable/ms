# GMS gives 5+floor(x/2) attack, x% Ignore DEF and 5+floor(x/3)% final damage
# over 30 levels. Here it has ten, and all three end where GMS's do: attack
# rises a point a level from a base that already includes the ten GMS gives
# before level 10.
name: "Dark Harmony"
description: "Become one with the darkness to deal more damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 7 }
max_level: 10
exceeds_master_level: true
base {
  attack: 11
  ied_pct: 0.21
  final_dmg_pct: 0.06
}
per_level {
  attack: 1
  ied_pct: 0.01
  final_dmg_pct: 0.01
}
