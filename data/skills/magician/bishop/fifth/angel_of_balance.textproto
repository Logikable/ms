# The Angel of Benevolence gives a four-second buff every five seconds (see
# Buff.duty_seconds); folding that into the numbers would make the card say 80%
# where GMS says 100%.
#
# The Avenging Angel's 4.02-second clock isn't published: it is the community
# DPM calculator's measurement, like Bahamut's 3.03.
#
# The mark is worth about a twentieth of a percent, and that is right: one line
# uses it up, and the angel can't use its own marks, having no element.
#
# The party's share keeps GMS's INT steps exactly: rescaling would make it a
# different skill.
#
# GMS's "not usable while Bahamut is active" is older wording: the client
# dismisses the dragon instead, which is what silences_skill_name does.
name: "Angel of Balance"
description:
  "Summons an angel of compassion and vengeance. The Angel of Benevolence "
  "heals your party and increases your damage and theirs; the Avenging Angel "
  "strikes the enemy and marks what it hits."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
mark {
  duration_seconds: 60.0
  final_dmg_pct: 0.10
  lifted_tag: SKILL_TAG_HOLY
}
buff {
  duration_seconds: 30.0
  duty_seconds: 4.0
  duty_interval_seconds: 5.0
  silences_skill_name: "Bahamut"
  base { damage_pct: 1.00 }
  ally_base {
    damage_pct: 0.05
    regen_pct: 0.102
    regen_interval_seconds: 5.0
  }
  ally_per_level { regen_pct: 0.002 }
  ally_int_lever {
    int_step: 1250
    effect { damage_pct: 0.01 }
    cap { damage_pct: 0.40 }
  }
  pulse {
    label: "Avenging Angel"
    cast_interval_seconds: 4.02
    lines: 10
    max_enemies: 12
    base { skill_pct: 5.20 }
    per_level { skill_pct: 0.20 }
  }
}
