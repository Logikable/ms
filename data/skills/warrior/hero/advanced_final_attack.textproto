# GMS states the whole Final Attack here, not an increase over the Fighter's (45
# + ceil(L/2)% for 110 + 2L%, three times), so this supersedes it instead of
# stacking. The three strikes are separate, each rolling its own crit and
# mastery.
#
# It needs the Fighter's weapons, so both stop together: a Hero holding a weapon
# neither fires with gets neither.
#
# The extra hit lands on one enemy the swing reached, not on each. GMS's Final
# Attack has no mobCount or hitbox of its own, and its text names its target:
# "attacks the boss with the highest HP first".
name: "Advanced Final Attack"
description:
  "Permanently increases Attack Power. Greatly increases activation rate and "
  "damage of Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 6 }
final_attack_max_enemies: 1
max_level: 30
exceeds_master_level: true
supersedes_skill_name: "Final Attack"
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_skill {
  skill_name: "Final Attack"
  level: 20
}
base {
  attack: 1
  final_attack_chance: 0.455
  final_attack_pct: 1.12
  final_attack_lines: 3
}
per_level {
  attack: 1
  final_attack_chance: 0.005
  final_attack_pct: 0.02
}
