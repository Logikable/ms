# GMS's barrier blocks statuses and recharges; only its passive half is kept,
# over twenty levels instead of ten. GMS's only party clause is a cooldown
# Dispel shortens, so none of it reaches the party.
name: "Divine Protection"
description: "Permanently increases Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 5 }
max_level: 20
base {
  status_resistance: 2
  elemental_resistance: 0.02
}
per_level {
  status_resistance: 2
  elemental_resistance: 0.02
}
