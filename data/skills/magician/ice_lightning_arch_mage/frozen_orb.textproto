# One swing of 19 lines, not a summon, so the player pays the 660ms throw; as a
# summon those strikes would come free. The client gives the rate in attackDelay
# and the lifetime in time.
#
# It freezes nothing: GMS says it slows, where every other ice skill states a
# freeze duration.
name: "Frozen Orb"
description:
  "Create and throw a Frozen Orb that fires ice shards everywhere to deal ice "
  "damage."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_ICE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 3 }
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 8
lines: 19
cooldown_seconds: 5.0
base { skill_pct: 1.04 }
per_level { skill_pct: 0.04 }
