name: "Magnus"
difficulties {
  name: "Normal"
  # One body alone in the middle of his arena, as Hilla is: nothing else to
  # kill, and the whole floor to walk while killing it.
  phases {
    spawns { mob: "magnus" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # What Horntail allows. He is twice the body, but the gate is thirty levels
  # over him and every branch clears him inside half of it.
  time_limit_seconds: 600
  # Traded with Pink Bean and traded back (2026-08-31). Six billion in ONE
  # body is the whole of it, where a fight of many parts has half of them left
  # standing when the objective falls -- so he does ask more than Pink Bean's
  # larger number. At 170 he was cleared the day he opened by half the
  # branches and Pink Bean at 160 was not cleared until 168, which is the
  # swap overshooting: the pair are close enough that the order costs less
  # than the ten levels does.
  unlock_level: 160
  # Five Intense Power Crystals at what his level fetches, as Zakum's, Hilla's
  # and Horntail's meso is.
  meso: 12960000
  # Paid for the clear, flat and untouched by any EXP bonus, as the other
  # three are.
  exp: 5300000
  drops {
    equip: "crystal_ventus_badge"
    per_kill: 1.0
  }
  drops {
    equip: "royal_black_metal_shoulder"
    per_kill: 1.0
  }
  drops {
    item: "magnuss_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  # The same lone fight at the numbers GMS gives Hard, standing behind 120%
  # PDR: the second body in the game to ask for Ignore DEF before it takes
  # anything at all.
  phases {
    spawns { mob: "hard_magnus" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Fifteen minutes, as every fight past Cygnus has.
  time_limit_seconds: 900
  # The level cap, where everything from here to Seren opens.
  unlock_level: 200
  # Five Intense Power Crystals at what GMS prices his, divided by seven: GMS
  # clears him once a week and this game once a day.
  meso: 13600000
  # Paid for the clear, flat and untouched by any EXP bonus.
  exp: 22000000
  # The same shoulder and badge Normal drops. GMS pays Hard in Tyrant gear,
  # which is a set this game does not have.
  drops {
    equip: "crystal_ventus_badge"
    per_kill: 1.0
  }
  drops {
    equip: "royal_black_metal_shoulder"
    per_kill: 1.0
  }
  drops {
    item: "magnuss_soul_shard"
    per_kill: 1.0
  }
}
