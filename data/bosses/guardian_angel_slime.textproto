name: "Guardian Angel Slime"
difficulties {
  name: "Normal"
  # She moves along the row above the player's heads like Damien and Lotus, and
  # every thirty seconds she jumps up to the gallery row and comes back down two
  # thirds of a second later, onto the cell she left.
  phases {
    bgm: "GuardianSlime-Battle"
    spawns {
      mob: "guardian_angel_slime"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        jump { interval_ms: 30000 y: 2 hang_ms: 660 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twenty-five minutes, like Lotus and Damien. GMS allows thirty, and her HP is
  # three times Lotus's, but this fight isn't meant to be lost to the timer.
  time_limit_seconds: 1500
  # Her own level. GMS unlocks her at 210 alongside the Black Heaven fights; ten
  # levels later shows she is the step above them.
  unlock_level: 220
  # Five Intense Power Crystals at GMS's price for this fight, divided by seven
  # (GMS clears her once a week and this game once a day), rounded to the
  # nearest 50k.
  meso: 33100000
  # No EXP: GMS lists none for her, as with Lotus.
  exp: 0
  # Half the clears: the only boss drop that isn't guaranteed. GMS gives her
  # ring from a chest the party opens afterwards and rolls it there; only the
  # roll is kept here, not the chest.
  drops {
    equip: "guardian_angel_ring"
    per_kill: 0.5
  }
  drops {
    item: "guardian_angel_slimes_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  # Defined but not built: 90T, eighteen times Normal, on a body GMS fights at
  # level 250. No time limit, unlock level or reward until the fight is built.
  name: "Chaos"
  coming_soon: true
  phases {
    bgm: "GuardianSlime-Battle"
    spawns {
      mob: "chaos_guardian_angel_slime"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        jump { interval_ms: 30000 y: 2 hang_ms: 660 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
}
