# Extra damage % only this swing gets, which is what GMS's "Damage: +20%" means.
# The mark gets it too, because both use the same stats.
name: "Snipe - Reinforce"
description:
  "Increases damage of Snipe, Empowered Snipe, and of Snipe's additional "
  "hits."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 11 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Snipe"
  reach: BOOST_REACH_BOTH
  effect { damage_pct: 0.20 }
}
