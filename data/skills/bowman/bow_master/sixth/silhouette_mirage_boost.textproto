# GMS: 10+x% final damage, jumping 5 at 10, 5 at 20 and 10 at 30.
# GMS also raises the damage a double absorbs and fires the bullets without a
# double; here no double is ever used up, so only the final damage is left.
name: "Silhouette Mirage Boost"
description: "Boosts Silhouette Mirage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_VI skill_order: 4 }
hexa_node: HEXA_NODE_KIND_ENHANCEMENT
max_level: 30
required_skill { skill_name: "Silhouette Mirage" level: 30 }
boost {
  skill_name: "Silhouette Mirage"
  effect { final_dmg_pct: 0.11 }
  effect_per_level { final_dmg_pct: 0.01 }
  step { from_level: 10 effect { final_dmg_pct: 0.05 } }
  step { from_level: 20 effect { final_dmg_pct: 0.05 } }
  step { from_level: 30 effect { final_dmg_pct: 0.10 } }
}
