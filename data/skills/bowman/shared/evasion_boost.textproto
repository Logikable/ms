# GMS maxes this at 4. Stretched to 10 levels to help fill the book's 120,
# ending at GMS's top figures, like ranger/marksmanship.textproto.
#
# The crit after a dodge and the knockback resistance are left out: the first is
# a window this game has no timer for, and no mob knocks back.
name: "Evasion Boost"
description:
  "Grants a chance to dodge enemy attacks. Also permanently increases Max HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_SNIPER skill_order: 7 }
max_level: 10
base { dodge_chance: 0.12 max_hp_pct: 0.13 }
per_level { dodge_chance: 0.02 max_hp_pct: 0.03 }
