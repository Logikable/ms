# GMS only pays this against enemies with damage over time, freeze, stun,
# darkness or paralysis. This game tracks three of those on monsters, and the
# I/L's ice is one, so this pays on anything the book has frozen. GMS's 10+x%
# ladder is kept whole: 11% up to 20%.
#
# The condition is on or off, as in GMS: a monster is afflicted or not, and a
# second status adds nothing. What grows with stacks is Freezing Crush's own
# pair.
name: "Storm Magic"
description:
  "Increases your Final Damage when attacking enemies that are Frozen."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_MAGE skill_order: 7 }
max_level: 10
base { final_dmg_pct_when_afflicted: 0.11 }
per_level { final_dmg_pct_when_afflicted: 0.01 }
