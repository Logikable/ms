# Sends 15+7x% of a hit to the MP pool instead of the HP pool. Nothing here
# tracks MP, so it lands as plain reduction alongside damage_taken_pct -- which
# is real now that monsters hit back.
name: "Magic Guard"
skill_order: 2
description:
  "A portion of the damage dealt to you affects your MP instead of your HP."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_MAGICIAN
max_level: 10
base {
  damage_to_mp_pct: 0.22
}
per_level {
  damage_to_mp_pct: 0.07
}
