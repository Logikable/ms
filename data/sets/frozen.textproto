name: EQUIP_SET_NAME_FROZEN
# In the order the inspect screen lists them, which is the order they are worn
# in rather than the order they drop in.
members {
  slot: EQUIP_SLOT_HAT
  name: "Frozen Hat"
}
members {
  slot: EQUIP_SLOT_TOP
  name: "Frozen Top"
}
members {
  slot: EQUIP_SLOT_BOTTOM
  name: "Frozen Bottom"
}
members {
  slot: EQUIP_SLOT_CAPE
  name: "Frozen Cape"
}
# The weapon and the secondary are not written yet: no monster in the game is
# above level 98, and a weapon here belongs to one class rather than to all of
# them. Named as families so the set can state what it is waiting for; the last
# two tiers are what they will pay when those arrive.
members {
  slot: EQUIP_SLOT_PRIMARY_WEAPON
  family: "Frozen Weapon"
}
members {
  slot: EQUIP_SLOT_SECONDARY
  family: "Frozen Secondary"
}
tiers {
  pieces: 3
  effect {
    str: 7
    dex: 7
    int: 7
    luk: 7
    attack: 5
    magic_attack: 5
  }
}
tiers {
  pieces: 4
  effect {
    max_hp_pct: 0.20
    max_mp_pct: 0.20
    attack: 9
    magic_attack: 9
  }
}
tiers {
  pieces: 5
  effect {
    str: 8
    dex: 8
    int: 8
    luk: 8
    attack: 11
    magic_attack: 11
    damage_pct: 0.09
  }
}
tiers {
