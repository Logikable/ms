# This game has no range or movement speed. The attack speed is real: +1 stage,
# flat at every level, so the first point buys the whole ~8% DPS. The defense is
# our addition; without it the other 19 points bought nothing.
#
# The description adds to GMS's here instead of trimming it: the wiki names
# range and movement speed and no defense. Ours grants defense, so the text says
# so, or the levels below would seem to come from nowhere.
name: "Archery Mastery"
description:
  "Gain proficiency in the fundamentals of Archery. Increases Attack Speed."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ARCHER skill_order: 3 }
max_level: 20
base {
  attack_speed: 1
  def: 5
}
per_level {
  def: 5
}
