name: "Lotus"
difficulties {
  # No Easy, since GMS has none.
  name: "Normal"
  # He fights from inside the machine first, hanging over the middle of the room
  # while the floor below him stays clear.
  phases {
    bgm: "Suu1phase"
    spawns {
      mob: "lotus_phase_1"
      spots { x: 4 y: 2 }
    }
    # The floor, walked end to end. Nothing to climb while he is up there.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  # Out of the machine and down on the floor, moving along the row above the
  # player's heads one cell every ten seconds. The room gains the gallery he was
  # hanging in.
  phases {
    bgm: "Suu2phase"
    spawns {
      mob: "lotus_phase_2"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    # The gallery: three ledges where he hung in the previous phase.
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  # The same room and the same movement, with a third more HP.
  phases {
    bgm: "Suu3phase"
    spawns {
      mob: "lotus_phase_3"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twenty-five minutes, the longest time limit in the game. It needs to be:
  # this is 1.575T HP behind 300% PDR at level 210, three times the largest body
  # before it, and it is meant to be cleared by a party rather than alone.
  time_limit_seconds: 1500
  # Level 210. The Black Heaven fights are the first with an unlock level above
  # 200.
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price for this fight, divided by seven
  # (GMS clears Lotus once a week and this game once a day), rounded to the
  # nearest 50k.
  meso: 23200000
  # No EXP: GMS lists none on any of the three bodies, and a fight this late is
  # fought for the coin rather than levelling.
  exp: 0
  # One coin per clear, the currency for AbsoLab gear.
  drops {
    item: "absolab_coin"
    per_kill: 1.0
  }
  drops {
    item: "lotuss_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  # Defined but not built: 33.3T over the same three bodies, twenty-one times
  # Normal. No time limit, unlock level or reward until the fight is built.
  name: "Hard"
  coming_soon: true
  phases {
    bgm: "Suu1phase"
    spawns {
      mob: "hard_lotus_phase_1"
      spots { x: 4 y: 2 }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu2phase"
    spawns {
      mob: "hard_lotus_phase_2"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu3phase"
    spawns {
      mob: "hard_lotus_phase_3"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
}
