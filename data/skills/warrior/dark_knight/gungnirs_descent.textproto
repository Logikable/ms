# GMS's own 50 + 2L% of the caster's Max HP, added to each of the twelve lines.
# It is added after the damage calculation, so nothing multiplies it: it is
# worth a lot to a Dark Knight whose damage is still low and very little to one
# whose HP no longer keeps up.
#
# 660ms is the animation's own, from the frame data: the same as Dark Impale, so
# the two attacks differ only in reach.
name: "Gungnir's Descent"
description:
  "Throw a mythical spear to deal fatal damage. You deal higher damage with "
  "greater Max HP."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 1 }
max_level: 30
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 3
lines: 12
base {
  skill_pct: 1.96
  ied_pct: 0.01
  max_hp_damage_pct: 0.52
}
per_level {
  skill_pct: 0.01
  ied_pct: 0.01
  max_hp_damage_pct: 0.02
}
