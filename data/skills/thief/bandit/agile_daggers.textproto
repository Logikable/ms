# GMS gives 2 LUK a level over 10 levels. Here it is spread over 5 at 4 each,
# the same 20 total for half the points, like every other Agile skill.
name: "Agile Daggers"
description: "Increases Attack Speed and LUK."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BANDIT skill_order: 4 }
max_level: 5
required_skill {
  skill_name: "Dagger Mastery"
  level: 5
}
base {
  luk: 4
  attack_speed: 2
}
per_level { luk: 4 }
