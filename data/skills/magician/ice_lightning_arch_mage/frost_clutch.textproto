# GMS's Frost Clutch is one level and one number: Freezing Crush's critical
# damage per stack goes from 1% to 2%. It supersedes instead of adding (the
# better of the two stacks is kept, never their sum), and the final damage half
# stays at Freezing Crush's 1%. Ten levels here instead of GMS's one, stepping
# evenly to that 2%.
#
# It doesn't go past its max level. GMS maxes it at 1 and doesn't mark it for
# Combat Orders, so there is no higher level to reach.
name: "Frost Clutch"
description: "Increases the effect of Freezing Crush."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 9 }
max_level: 10
base { crit_dmg_per_freeze_stack: 0.002 }
per_level { crit_dmg_per_freeze_stack: 0.002 }
