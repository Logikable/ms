# The client states bulletCount 4 and 3 on the two spread entries.
#
# The shadow doesn't copy the spread, as GMS's description says.
name: "Throwing Star Barrage"
description:
  "Temporarily grants your throwing skills extra spread. Does not apply to "
  "Shadow Partner."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 1 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 19.85
  duration_seconds_per_level: 0.35
  boost {
    skill_name: "Quad Star"
    extra_hit {
      label: "Spread"
      casts: 3
      lines: 4
      max_enemies: 4
      skips_mirror: true
      base { skill_pct: 3.79 }
    }
  }
  boost {
    skill_name: "Triple Throw"
    extra_hit {
      label: "Spread"
      casts: 4
      lines: 3
      max_enemies: 4
      skips_mirror: true
      base { skill_pct: 2.90 }
    }
  }
}
