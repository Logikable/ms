# GMS's fifth node is Phase Dash, which isn't built: Midnight Carnival carries
# its damage. Double Stab takes the node at 5% a level instead of GMS's 3%, the
# rate a 1st job swing needs to be worth 80 VP.
name: "Double Stab Boost"
description: "Strengthens Double Stab."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 9 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Double Stab"
  effect { final_dmg_pct: 0.05 }
  effect_per_level { final_dmg_pct: 0.05 }
}
boost {
  skill_name: "Double Stab"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Double Stab"
  min_level: 40
  effect { ied_pct: 0.20 }
}
