# GMS's own figures: a 30+2x% chance, 110+5x% a second for 8 seconds, stacking
# 2+floor(x/6) times. The stack count is the one ladder here that has to be
# walked in fractions -- two helpings through level 5, three through 11 and
# four at 12, which is what Combat Orders buys.
name: "Toxic Venom"
skill_order: 9
description:
  "Increases Venom's poison chance and permanently increases poison damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_NIGHT_LORD
max_level: 10
exceeds_master_level: true
supersedes_skill_name: "Venom"
required_skill {
  skill_name: "Venom"
  level: 10
}
dot {
  interval_seconds: 1.0
  duration_seconds: 8.0
  lines: 1
  chance: 0.32
  chance_per_level: 0.02
  max_stacks: 2.1666667
  max_stacks_per_level: 0.1666667
  base { skill_pct: 1.15 }
  per_level { skill_pct: 0.05 }
}
