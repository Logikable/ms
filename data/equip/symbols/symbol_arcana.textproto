name: "Arcane Symbol: Arcana"
required_level: 200
# Every job wears every symbol. What one grants is the wearer's own primary
# stat, so one item serves all of them and no job filter is needed.
equip_job_categories: EQUIP_JOB_CATEGORY_UNIVERSAL
equip_slot: EQUIP_SLOT_SYMBOL_ARCANA
# It levels by absorbing duplicates, which is a ladder of its own. Neither
# upgrade path touches it, and it carries no slots to spend.
unsupported_upgrades: UPGRADE_SCROLL
unsupported_upgrades: UPGRADE_STAR_FORCE
# Worth nothing at a shop. A spare is worth what it can be combined into, and
# the only place that happens is the Symbols tab.
sell_price: 0
arcane_symbol { meso_cost_base: 14 }
