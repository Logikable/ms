# The fight casts this, using a swing, when the Cleric drops below
# kHealBelowFraction of their HP (fight.cc).
#
# GMS's 15% a level to 300% is meant for a party; alone it is a full heal from
# level 4. Here it is 10% a level over 10, ending at a full heal.
name: "Heal"
description: "Restores your HP."
kind: SKILL_KIND_ACTIVE
tags: SKILL_TAG_BENEVOLENCE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 3 }
max_level: 10
base_delay_ms: 600
base { heal_pct: 0.10 }
per_level { heal_pct: 0.10 }
