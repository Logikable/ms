# GMS leaves a wall of fire that lasts a few seconds and strikes on its own
# clock. Nothing here stays on the ground, so this is what the whole wall is
# worth: a Final Attack after the fire spell that lit it, at GMS's (10+4x)%
# chance of (30+x)% a hit.
#
# Twelve hits, not three. The client's three are one burst of the wall, which
# fires every 1.5 seconds (`subTime`) for the 4+floor(x/4) seconds it lasts:
# four bursts once it lasts past five seconds, three before that. Folding the
# wall into the roll counts it toward the swing that lit it.
#
# follows_skill_tag is what keeps it off Poison Breath, which is the point of
# the skill.
name: "Ignite"
description:
  "Grants Fire magic a chance to create a wall of fire at the target "
  "location."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 6 }
max_level: 10
final_attack_label: "Wall of Fire"
follows_skill_tag: SKILL_TAG_FIRE
base {
  final_attack_chance: 0.14
  final_attack_pct: 0.31
  final_attack_lines: 12
}
per_level {
  final_attack_chance: 0.04
  final_attack_pct: 0.01
}
