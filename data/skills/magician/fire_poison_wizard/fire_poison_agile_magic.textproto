# GMS gives 2 INT a level over 10 levels. Spread over 5 at 4 apiece, which
# ends in the same place -- 20 -- for half the points, as Agile Arms and Agile
# Bows do.
name: "Agile Magic"
description: "Increases Attack Speed and INT."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 5 }
max_level: 5
required_skill {
  skill_name: "Spell Mastery"
  level: 5
}
base {
  int: 4
  attack_speed: 2
}
per_level { int: 4 }
