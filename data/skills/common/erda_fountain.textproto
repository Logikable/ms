# GMS's Erda Shower is either a blast or this object. Only the object is built:
# it is the half a character with a matrix uses, and the blast is for bosses.
#
# GMS's 60-second cooldown is on placing the object, which lasts exactly that
# long, so the twelve kills are the whole rule (see Skill.kills_per_cast).
name: "Erda Fountain"
description:
  "Plants an object filled with pure Erda. Erda released by defeated enemies "
  "condenses around it, and enough of it gathered is released at once."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 2 }
v_node: V_NODE_KIND_COMMON
max_level: 30
max_enemies: 10
lines: 4
kills_per_cast: 12
base { skill_pct: 4.65 }
per_level { skill_pct: 0.15 }
