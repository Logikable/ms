# Named "Final Attack" for the family, for the reason Combo Attack - Reinforce
# gives. The description says which of the two it reaches.
#
# GMS writes it "Damage: +10%", which is the %Damage stat rather than points on
# the Final Attack's own multiplier -- so it sums with what the character
# already pays and only the extra hits collect it.
#
# Aimed at Advanced Final Attack by name even though that is a passive, which
# a boost normally cannot reach. What it strengthens is the extra hit rather
# than a swing; see SkillBoost::effect.
name: "Final Attack - Reinforce"
skill_order: 7
description: "Increases Advanced Final Attack's damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_HERO
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Advanced Final Attack"
  effect { damage_pct: 0.10 }
}
