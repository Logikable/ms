# The line's mastery skill, with 20 levels instead of GMS's 30 but GMS's top
# figures: 70% mastery, +60 attack and 16% critical damage.
#
# It must not supersede Bow Mastery: masteries take the better of the two, not
# the sum, so this simply beats the Hunter's 50%.
name: "Bow Expert"
description: "Increases Bow Mastery, Attack Power, and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 7 }
max_level: 20
exceeds_master_level: true
required_equip_type: EQUIP_TYPE_BOW
required_skill {
  skill_name: "Bow Mastery"
  level: 10
}
base {
  mastery: 0.51
  attack: 3
  crit_dmg: 0.065
}
per_level {
  mastery: 0.01
  attack: 3
  crit_dmg: 0.005
}
