# GMS's own figures: 200+8x% on three enemies. The summon's duration is
# dropped, as every duration here is -- the shuriken simply always hangs there.
#
# 1.5s between pulses is ours: GMS gives a duration and no rate. It puts the
# skill at 240% a second on each of its three enemies, level with Poison Mist
# and above Creeping Toxin -- which is where a summon reaching this few belongs.
name: "Dark Flare"
skill_order: 3
description:
  "Hang a great shuriken of dark energy beside you that strikes nearby "
  "enemies on its own."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_HERMIT
max_level: 20
max_enemies: 3
cast_interval_seconds: 1.5
base { skill_pct: 2.08 }
per_level { skill_pct: 0.08 }
