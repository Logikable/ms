# A timed party buff in GMS, at 10+x magic attack. Nothing runs out here, so it
# is always up, on the magician and everyone with them.
#
# GMS requires MP Eater Lv. 3 first. MP Eater isn't in this book, since nothing
# uses MP, so the requirement would name a skill that doesn't exist.
name: "Meditation"
description:
  "Enhances the Magic ATT of all nearby party members through meditation."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_WIZARD skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 4 }
max_level: 20
base { magic_attack: 11 }
per_level { magic_attack: 1 }
ally_base { magic_attack: 11 }
ally_per_level { magic_attack: 1 }
