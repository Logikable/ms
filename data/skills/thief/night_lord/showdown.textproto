# The taunt is dropped, but the bonus from taunted enemies stays, given
# permanently.
#
# The shuriken is a side strike, not a summon, so it comes out with this swing
# only. Its six are stated because GMS's Showdown - Spread leaves them at six.
#
# Each shuriken hunts one enemy (`mobCount` 1 in the client), so it scatters;
# the second and later ones on one enemy do half, as GMS states.
name: "Showdown"
description:
  "Attacks enemies and provokes them. Provoked enemies grant more EXP. When "
  "the talisman explodes, it creates a dark shuriken, which then pursues and "
  "attacks nearby enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 2 }
max_level: 30
required_equip_type: EQUIP_TYPE_CLAW
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 6
lines: 2
base {
  skill_pct: 3.73
  exp_pct: 0.0065
  item_drop_pct: 0.0065
}
per_level {
  skill_pct: 0.08
  exp_pct: 0.0015
  item_drop_pct: 0.0015
}
side_strike {
  label: "Shuriken"
  max_enemies: 6
  lines: 6
  cooldown_seconds: 5.0
  base {
    skill_pct: 0.095
    normal_pct: 2.00
  }
  per_level { skill_pct: 0.005 }
  scatter {
    hits: 6
    repeat_final_dmg_pct: -0.50
  }
}
