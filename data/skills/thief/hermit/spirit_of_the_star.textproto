# GMS's own figures: 3x attack and x% boss damage over 10 levels. The half that
# lets a thief attack without using throwing stars is already true here: stars
# are worn, not used up.
#
# The boss damage only matters in boss fights, so while farming it shows only on
# the stats page.
name: "Spirit of the Star"
description: "Increases Attack Power and Boss Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERMIT skill_order: 5 }
max_level: 10
base {
  attack: 3
  boss_pct: 0.01
}
per_level {
  attack: 3
  boss_pct: 0.01
}
