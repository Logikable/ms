# One bank, filled two ways. GMS's "the active and passive effects cannot
# trigger simultaneously" means the charm timer pauses while a load is in.
#
# The 60s limit never matters: namu times the 46 running out in 8 to 11 seconds.
#
# Three charms a press, GMS's two to four averaged.
#
# The charms are part of the character's own swing, so Shadow Partner copies
# them and the Mark triggers on them, as namu says outright.
name: "Throw Blasting"
description:
  "Throw shurikens with explosive charms attached. The charms explode after "
  "the shurikens hit, dealing additional attack to nearby enemies."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_CLAW
base_delay_ms: 960
cooldown_seconds: 120.0
buff {
  duration_seconds: 60.0
  magazine {
    label: "Explosive Charm"
    charges: 46
    charges_per_swing: 3
    spent_by_every_swing: true
    recharge_seconds: 10.0
    recharge_max: 1
    max_enemies: 6
    lines: 5
    base { skill_pct: 4.94 }
    per_level { skill_pct: 0.19 }
  }
}
