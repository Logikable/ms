# Bazel build outputs and convenience symlinks
bazel-*

# Generated by tools/gen_compile_commands.py
compile_commands.json

# clangd background index
.cache/

# Local AI-assistant workflow files (kept out of the public repo)
AGENTS.md
CLAUDE.md
.claude/
__pycache__/
*.pyc

# Ripped MapleStory BGM. The tracks stay out of the repo; the BUILD file that
# globs them does not. Git cannot re-include a file under an excluded
# directory, so this excludes the contents rather than the folder.
bgm/*
!bgm/BUILD
