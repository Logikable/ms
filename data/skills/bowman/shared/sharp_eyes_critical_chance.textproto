# Party-wide for the same reason as Guardbreak (see that file). Adds to the
# character's critical rate, which Sharp Eyes has already raised by 20%.
name: "Sharp Eyes - Critical Chance"
description:
  "Increases the Critical Rate of Sharp Eyes. Applies to party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 6 }
hyper: true
required_level: 180
max_level: 1
base { crit_rate: 0.05 }
ally_base { crit_rate: 0.05 }
