# GMS never prints the afterimage's rate and the client doesn't hold it (no
# `summon` node on 400031020 or 400031021), so one attack a second is the user's
# own observation. `subTime 180` is not the rate; reading it that way once made
# the afterimage fire five times too fast.
#
# One enemy per volley: GMS states no mobCount, and the reach rule only lowers a
# stated cap, it doesn't create one.
name: "Inhuman Speed"
description:
  "Causes you to attack so quickly you produce afterimages. Unaffected by "
  "attack reflection. After performing a certain number of attacks while the "
  "active effect of the skill isn't active, an afterimage is created that "
  "attacks for a short time."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 30.0
  pulse {
    label: "Afterimage"
    cast_interval_seconds: 1.0
    max_enemies: 1
    lines: 3
    base { skill_pct: 4.16 }
    per_level { skill_pct: 0.16 }
  }
}
auto_mode {
  label: "Passive Afterimage"
  attacks_per_cast: 10
  max_enemies: 1
  lines: 3
  silent_while_buff_stands: true
  base { skill_pct: 4.16 }
  per_level { skill_pct: 0.16 }
}
