# GMS strikes 90+2x% three times and burns for 50+3x% a second for two, on top
# of the mastery every magician summon grants. The burn is flattened into the
# strike rather than modelled: two seconds of it would be gone before the next
# pulse, and a mark that short is only arithmetic.
#
# So one line of 150% plus the 2 x 140% the burn came to, at its top level.
name: "Ifrit"
skill_order: 6
description:
  "Summon an ifrit to fight beside you. Its flames burn what they touch, and "
  "learning to call it permanently increases your Mastery."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Spell Mastery"
  level: 10
}
max_enemies: 3
lines: 1
cast_interval_seconds: 3.0
base {
  skill_pct: 1.83
  mastery: 0.51
}
per_level {
  skill_pct: 0.13
  mastery: 0.01
}
