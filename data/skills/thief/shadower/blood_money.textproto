# A passive here: in GMS it is a toggle replacing Pick Pocket at the same 30%.
# Its buff is Assassinate's finishing blow, which that skill already assumes. No
# Combat Orders in GMS either.
name: "Blood Money"
description:
  "Drops coins branded with an Assassin's Mark. Enhances Meso Explosion. "
  "Permanently increases LUK and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 3 }
max_level: 20
required_skill {
  skill_name: "Meso Explosion"
  level: 1
}
base {
  luk: 10
  crit_dmg: 0.01
}
per_level { crit_dmg: 0.01 }
boost {
  skill_name: "Meso Explosion"
  effect { boss_pct: 0.11 }
  effect_per_level { boss_pct: 0.01 }
}
