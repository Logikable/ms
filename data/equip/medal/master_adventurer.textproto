name: "Master Adventurer"
required_level: 100
base_stats {
  str: 2
  dex: 2
  int: 2
  luk: 2
  max_hp: 200
  max_mp: 200
}
equip_job_categories: EQUIP_JOB_CATEGORY_UNIVERSAL
equip_slot: EQUIP_SLOT_MEDAL
# GMS grants this at level 100. Stocked for free instead, so a character already
# past 100 can still collect it.
shop_price: 0
# A trophy can't be scrolled or starred in GMS. Stated even though it has no
# upgrade slots.
unsupported_upgrades: UPGRADE_SCROLL
unsupported_upgrades: UPGRADE_STAR_FORCE
