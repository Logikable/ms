# GMS's own: 670% eight times on 15 enemies, once a minute. The delay is ours,
# as Megiddo Flame's is -- 660ms is what every other cast in this book takes.
#
# GMS also hands the party a buff that saves them from one killing blow, on a
# ten-minute lockout of its own. Dropped: nothing here can survive a hit it
# was not going to survive, and what would read it is a boss that kills the
# player outright. That boss is what it waits for.
name: "Heaven's Door"
description: "Knocks on the door to the heavens to punish enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 2 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
max_enemies: 15
lines: 8
cooldown_seconds: 60.0
base { skill_pct: 6.70 }
