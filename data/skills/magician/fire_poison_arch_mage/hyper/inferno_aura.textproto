# GMS's toggle: 100 MP a second to stand in a ring of fire that bursts every
# three seconds and burns everything it touches for half a minute. Nothing here
# uses MP, so what is left is the burst on its own clock, which is what the
# skill amounts to anyway, since players keep it on.
#
# GMS excludes it from Ignite by name. That happens here automatically: a skill
# on its own clock isn't the character's swing, so no Final Attack follows it.
name: "Inferno Aura"
description:
  "Channel fire chakras to burst into flame, damaging nearby enemies."
kind: SKILL_KIND_AUTO_ATTACK
tags: SKILL_TAG_FIRE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
max_enemies: 10
lines: 2
cast_interval_seconds: 3.0
base { skill_pct: 4.00 }
dot {
  interval_seconds: 1.0
  duration_seconds: 30.0
  lines: 1
  base { skill_pct: 5.00 }
}
