# GMS caps this at 14 and ends at +30 of each. Stretched over 20 levels to the
# same place, starting at 11 rather than the Berserker's 1: the Hero line's
# copy of the skill is the stronger one.
#
# Nothing in this game inflicts an abnormal status or deals elemental damage,
# so this grants nothing today. Written out in full anyway -- the figures
# belong with the skill, and the stats page shows both rows.
name: "Endure"
description:
  "Enhances your Abnormal Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 7 }
max_level: 20
base {
  status_resistance: 11
  elemental_resistance: 0.11
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
