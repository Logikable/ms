# The same staircase as every other Final Attack: chance 2*L%, damage a single
# hit of (100 + 5*floor(L/2))%, taken on the even step below.
#
# The extra hit lands on ONE of the enemies the swing reached, not on each
# of them: GMS's Final Attack carries no mobCount and no hitbox of its own,
# and its readout names the target it picks -- "attacks the boss with the
# highest HP first".
name: "Final Attack: Crossbow"
skill_order: 5
description:
  "When a direct attack skill lands, there's a chance to trigger additional "
  "hits."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_CROSSBOWMAN
final_attack_single_enemy: true
max_level: 20
required_equip_type: EQUIP_TYPE_CROSSBOW
required_skill {
  skill_name: "Crossbow Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 1.0
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.025
}
