# See decent_sharp_eyes.textproto for the shape all six share. The one Decent
# with nothing to exclude: Speed Infusion is a pirate skill, and there are no
# pirates here.
#
# Its stage goes PAST the soft cap instead of counting toward it. Every branch's
# skills reach seven or eight stages against a cap of eight, so a capped stage
# would be worth nothing to half of them and would push out the Inner Ability
# line that gives the same thing. See SkillEffect.uncapped_attack_speed.
name: "Decent Speed Infusion"
description: "Increases your attack speed by 1."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 7 }
v_node: V_NODE_KIND_COMMON
max_level: 30
base {
  uncapped_attack_speed: 1
  str: 1
  dex: 1
  int: 1
  luk: 1
}
per_level {
  str: 0.2
  dex: 0.2
  int: 0.2
  luk: 0.2
}
