# GMS's cooldown is shorter than its duration at every level, so it is a passive
# here.
#
# A flat wave on its own clock replaces GMS's wave per line of the triggering
# skill: the same from the fight's side, since a 5th job warrior is always
# attacking.
name: "Weapon Aura"
description:
  "Infuses your weapon with a portion of your health, granting it a visible "
  "aura and empowering it."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 6 }
v_node: V_NODE_KIND_ARCHETYPE
max_level: 30
base {
  ied_pct: 0.102
  final_dmg_pct: 0.002
}
per_level {
  ied_pct: 0.002
  final_dmg_pct: 0.002
}
auto_mode {
  label: "Aura Wave"
  cast_interval_seconds: 5.0
  max_enemies: 10
  lines: 6
  base { skill_pct: 5.20 }
  per_level { skill_pct: 0.20 }
}
