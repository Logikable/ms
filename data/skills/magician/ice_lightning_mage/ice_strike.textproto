# GMS's own figures: 175+8x% four times over 20 levels, on eight enemies, and
# its eight seconds of freezing. The cooldown the pair below it carries is
# dropped: nothing has to be kept alive for this one.
#
# 840ms is the animation's own, from the frame data: a beat slower than the
# Cold Beam and Thunder Bolt it takes over from.
name: "Ice Strike"
description:
  "Create an ice-attribute explosion near you that attacks nearby enemies."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_ICE
freeze_seconds: 8.0
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_MAGE skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 840
max_enemies: 8
lines: 4
base { skill_pct: 1.83 }
per_level { skill_pct: 0.08 }
