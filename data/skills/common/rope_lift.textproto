# One of the four nodes at the bottom of the V page: skills this game has no use
# for (no platform to climb, no town to open a door to, nowhere to blink, no
# fountain to walk to). They are kept because a matrix without them would be
# tidier but worse. Each has GMS's own passive, which is all it does here, and
# GMS doesn't make them equal.
name: "Rope Lift"
description:
  "Fires a grappling hook to a platform above you. Nobody here remembers what "
  "it was for."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 9 }
v_node: V_NODE_KIND_COMMON
max_level: 30
base {
  str: 1
  dex: 1
  int: 1
  luk: 1
}
per_level {
  str: 1
  dex: 1
  int: 1
  luk: 1
}
