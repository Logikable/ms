# The first Arcane River mob, where the ladder changes era: 3.3x the HP of the
# level-198 golem three levels below. This is GMS's own number; the map's Arcane
# Force requirement is what makes up for it.
name: "Raging Erda"
level: 201
attack: 12938
max_hp: 46056000
exp: 101389
pdr: 10
# The area's Arcane Symbol, at GMS's drop rate. It is so rare that dailies are
# what really level a symbol. A duplicate counts as one toward the next level
# (see arcane_force.h).
drops { equip: "symbol_vanishing_journey" per_kill: 0.0001 }
