# GMS's decoy, cut down to damage and its stun. Nothing here draws aggro, so its
# health bar and counterattack are dropped.
#
# Six enemies instead of GMS's eight and 200% at 20 levels instead of 30: with
# only damage left it would otherwise overshadow Frostprey.
#
# Three seconds between strikes, observed: GMS states no rate.
name: "Arrow Illusion"
description:
  "Summons an arrow illusion that damages enemies on its own. Also increases "
  "Ignore Defense permanently."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 4 }
max_level: 20
exceeds_master_level: true
max_enemies: 6
cast_interval_seconds: 3.0
stun {
  duration_seconds: 4.0
  chance: 0.7
}
base { skill_pct: 1.05 }
per_level { skill_pct: 0.05 }
# GMS lists the Ignore DEF under "[Passive Effects]", so it belongs to the
# Marksman, not the decoy.
passive { ied_pct: 0.015 }
passive_per_level { ied_pct: 0.015 }
