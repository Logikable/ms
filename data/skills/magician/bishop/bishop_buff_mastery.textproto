# The V matrix is outside the Buff Duration: GMS marks every node
# notIncBuffDuration. GMS's 3+4*floor(x/5)% is written as L+1, the same top.
name: "Buff Mastery"
description:
  "Permanently increases Magic ATT and Final Damage and increases the "
  "duration of all buffs on you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 9 }
max_level: 10
exceeds_master_level: true
base {
  magic_attack: 3
  final_dmg_pct: 0.02
  buff_duration_pct: 0.05
}
per_level {
  magic_attack: 3
  final_dmg_pct: 0.01
  buff_duration_pct: 0.05
}
