# A currency, not loot: it sells for nothing, and every clear drops one. The
# diamond marks its stage of the game, as the circle marks Frozen and the
# triangle Root Abyss and Cygnus.
name: "AbsoLab Coin"
kind: ITEM_KIND_TOKEN
description:
  "Scrap off the Black Heaven itself. The shop trades these for AbsoLab "
  "equipment."
currency_mark: "◆"
currency_color: CURRENCY_COLOR_THEME
