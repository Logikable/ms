description: "Increases Critical Rate bonus from Final Pact's passive effect."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 9 }
hyper: true
required_level: 180
max_level: 1
base { crit_rate: 0.20 }
