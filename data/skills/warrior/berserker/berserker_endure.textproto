# GMS maxes this at 14 and ends at +20 of each. Stretched over 20 levels to the
# same place, like Lord of Darkness.
#
# Nothing in this game inflicts a status or deals elemental damage, so this
# gives nothing yet. It is written in full anyway: the figures belong with the
# skill, and the stats page shows both rows so a player can see what their
# points bought.
name: "Endure"
description:
  "Enhances your Abnormal Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BERSERKER skill_order: 7 }
max_level: 20
base {
  status_resistance: 1
  elemental_resistance: 0.01
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
