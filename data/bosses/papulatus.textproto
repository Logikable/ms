name: "Papulatus"
difficulties {
  # No Normal: GMS's Easy and Normal are at 115 and 155, below what a character
  # already clears by the time this unlocks.
  name: "Chaos"
  phases {
    bgm: "WhereverYouAre"
    spawns {
      mob: "chaos_papulatus_clock"
      spots { x: 4 y: 4 }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 3 }
    player_spots { x: 6 y: 3 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns {
      mob: "chaos_papulatus"
      spots { x: 4 y: 4 }
      walk { interval_ms: 500 range: RANGE_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # GMS allows thirty minutes; twenty makes the timer part of the fight.
  time_limit_seconds: 1200
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price, divided by seven, since GMS
  # clears Chaos once a week and this game once a day.
  meso: 18900000
  # GMS pays this on the body itself; here the clear pays it.
  exp: 1234200
  drops {
    equip: "papulatus_mark"
    per_kill: 1.0
  }
  drops {
    item: "papulatuss_soul_shard"
    per_kill: 1.0
  }
}
