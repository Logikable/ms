# The wound is a buff the swing lays: what leaves one is puncturing something,
# so it stands for a stretch and the fight spends a swing going back for it
# when it lapses. Both halves of it wait on that -- the damage a wounded enemy
# takes, and the pulse that ticks on them.
#
# The tick's chance and its damage fold into one figure the way a Final
# Attack's do: a 40 + 2L% chance of 75 + 3L% every two seconds is what one is
# worth.
#
# So the swing itself is one a Hero rarely spends -- Raging Blow lands harder
# once the wound is up -- which is the shape GMS has: puncture, then hold.
#
# The party's share of the wound is a flat grant rather than a mark on the
# monster, because the Hero's own share already is: both are read off the
# character, and the wound stands for all but a moment of the fight. GMS pays
# an ally ceil(x/3)% where the Hero takes 10+ceil(x/2)% -- 10% against 25% at
# master.
name: "Puncture"
skill_order: 2
description:
  "Pour your swordsman's spirit into a forward-downward strike, leaving a "
  "wound on your enemy that deals continuous damage. While taking continuous "
  "damage, the enemy will also take more damage."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_SWORDSMANSHIP
job_advancement: JOB_ADVANCEMENT_HERO
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
exceeds_master_level: true
base_delay_ms: 720
max_enemies: 8
lines: 4
required_skill {
  skill_name: "Advanced Combo"
  level: 20
}
base {
  skill_pct: 3.13
  normal_skill_pct: 0.50
}
per_level { skill_pct: 0.03 }
ally_base { damage_pct: 0.013 }
ally_per_level { damage_pct: 0.003 }
buff {
  duration_seconds: 45.5
  duration_seconds_per_level: 0.5
  base { damage_pct: 0.105 }
  per_level { damage_pct: 0.005 }
  pulse {
    label: "Wound"
    cast_interval_seconds: 2.0
    lines: 1
    base { skill_pct: 0.345 }
    per_level { skill_pct: 0.045 }
  }
}
