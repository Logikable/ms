# A permanent party passive here: GMS's 300-second cast is kept up all the time.
# 20 levels instead of GMS's 30, ending at GMS's top pair.
name: "Sharp Eyes"
description:
  "Grants party members the ability to locate an enemy's weak spot to deal "
  "fatal damage to that enemy."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 5 }
exclusive_group: "Sharp Eyes"
max_level: 20
exceeds_master_level: true
base {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
per_level {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
ally_base {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
ally_per_level {
  crit_rate: 0.01
  crit_dmg: 0.0075
}
