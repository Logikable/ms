# Twenty seconds of a bigger stack cap, once a minute. Both halves belong to
# Freezing Crush, not this skill: the cap it raises is that skill's, and the
# magic attack it gives goes only to ice swings, once per stack held. A
# character without Freezing Crush gets neither.
#
# GMS states it as "increase max Freeze Stacks: 8", taking the I/L's five to
# thirteen, and thirteen is what Frozen Lightning's "reduces Freeze Stacks by
# 10" was written for.
name: "Glacial Fury"
description:
  "Harnesses the extreme cold to greatly enhance your ice's Magic ATT."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 60.0
buff {
  duration_seconds: 20.0
  base {
    freeze_stack_cap_bonus: 8
    magic_attack_per_freeze_stack: 5
  }
}
