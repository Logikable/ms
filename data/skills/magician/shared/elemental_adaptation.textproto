# GMS's barrier blocks status conditions and recharges; only the passive half
# listed under it is kept here, x% of each resistance at level x.
#
# Both levers are useless by design. Nothing in this game inflicts a status or
# has an element, so neither is ever used; they keep the wiki's figures with the
# skill, and the stats page shows them.
name: "Elemental Adaptation"
description: "Permanently increases Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_MAGE skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 4 }
max_level: 20
base {
  status_resistance: 1
  elemental_resistance: 0.01
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
