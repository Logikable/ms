# GMS states the whole of the Final Attack here rather than a delta over the
# Fighter's -- 45 + ceil(L/2)% for 110 + 2L%, three times -- so this supersedes
# it rather than stacking on it. The three strikes are told apart, each rolling
# its own crit and mastery.
#
# The weapons it demands are the Fighter's, so the pair lapse together: a Hero
# holding something neither will fire off keeps neither.
#
# The extra hit lands on ONE of the enemies the swing reached, not on each
# of them: GMS's Final Attack carries no mobCount and no hitbox of its own,
# and its readout names the target it picks -- "attacks the boss with the
# highest HP first".
name: "Advanced Final Attack"
skill_order: 6
description:
  "Permanently increases Attack Power. Greatly increases activation rate and "
  "damage of Final Attack."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_HERO
final_attack_single_enemy: true
max_level: 30
exceeds_master_level: true
supersedes_skill_name: "Final Attack"
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_skill {
  skill_name: "Final Attack"
  level: 20
}
base {
  attack: 1
  final_attack_chance: 0.455
  final_attack_pct: 1.12
  final_attack_lines: 3
}
per_level {
  attack: 1
  final_attack_chance: 0.005
  final_attack_pct: 0.02
}
