# GMS's steps, ceil(L/4)+1 percent every 9 - floor(L/2) seconds, are
# straightened to land on GMS's max.
name: "Self Recovery"
description: "Regularly recovers some HP, even in combat."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 4 }
max_level: 10
base {
  regen_pct: 0.022
  regen_interval_seconds: 8.5
}
per_level {
  regen_pct: 0.002
  regen_interval_seconds: -0.5
}
