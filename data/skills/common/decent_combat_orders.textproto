# See decent_sharp_eyes.textproto for the shape all six share. This one climbs
# in status resistance instead of All Stats, as in GMS, though nothing here uses
# it, since there are no statuses. It is kept and shown on the stats page, like
# every other source of it.
#
# The White Knight's own skill gives a level from ITS level 1 and two at the
# top, so it always beats this.
name: "Decent Combat Orders"
description:
  "Increases all of your skill levels. 4th job skills that have already "
  "reached the master level can be raised further; other skills can only be "
  "increased to master level. Exceptions: Combat Orders, hyper skills, and "
  "5th job skills cannot be increased. Does not stack with Combat Orders."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 5 }
v_node: V_NODE_KIND_COMMON
exclusive_group: "Combat Orders"
max_level: 30
base {
  skill_level_bonus: 1.0
  status_resistance: 1
}
per_level { status_resistance: 0.2 }
