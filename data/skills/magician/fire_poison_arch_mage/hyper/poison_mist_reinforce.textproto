# GMS's "Damage: +20%", read as everywhere else on this page: extra damage %
# only Poison Mist gets. It applies to the mark the mist leaves as well as the
# cast (a burn uses the swing's own stats), which is what Cripple below adds
# points to.
name: "Poison Mist - Reinforce"
description: "Increases Poison Mist damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 4 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Poison Mist"
  effect { damage_pct: 0.20 }
}
