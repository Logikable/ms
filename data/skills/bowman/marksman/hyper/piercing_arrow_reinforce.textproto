# GMS names five swings: both arrows, both empowered forms and the fragment. Two
# boosts cover them all. The damage is extra damage % only this swing gets, and
# the swing's first hit and its explosion use the same stats, so the fragment
# gains with the arrow that threw it.
#
# Piercing Arrow is replaced by Piercing Arrow II long before 140, so the boost
# on it never applies. It is written because GMS writes it, and so this hyper
# pays if the arrow is ever used again.
name: "Piercing Arrow - Reinforce"
description:
  "Increases damage of Piercing Arrow, Piercing Arrow II, Arrow Fragments, "
  "Empowered Piercing Arrow, and Empowered Piercing Arrow II."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 7 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Piercing Arrow"
  reach: BOOST_REACH_BOTH
  effect { damage_pct: 0.20 }
}
boost {
  skill_name: "Piercing Arrow II"
  reach: BOOST_REACH_BOTH
  effect { damage_pct: 0.20 }
}
