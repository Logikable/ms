# The warriors' Final Attack under another name, with the same numbers: chance
# 2*L%, damage one hit of (100 + 5*floor(L/2))%. Rounding down to the even level
# ends just under the top and is never more than 2.5% off.
#
# The extra hit lands on one enemy the swing reached, not on each. GMS's Final
# Attack has no mobCount or hitbox of its own, and its text names its target:
# "attacks the boss with the highest HP first".
name: "Final Attack: Bow"
description:
  "Chance to deal an additional hit after landing a direct attack skill."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HUNTER skill_order: 6 }
final_attack_max_enemies: 1
max_level: 20
required_equip_type: EQUIP_TYPE_BOW
required_skill {
  skill_name: "Bow Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 1.0
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.025
}
