# Two boosts because GMS names two skills: the client aims this at Hurricane,
# at Arrow Blaster and at the blaster it leaves standing. The second boost
# covers both halves of Arrow Blaster on its own -- the turret carries its
# parent's name, which is what a boost is keyed by.
name: "Hurricane - Reinforce"
skill_order: 10
description:
  "Increases damage for Hurricane, Arrow Blaster, and installed Arrow "
  "Blaster."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BOW_MASTER
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Hurricane"
  effect { damage_pct: 0.30 }
}
boost {
  skill_name: "Arrow Blaster"
  effect { damage_pct: 0.30 }
}
