# A toggle in GMS, and worth an elemental resistance and a freeze that nothing
# here has. What is left is the damage it cancels, which the wizard carries all
# the time rather than while the aura is up.
#
# Status resistance is carried and never read: nothing inflicts a status. It is
# here to keep the wiki's figure beside the skill it belongs to.
name: "Absolute Zero Aura"
description: "Envelops you and nearby party members in a shield of cold."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_WIZARD skill_order: 4 }
max_level: 10
base {
  damage_taken_pct: 0.02
  status_resistance: 2
}
per_level {
  damage_taken_pct: 0.02
  status_resistance: 2
}
ally_base {
  damage_taken_pct: 0.02
  status_resistance: 2
}
ally_per_level {
  damage_taken_pct: 0.02
  status_resistance: 2
}
