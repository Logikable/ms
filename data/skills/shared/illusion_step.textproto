# GMS masters this at 30 and reaches 80 DEX, 30% avoidability and 20% less
# damage taken. Compressed to 10 levels landing on all three, so a point is
# worth three times what GMS pays for one and the skill is no stronger.
#
# The avoidability is the flat kind -- GMS calls it a Bonus Avoidability
# Chance, a roll that cancels the whole hit -- which is what dodge_chance is.
# It meets Evasion Boost's the way two rolls meet, so the pair come to 51%
# rather than 60%. The knockback resistance is left out: no mob knocks back.
name: "Illusion Step"
description:
  "Greatly increases your DEX and Avoidability, and reduces damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 8 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 8 }
max_level: 10
exceeds_master_level: true
base {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
per_level {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
