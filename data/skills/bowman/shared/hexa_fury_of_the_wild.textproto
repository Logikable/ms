# GMS (500001024): the opening sweeps 8 lines over 4 seconds, read as one
# attack every 0.5s. The bird's interval stays the 3.42s Fury of the Wild
# measures; GMS's 120s cooldown no longer shortens with level.
name: "HEXA Fury of the Wild"
description:
  "Temporarily enhances Phoenix with mysterious power. Attunes Fury of the "
  "Wild to the power of flames, which sweeps across the battlefield before "
  "returning to your side to attack enemies. Unaffected by attack reflection."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_VI skill_order: 12 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_VI skill_order: 9 }
hexa_node: HEXA_NODE_KIND_ARCHETYPE
max_level: 30
required_skill { skill_name: "Fury of the Wild" level: 30 }
supersedes_skill_name: "Fury of the Wild"
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 40.0
  opening_pulse {
    label: "Phoenix Flames"
    cast_interval_seconds: 0.5
    max_pulses: 8
    max_enemies: 15
    lines: 8
    base { skill_pct: 6.54 }
    per_level { skill_pct: 0.30 }
  }
  pulse {
    label: "Empowered Summon"
    cast_interval_seconds: 3.42
    max_enemies: 10
    lines: 11
    base { skill_pct: 8.44 }
    per_level { skill_pct: 0.37 }
  }
}
line_overrides {
  line: JOB_CROSSBOWMAN
  skill {
    description:
      "Temporarily enhances Frostprey with mysterious power. Attunes Fury of "
      "the Wild to the power of ice, which sweeps across the battlefield "
      "before returning to your side to attack enemies. Unaffected by attack "
      "reflection."
    buff {
      opening_pulse {
        label: "Frostprey Chill"
        base { skill_pct: 8.15 }
        per_level { skill_pct: 0.36 }
      }
      pulse {
        base { skill_pct: 9.63 }
        per_level { skill_pct: 0.41 }
      }
    }
  }
}
