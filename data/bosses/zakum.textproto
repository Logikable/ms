name: "Zakum"
difficulties {
  name: "Normal"
  # The eight arms stand in two columns with the player between them, which is
  # where the fight puts them: one spawn each, because a spot belongs to one
  # monster.
  phases {
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spawns { mob: "zakum_arm" count: 1 }
    spots { x: 0 y: 0 }
    spots { x: 0 y: 1 }
    spots { x: 0 y: 2 }
    spots { x: 0 y: 3 }
    spots { x: 4 y: 0 }
    spots { x: 4 y: 1 }
    spots { x: 4 y: 2 }
    spots { x: 4 y: 3 }
    player { x: 2 y: 1 }
    arena_width: 6
    arena_height: 4
  }
  # The body alone, standing over the player.
  phases {
    spawns { mob: "zakum" count: 1 }
    spots { x: 2 y: 0 }
    player { x: 2 y: 1 }
    arena_width: 6
    arena_height: 2
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  # GMS opens Normal Zakum at 110, which is also the level his arms are.
  unlock_level: 110
  # What GMS pays as an Intense Power Crystal, which is a drop nobody keeps:
  # five of them at the Heroic price, handed over as the meso they would fetch.
  meso: 3062500
  drops {
    equip: "aquatic_letter_eye_accessory"
    per_kill: 0.5
  }
  drops {
    equip: "condensed_power_crystal"
    per_kill: 0.5
  }
  drops {
    item: "zakums_soul_shard"
    per_kill: 1.0
  }
}
