# GMS pays 2*ceil(x/3)% critical damage over 30 levels, for 30 seconds against a
# 120-second wait. Ten levels here at 2% apiece, which lands on GMS's own 20%.
#
# GMS shelters the whole party under it outright -- nobody standing in it takes
# damage at all -- and a share off a hit IS how this game says that: the whole
# of it, for the thirty seconds the smoke stands. GMS's other half, ceil(x/3)%
# off damage taken in proportion to Max HP, is dropped: nothing here scales a
# hit off the player's pool.
name: "Smokescreen"
skill_order: 6
description:
  "Drop a Smokescreen near you. All party members within Smokescreen range "
  "will take no damage for the duration. In addition, enemies inside the "
  "Smokescreen will take more critical damage."
kind: SKILL_KIND_ACTIVE
job_advancement: JOB_ADVANCEMENT_SHADOWER
max_level: 10
exceeds_master_level: true
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 30.0
  base {
    crit_dmg: 0.02
    damage_taken_pct: 1.00
  }
  per_level { crit_dmg: 0.02 }
  # What everyone else standing in it gets: the same shelter, and nothing of the
  # critical damage -- that is paid by the enemies inside, and they are inside
  # it for whoever swings at them.
  ally_base { damage_taken_pct: 1.00 }
}
