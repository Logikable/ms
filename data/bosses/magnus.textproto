name: "Magnus"
difficulties {
  name: "Normal"
  # One body alone in the middle of his arena, as Hilla is: nothing else to
  # kill, and the whole floor to walk while killing it.
  phases {
    spawns { mob: "magnus" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # What Horntail allows. He is twice the body, but the gate is forty levels
  # over him and every branch clears him inside half of it.
  time_limit_seconds: 600
  # Traded with Pink Bean (2026-08-31). Six billion in ONE body is the whole
  # of it -- a fight of many parts has half of them left standing when the
  # objective falls -- so he outplayed his old 160 gate: six of ten branches
  # were clearing Pink Bean, ten levels above him, first.
  unlock_level: 170
  # Five Intense Power Crystals at what his level fetches, as Zakum's, Hilla's
  # and Horntail's meso is.
  meso: 12960000
  # Paid for the clear, flat and untouched by any EXP bonus, as the other
  # three are.
  exp: 5300000
  drops {
    equip: "crystal_ventus_badge"
    per_kill: 1.0
  }
  drops {
    equip: "royal_black_metal_shoulder"
    per_kill: 1.0
  }
  drops {
    item: "magnuss_soul_shard"
    per_kill: 1.0
  }
}
# Written down, not built: the same lone fight at the numbers GMS gives Hard.
# Only the HP is stated, because nothing else is decided.
difficulties {
  name: "Hard"
  phases {
    spawns { mob: "hard_magnus" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  coming_soon: true
}
