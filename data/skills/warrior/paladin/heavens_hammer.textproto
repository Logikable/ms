# This pays MORE against bosses, where a bonus like this usually pays against
# ordinary monsters. The 30% applies in boss fights; on a map the skill is its
# eight strikes across fifteen enemies, which is what it is tuned on.
#
# Its cooldown shortens with levels: GMS's 30 - floor(L/2), straightened to the
# same 15 seconds at max.
name: "Heaven's Hammer"
description:
  "Slam a large hammer into the ground, dealing damage to multiple enemies. "
  "You deal additional damage to bosses."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 4 }
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
exceeds_master_level: true
base_delay_ms: 660
cooldown_seconds: 29.5
cooldown_seconds_per_level: -0.5
max_enemies: 15
lines: 8
base {
  skill_pct: 4.46
  boss_pct: 0.30
}
per_level { skill_pct: 0.06 }
