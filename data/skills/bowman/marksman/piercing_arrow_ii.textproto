# The Crossbowman's arrow, stated in full instead of as an increase (more
# enemies, strikes and damage), so it supersedes the skill it grows from instead
# of adding to it.
#
# The fragment bounces off the first enemy onto two of the eight the arrow
# passed through, which is what lead_enemies is for: like a Rogue's opening hit,
# but landing on more than one.
name: "Piercing Arrow II"
description:
  "Enhances Piercing Arrow. Upon striking the first foe, your Piercing Arrow "
  "now fragments, dealing damage to additional enemies."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_MARKSMANSHIP
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 1 }
max_level: 30
required_equip_type: EQUIP_TYPE_CROSSBOW
exceeds_master_level: true
supersedes_skill_name: "Piercing Arrow"
required_skill {
  skill_name: "Piercing Arrow"
  level: 20
}
base_delay_ms: 660
max_enemies: 8
lines: 5
pierce_gain_pct: 0.15
lead_lines: 4
lead_enemies: 2
base {
  skill_pct: 2.27
  lead_pct: 2.05
}
per_level {
  skill_pct: 0.04
  lead_pct: 0.05
}
