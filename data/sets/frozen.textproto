name: EQUIP_SET_NAME_FROZEN
complete_pieces: 8
# In the order the inspect screen lists them, which is the order they are worn
# in rather than the order they drop in.
members {
  slot: EQUIP_SLOT_HAT
  items { name: "Frozen Hat" }
}
members {
  slot: EQUIP_SLOT_TOP
  items { name: "Frozen Top" }
}
members {
  slot: EQUIP_SLOT_BOTTOM
  items { name: "Frozen Bottom" }
}
members {
  slot: EQUIP_SLOT_SHOES
  items { name: "Frozen Boots" }
}
members {
  slot: EQUIP_SLOT_GLOVES
  items { name: "Frozen Gloves" }
}
members {
  slot: EQUIP_SLOT_CAPE
  items { name: "Frozen Cape" }
}
# Named as families rather than by name: a weapon here belongs to one class,
# so there is one per class rather than one item. Both shelves are bought with
# the tokens the level 101-140 mobs drop.
members {
  slot: EQUIP_SLOT_PRIMARY_WEAPON
  family: "Frozen Weapon"
}
members {
  slot: EQUIP_SLOT_SECONDARY
  family: "Frozen Secondary"
}
# GMS's own three tiers, at GMS's own values. Its Frozen set spans five slots
# -- hat, overall, cape, weapon, secondary -- where this one spans eight, so
# the whole of it is earned at five pieces and the three above that pay
# nothing. The eight stay members: what a piece is worth toward the set is not
# the only reason to wear it.
tiers {
  pieces: 3
  effect {
    str: 7
    dex: 7
    int: 7
    luk: 7
    attack: 6
    magic_attack: 6
  }
}
tiers {
  pieces: 4
  effect {
    max_hp_pct: 0.20
    max_mp_pct: 0.20
    attack: 14
    magic_attack: 14
    damage_pct: 0.09
  }
}
