# GMS splits this into a permanent 20 and a buff that builds another 100 while
# attacking; a Ranger always attacks, so here they are one figure.
#
# Nothing inflicts a status or element here; it is shown so SP isn't spent
# blind.
name: "Focused Fury"
description: "Permanently increases Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 6 }
max_level: 20
base { status_resistance: 6 elemental_resistance: 0.01 }
per_level { status_resistance: 6 elemental_resistance: 0.01 }
