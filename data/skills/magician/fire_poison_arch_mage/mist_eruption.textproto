# GMS's own numbers throughout. The client says 10 attacks and "Number of
# Explosions: 2": a cast sets off two mists at once, so an enemy caught in both
# takes the ten hits twice. Twenty lines of 95+x%.
#
# The final damage is also GMS's: +20% for two explosions, up to +125% for five.
# Nothing here places mists, so the count can't change and the skill keeps the
# value for its own two explosions. It applies to this swing only, like an
# attack's Ignore DEF.
#
# The Ignore DEF climbs with the skill, like GMS's 10+x%, and ends where GMS's
# does.
#
# The passive permanently raises Poison Mist. It boosts the mist itself (the
# mark the cast leaves, not the cast), so it is points on the tick: 240% a
# second becomes 300% when this is maxed.
name: "Mist Eruption"
description:
  "Permanently increases Poison Mist's continuous damage. Upon using the "
  "skill, nearby Poison Mists explode, dealing fatal poison damage to "
  "enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 2 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
required_skill {
  skill_name: "Poison Mist"
  level: 20
}
base_delay_ms: 660
max_enemies: 12
lines: 20
cooldown_seconds: 10.0
base {
  skill_pct: 0.965
  ied_pct: 0.115
  final_dmg_pct: 0.20
}
per_level {
  skill_pct: 0.015
  ied_pct: 0.015
}
boost {
  skill_name: "Poison Mist"
  dot_skill_pct: 0.315
  dot_skill_pct_per_level: 0.015
}
