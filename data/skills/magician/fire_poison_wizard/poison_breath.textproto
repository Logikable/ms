# GMS's own skill, poison included: 130+5x% six times, and the cloud keeps
# damaging whatever it touched for as long as it lasts.
#
# The longer animation of the pair, which the burn makes up for: the chooser
# values a burn at the rate the swing can keep up, so that total decides which
# of the two it picks, not a cooldown.
name: "Poison Breath"
description:
  "Conjure a poison-attribute cloud, inflicting fatal damage to enemies. The "
  "enemies will take additional periodic damage."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 3 }
max_level: 10
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 780
max_enemies: 6
lines: 6
base { skill_pct: 1.35 }
per_level { skill_pct: 0.05 }
dot {
  base { skill_pct: 0.33 }
  per_level { skill_pct: 0.03 }
  interval_seconds: 1.0
  duration_seconds: 5.5
  duration_seconds_per_level: 0.5
}
