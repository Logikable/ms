# The mastery skill, over 20 levels rather than GMS's 10 so that the book costs
# the 90 the Assassin's levels pay out. The mastery runs 12% to 50%, the same
# climb every other 20-level mastery makes.
#
# GMS also raises the number of throwing stars a claw carries. Stars here are
# an equipped item that never runs out, so there is no count to raise.
name: "Claw Mastery"
skill_order: 3
description:
  "Steadies your throw, so your weakest stars land nearer your best."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_ASSASSIN
max_level: 20
required_equip_type: EQUIP_TYPE_CLAW
base { mastery: 0.12 }
per_level { mastery: 0.02 }
