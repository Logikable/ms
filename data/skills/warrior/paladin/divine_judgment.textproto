# The brand is on the enemy, as in GMS: the fifth brand detonates on that enemy
# alone, so a monster that dies at four gives none.
#
# The 20% Ignore DEF applies to this swing only (see WithoutSwingLevers).
name: "Divine Judgment"
description:
  "Marks enemies struck by your Blast skill with a Divine Brand. Upon "
  "reaching the max number of stacks, the Divine Brands detonate, inflicting "
  "additional damage that ignores some of the enemy's Defense."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 3 }
max_level: 30
exceeds_master_level: true
required_skill {
  skill_name: "Blast"
  level: 5
}
empowered_form {
  skill_name: "Blast"
  casts_per_trigger: 5
  brands_each_enemy: true
  lines: 10
  base {
    skill_pct: 5.06
    ied_pct: 0.20
  }
  per_level { skill_pct: 0.04 }
}
