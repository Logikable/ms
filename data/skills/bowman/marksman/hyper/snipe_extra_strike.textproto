# Nine strikes to ten, and the empowered shot's mark hits from five to six. The
# mark is on Empowered Snipe, not Snipe (see Greater Empowered Arrows), and the
# boost follows the skill into its form to reach it.
name: "Snipe - Extra Strike"
description:
  "Increases the number of attacks of Snipe, Empowered Snipe, and of Snipe's "
  "additional hits."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 10 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Snipe"
  lines: 1
  extra_hit_lines: 1
  reach: BOOST_REACH_BOTH
}
