# GMS's text ends "Final damage increases by 15% with each enemy pierced, and
# damage is doubled". That is one mechanic, not two: each enemy multiplies by
# 1.15, so the sixth takes 1.15^5 = 2.01x the first, the doubling. The swing
# picks the order, since nothing has a position. Worth +46% on a full six and
# nothing on one mob.
name: "Piercing Arrow"
description: "Fire an arrow. Its effect increases with each enemy it hits."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_CROSSBOWMAN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_CROSSBOW
base_delay_ms: 780
max_enemies: 6
lines: 4
pierce_gain_pct: 0.15
base { skill_pct: 0.92 }
per_level { skill_pct: 0.02 }
