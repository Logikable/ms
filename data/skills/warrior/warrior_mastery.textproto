# HP is the whole skill here: its other effects (speed, jump, max speed,
# knockback resistance) aren't modelled. It ends where GMS's does, at 20 HP per
# character level, but climbs a point at a time instead of giving most of it
# with the first point.
name: "Warrior Mastery"
description: "Trains up your warrior basics to increase Max HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SWORDMAN skill_order: 3 }
max_level: 20
base {
  max_hp_per_level: 1
}
per_level {
  max_hp_per_level: 1
}
