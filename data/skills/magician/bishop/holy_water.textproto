# GMS fills a chalice from Angel Ray's hits, and party members drink from it for
# 5% of HP, +5% per 2500 INT. Nobody walks anywhere here, so it just pours, for
# the Bishop and everyone with them: the same 5% at max level, on a ten-second
# cooldown, plus the same again for every 2500 INT the Bishop has.
#
# The party's share uses the DRINKER's INT, not the Bishop's, because the
# calculation only knows the character it is for.
#
# The value scales with a stat instead of a level, which is why a Bishop's INT
# is worth more than its damage suggests.
name: "Holy Water"
description:
  "Summons a chalice of holy water nearby that restores party members' HP "
  "over time."
kind: SKILL_KIND_PASSIVE
tags: SKILL_TAG_BENEVOLENCE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 4 }
max_level: 10
exceeds_master_level: true
base {
  regen_pct: 0.005
  regen_interval_seconds: 10.0
  regen_int_step: 2500
}
per_level { regen_pct: 0.005 }
ally_base {
  regen_pct: 0.005
  regen_interval_seconds: 10.0
  regen_int_step: 2500
}
ally_per_level { regen_pct: 0.005 }
