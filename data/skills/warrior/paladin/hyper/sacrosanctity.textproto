# Thirty seconds of taking no damage, once every five minutes. It is all
# damage_taken_pct at 1.00, which the fight takes off the hit itself (see
# BuffOption::damage_taken_pct).
#
# GMS lets a Paladin end it early and get cooldown back for the seconds unused;
# the fight would never want to, since the invincibility costs nothing to keep.
#
# Its own animation is 900ms, and GMS doesn't allow invincibility skills in a
# skill sequence, so this is one of the few casts that would really play it. It
# still costs the sequence's flat 120ms: one cast every 300 seconds isn't worth
# a way to express it in the data.
name: "Sacrosanctity"
description:
  "Call upon the heavens to protect you from all attacks for a short time."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 300.0
buff {
  duration_seconds: 30.0
  base { damage_taken_pct: 1.00 }
}
