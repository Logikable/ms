# GMS hides the thief for twenty seconds in a stealth attacks don't break, and
# gives final damage for attacking from it. There is no stealth here, so only
# the damage is left.
#
# It stacks with Advanced Dark Sight, as GMS says outright ("added on top of
# Advanced Dark Sight's Final Damage bonus"), so it has no exclusive group. Only
# the Shadower has that skill; the Night Lord never learns it.
#
# The cooldown is exactly GMS's 150 - x, 149 seconds down to 120. The damage
# steps by an even amount instead of GMS's floor, so max level lands exactly on
# its 14% and only the start moves.
name: "Shadow Walker"
description:
  "Your stealth is honed past the point of breaking, and you strike from "
  "inside it."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 11 }
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 11 }
v_node: V_NODE_KIND_ARCHETYPE
max_level: 30
base_delay_ms: 120
cooldown_seconds: 149.0
cooldown_seconds_per_level: -1.0
buff {
  duration_seconds: 20.0
  base { final_dmg_pct: 0.082 }
  per_level { final_dmg_pct: 0.002 }
}
