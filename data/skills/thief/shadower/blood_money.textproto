# GMS's own figures: 10+x% boss damage on Meso Explosion, x% critical damage,
# and ceil(x/2) LUK. The boss damage applies to the coins, not the Shadower,
# which is what a boost targeting Meso Explosion is for.
#
# A passive here. In GMS it is a toggle that replaces Pick Pocket at the same
# 30% chance, so what it replaces is what it gives, and the drop needs no
# mention. Its buff is Assassinate's finishing blow, which that skill already
# assumes. Combat Orders doesn't reach it in GMS either.
name: "Blood Money"
description:
  "Drops coins branded with an Assassin's Mark. Enhances Meso Explosion. "
  "Permanently increases LUK and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 3 }
max_level: 20
required_skill {
  skill_name: "Meso Explosion"
  level: 1
}
base {
  luk: 10
  crit_dmg: 0.01
}
per_level { crit_dmg: 0.01 }
boost {
  skill_name: "Meso Explosion"
  effect { boss_pct: 0.11 }
  effect_per_level { boss_pct: 0.01 }
}
