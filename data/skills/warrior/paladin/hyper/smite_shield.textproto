# The Paladin's map swing on a two-minute cooldown: 500% six times across
# fifteen enemies, where Blast lands ten strikes on three. Against a boss it is
# worth little, 3000% every two minutes, which is also GMS's trade-off.
#
# 1320ms is the animation's own, from the frame data, twice a typical 4th job
# swing. The stun is GMS's ten seconds; its doubling with damage dealt and the
# 90 seconds of stun resistance afterward are dropped, as is the buff removal,
# since no monster here has buffs.
name: "Smite Shield"
description:
  "Summons a hammer imbued with unyielding strength to strike down nearby "
  "enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 2 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
base_delay_ms: 1320
cooldown_seconds: 120.0
max_enemies: 15
lines: 6
stun { duration_seconds: 10.0 }
base { skill_pct: 5.00 }
