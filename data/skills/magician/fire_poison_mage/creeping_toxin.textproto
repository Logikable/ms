# The pool ticks for 120+6x%, and fire cast into it detonates it for 158+3x%
# four times. GMS masters this at 14, where those come to 204% and 200%; the
# same ends over 20 levels step a clean 4% and 2%.
#
# Nothing here casts one skill into another, so the detonation is on a count
# instead: every fourth tick is the explosion rather than the pool. That is an
# empowered form with no skill named -- the one it upgrades is itself.
#
# The normal-enemy bonus is stated once for the whole skill, so both halves
# carry it.
name: "Creeping Toxin"
skill_order: 3
description:
  "Conjures a poison-attribute totem, which spreads a toxic pool. The pool is "
  "highly combustible, detonating in a massive explosion."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE
max_level: 20
max_enemies: 10
cast_interval_seconds: 1.0
base {
  skill_pct: 1.28
  normal_skill_pct: 0.50
}
per_level { skill_pct: 0.04 }
empowered_form {
  casts_per_trigger: 4
  lines: 4
  base {
    skill_pct: 1.62
    normal_skill_pct: 0.50
  }
  per_level { skill_pct: 0.02 }
}
