# Pure defense, 10 a point. GMS stops it at 9; one more point rounds the
# magician's book to the same 60 every other job pays.
# The wiki names Magic Guard Lv. 3 as a prerequisite. Nothing here gates one
# skill behind another, so saying it would only describe a rule we don't have.
name: "Magic Armor"
description: "Uses magic to increase DEF."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MAGICIAN skill_order: 3 }
max_level: 10
base {
  def: 10
}
per_level {
  def: 10
}
