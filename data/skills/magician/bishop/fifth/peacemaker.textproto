# GMS's "Max Contact Count: 6" limits how many party members the orb heals, not
# how often it hits; `mobCount` is the six enemies each beat reaches.
#
# The rate isn't published. The 350ms beat is GMS's `attackDelay`, and the count
# of three is the community DPM calculator's.
#
# The buff is final damage: Holy Light, 400021077, states it as `indieDamR`.
#
# The three beats land together: `cast_interval_ms` would repeat the whole
# swing, and this swing includes the light, so the light would burst three
# times.
name: "Peacemaker"
description:
  "Hurl the embodiment of divine power directly at your enemies. Upon contact "
  "the power both damages them and restores your HP. As it disappears the "
  "object transforms into Holy Light, attacking enemies nearby and granting a "
  "buff to party members."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_HOLY
placement { job_advancement: JOB_ADVANCEMENT_BISHOP_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
cooldown_seconds: 10.0
max_enemies: 6
lines: 4
casts: 3
base {
  skill_pct: 3.64
  hp_recover_pct: 0.45
}
per_level { skill_pct: 0.14 }
extra_hit {
  label: "Holy Light"
  max_enemies: 15
  lines: 12
  base { skill_pct: 3.64 }
  per_level { skill_pct: 0.14 }
}
buff {
  duration_seconds: 12.0
  base { final_dmg_pct: 0.172 }
  per_level { final_dmg_pct: 0.002 }
  ally_base { final_dmg_pct: 0.172 }
  ally_per_level { final_dmg_pct: 0.002 }
}
