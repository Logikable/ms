# GMS fully protects the party inside it, which is a 100% damage-taken reduction
# here. The Max HP-proportional half is dropped: nothing scales a hit by the
# player's HP.
name: "Smokescreen"
description:
  "Drop a Smokescreen near you. All party members within Smokescreen range "
  "will take no damage for the duration. In addition, enemies inside the "
  "Smokescreen will take more critical damage."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 6 }
max_level: 10
exceeds_master_level: true
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 30.0
  base {
    crit_dmg: 0.02
    damage_taken_pct: 1.00
  }
  per_level { crit_dmg: 0.02 }
  # None of the critical damage: it comes from the enemies inside and applies to
  # whoever attacks them.
  ally_base { damage_taken_pct: 1.00 }
}
