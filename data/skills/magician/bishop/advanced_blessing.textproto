# GMS climbs +10+x attack, +390+8x DEF and +250+25x to HP and MP over twenty
# levels. Here it has ten, covering the top half of that ladder (GMS's level 11
# to 20), so the maximum is GMS's own.
#
# It replaces Bless instead of stacking with it, which is what GMS means by "can
# be stacked with other buff skills, excluding Bless". Every lever starts above
# where Bless ends, and the replacement covers the whole party: a Cleric next to
# a Bishop stops casting.
name: "Advanced Blessing"
description:
  "Greatly increases nearby party members' Attack Power, Magic ATT, DEF, Max "
  "HP, and Max MP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 7 }
exclusive_group: "Blessing"
max_level: 10
exceeds_master_level: true
required_skill {
  skill_name: "Bless"
  level: 10
}
supersedes_skill_name: "Bless"
base {
  attack: 21
  magic_attack: 21
  def: 478
  max_hp: 525
  max_mp: 525
}
per_level {
  attack: 1
  magic_attack: 1
  def: 8
  max_hp: 25
  max_mp: 25
}
ally_base {
  attack: 21
  magic_attack: 21
  def: 478
  max_hp: 525
  max_mp: 525
}
ally_per_level {
  attack: 1
  magic_attack: 1
  def: 8
  max_hp: 25
  max_mp: 25
}
