# GMS writes it "Damage: +20%" -- the %Damage stat aimed at one swing, summing
# with what the character already pays rather than adding points to the
# skill's own multiplier.
name: "Gungnir's Descent - Reinforce"
description: "Increases Gungnir's Descent's damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Gungnir's Descent"
  effect { damage_pct: 0.20 }
}
