# Magic attack, final damage, and Buff Duration beside them. The last
# lengthens a buff and not the wait under it, which is what makes a percentage
# granting nothing on its own worth having. The V matrix stands outside it:
# GMS marks every node notIncBuffDuration.
#
# GMS pays 3+4*floor(x/5)% final damage, which is 11% at the master level.
# Walked here as L+1, so the ladder is even and the top is GMS's.
#
# GMS's knockback resistance is dropped -- nothing here knocks a character
# back.
name: "Buff Mastery"
description:
  "Permanently increases Magic ATT and Final Damage and increases the "
  "duration of all buffs on you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 9 }
max_level: 10
exceeds_master_level: true
base {
  magic_attack: 3
  final_dmg_pct: 0.02
  buff_duration_pct: 0.05
}
per_level {
  magic_attack: 3
  final_dmg_pct: 0.01
  buff_duration_pct: 0.05
}
