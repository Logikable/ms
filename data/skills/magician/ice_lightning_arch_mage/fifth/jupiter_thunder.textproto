# GMS's wording doesn't work read literally. The client holds 30 shocks (`x`) on
# a 330ms beat (`subTime`), each 391+16x on `mobCount 1`, and a separate skill
# for the current at 243+9x, `attackCount 4`, `mobCount 2`. `time 40000` is the
# orb's lifetime.
#
# The orb hops between enemies by position, which this game doesn't have, so it
# rides the front of the queue and moves on when that one dies.
#
# The four-second stun is ours: GMS states none, which means the client
# hardcodes one. It only decides how long the rest of the book gets the 12%
# afterwards.
name: "Jupiter Thunder"
description:
  "Launch orbs full of the thunder god's power directly at your enemies. "
  "The orb goes inside the enemy it touched to deal continuous shock damage. "
  "Enemies touched by the orb are stunned. An electric current flows around "
  "that enemy to attack others."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_LIGHTNING
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 810
cooldown_seconds: 120.0
cooldown_refund_seconds: 3.4
max_enemies: 1
lines: 8
freeze_lines_per_spend: 5
stun {
  duration_seconds: 4.0
  final_dmg_pct: 0.12
  lifted_tag: SKILL_TAG_LIGHTNING
}
casts: 30
cast_interval_ms: 330
base { skill_pct: 4.07 }
per_level { skill_pct: 0.16 }
extra_hit {
  label: "Electric Current"
  max_enemies: 2
  lines: 4
  base { skill_pct: 2.52 }
  per_level { skill_pct: 0.09 }
}
