# GMS's own figures: 245+8x% twice over 20 levels, on eight enemies. 870ms is
# the animation's own, from the frame data: a long wind-up for the branch's
# hardest swing.
#
# The fire tag matters. Ignite is the magician's Final Attack and only follows
# fire swings, so without the tag Ignite would stop working at this job.
name: "Explosion"
description: "Creates a fire-attribute explosion near you that hits nearby enemies."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_FIRE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 870
max_enemies: 8
lines: 2
base { skill_pct: 2.53 }
per_level { skill_pct: 0.08 }
