# GMS's ceil(level/2)% can't be expressed as base + per_level; level/2 is exact
# at even levels and half a point low at odd ones.
name: "Iron Body"
description:
  "Boosts DEF and Max HP, and decreases damage taken when hit by enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SWORDMAN skill_order: 2 }
max_level: 20
base {
  def: 10
  max_hp_pct: 0.01
  damage_taken_pct: 0.005
}
per_level {
  def: 10
  max_hp_pct: 0.01
  damage_taken_pct: 0.005
}
