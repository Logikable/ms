# The level-20 tiers differ, which only the client's formulas show: Brandish's
# node has `cr`, Intrepid Slash's `targetPlus_5th`. The node's description says
# "Max Targets" for both and is wrong.
name: "Brandish Boost"
description: "Strengthens Brandish and Intrepid Slash."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 13 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Brandish"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Brandish"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Brandish"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Intrepid Slash"
  effect { final_dmg_pct: 0.03 }
  effect_per_level { final_dmg_pct: 0.03 }
}
boost {
  skill_name: "Intrepid Slash"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Intrepid Slash"
  min_level: 40
  effect { ied_pct: 0.20 }
}
