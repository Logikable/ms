# Sudden Raid's burn takes the node's numbers with it: a burn is priced off the
# swing's own stat line, which the boost is already folded into.
name: "Death Star Boost"
description: "Strengthens Death Star and Sudden Raid."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 8 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Death Star"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Death Star"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Death Star"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Sudden Raid"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Sudden Raid"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Sudden Raid"
  min_level: 40
  effect { ied_pct: 0.20 }
}
