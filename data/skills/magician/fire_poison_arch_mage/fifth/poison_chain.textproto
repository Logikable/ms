# GMS's poison adds 60 points to the next explosion on anything that survives
# one, five deep (see `skill_pct_per_repeat`).
#
# GMS caps nine explosions per enemy and seventeen overall, within twenty
# seconds.
#
# GMS publishes no interval. Two seconds is ours: above 20/9 seconds the nine-
# explosion cap could never be reached on a boss.
#
# GMS's final explosion lands with the ninth (`final_repeat_strike`).
#
# The crystal and spreading are dropped, so a crowd is worth a bit more here.
#
# Not a burn: GMS says it doesn't trigger Elemental Drain, so it is a pulse, not
# a `dot`, and DoT Punisher and Fervent Drain don't count it.
name: "Poison Chain"
description:
  "Unleash a fatal poison on a chain of enemies. Poisoned enemies "
  "periodically release clouds of additional poison, damaging both "
  "themselves and other nearby enemies. Even if they survive the initial "
  "explosion, the poison effect stacks, raising the power of further "
  "explosions. Unaffected by attack reflection."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
cooldown_seconds: 25.0
max_enemies: 2
lines: 4
base { skill_pct: 2.60 }
per_level { skill_pct: 0.10 }
buff {
  duration_seconds: 20.0
  pulse {
    label: "Poison Explosion"
    cast_interval_seconds: 2.0
    lines: 5
    max_pulses: 9
    final_repeat_strike: true
    max_repeats: 5
    skill_pct_per_repeat: 0.31
    skill_pct_per_repeat_per_level: 0.01
    base { skill_pct: 1.56 }
    per_level { skill_pct: 0.06 }
  }
}
