# The wizard's own rhythm: an ice swing leaves a Freeze Stack for every line it
# lands, and a lightning swing spends one per line for the final damage they
# were worth. GMS's own numbers -- 1% of each per stack at master, over a pile
# five deep.
#
# The critical damage rides every swing, since a frozen enemy is frozen whichever
# element is hitting it. Only the final damage is bought with the stacks.
name: "Freezing Crush"
description:
  "Grants bonus Critical Damage when attacking Frozen enemies. Bonus "
  "increases per stack of skill. Using lightning-based attacks against Frozen "
  "targets consumes stacks and increases Final Damage for each stack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_WIZARD skill_order: 2 }
max_level: 10
freeze_stack_cap: 5
base {
  crit_dmg_per_freeze_stack: 0.001
  final_dmg_pct_per_freeze_stack: 0.001
}
per_level {
  crit_dmg_per_freeze_stack: 0.001
  final_dmg_pct_per_freeze_stack: 0.001
}
