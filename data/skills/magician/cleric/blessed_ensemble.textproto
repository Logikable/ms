# One level in GMS; ten here for both, so the book has a ladder.
#
# The EXP only goes to others: GMS says "your own effects do not apply to you".
# It stacks, since it pays for the company (see Skill.ally_effect_stacks).
name: "Blessed Ensemble"
description:
  "Blessings increase your Final Damage. Obtains additional EXP based on the "
  "number of Clerics, Priests, Bishops in the party. Your own effects do not "
  "apply to you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 2 }
max_level: 10
ally_effect_stacks: true
base { final_dmg_pct: 0.003 }
per_level { final_dmg_pct: 0.003 }
ally_base { exp_pct: 0.02 }
ally_per_level { exp_pct: 0.02 }
