name: EQUIP_SET_NAME_ROOT_ABYSS_MAGICIAN
# Four slots, all filled: the three armour pieces from Chaos Pierre, Von Bon and
# the Crimson Queen, and the weapon from Vellum. There is one file per branch
# because every piece belongs to one class: no one else wears the set a magician
# wears.
complete_pieces: 4
members {
  slot: EQUIP_SLOT_HAT
  items { name: "Royal Dunwitch Hat" }
}
members {
  slot: EQUIP_SLOT_TOP
  items { name: "Eagle Eye Dunwitch Robe" }
}
members {
  slot: EQUIP_SLOT_BOTTOM
  items { name: "Trixter Dunwitch Pants" }
}
# Named as a family: the branch's weapons are one piece with a version per job,
# and a player wears exactly one.
members {
  slot: EQUIP_SLOT_PRIMARY_WEAPON
  family: "Root Abyss Magician Weapon"
}
tiers {
  pieces: 2
  effect {
    int: 20
    luk: 20
    max_hp: 1000
    max_mp: 1000
  }
}
tiers {
  pieces: 3
  effect {
    max_hp_pct: 0.10
    max_mp_pct: 0.10
    magic_attack: 50
  }
}
tiers {
  pieces: 4
  effect {
    boss_pct: 0.30
  }
}
