# A held swing: an orb that zaps everything around it every 150ms while the key
# is held, then bursts. Twelve pulses take two full seconds; 960ms is the
# earliest it can be released, which fits five pulses and the burst.
#
# Fourteen enemies against GMS's fifteen, from a 500x400 sphere: seven across
# over two storeys. See Skill.max_enemies.
#
# It picks its fourteen targets when the hold starts and never again, so the
# fight holds it only while the pulses still have targets: against a boss that
# is the full two seconds, and on a map the minimum. See Channel.
#
# It is lightning, so it uses up the stacks an ice swing left and hits harder
# for each. GMS's line about attack reflection is dropped with everything else
# this game doesn't have.
name: "Lightning Orb"
description:
  "Creates a large, unstable sphere of electricity to continuously zap "
  "enemies."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_LIGHTNING
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 2 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 960
max_enemies: 14
lines: 15
cooldown_seconds: 60.0
base { skill_pct: 1.35 }
channel {
  pulse_interval_ms: 150
  max_pulses: 12
  finish_delay_ms: 200
  damage_taken_pct: 0.50
  finish {
    label: "Final Attack"
    lines: 15
    base { skill_pct: 7.02 }
  }
}
