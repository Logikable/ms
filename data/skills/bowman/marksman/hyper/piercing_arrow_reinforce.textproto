# Piercing Arrow is replaced long before 140, so its boost never applies. It is
# written because GMS writes it.
name: "Piercing Arrow - Reinforce"
description:
  "Increases damage of Piercing Arrow, Piercing Arrow II, Arrow Fragments, "
  "Empowered Piercing Arrow, and Empowered Piercing Arrow II."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 7 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Piercing Arrow"
  reach: BOOST_REACH_BOTH
  effect { damage_pct: 0.20 }
}
boost {
  skill_name: "Piercing Arrow II"
  reach: BOOST_REACH_BOTH
  effect { damage_pct: 0.20 }
}
