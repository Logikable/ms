# Reach cut from GMS's 8 to 5. Its hitbox is 415x200, one storey of a map
# fitting 5 monsters side by side, so 8 is a cap GMS never fills but this fight
# would always fill. See Skill.max_enemies.
#
# GMS silences what it hits and gives the hammer an element. Neither exists
# here, so only the hammer is left: 250 + 3L% four times.
#
# Uses Divine Swing's animation, the same hammer one tier down.
name: "Divine Charge"
description:
  "Instantly conjure a holy hammer that slams your enemies, inflicting "
  "damage."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
base_delay_ms: 660
max_enemies: 5
lines: 4
tags: SKILL_TAG_HOLY_POWER
base { skill_pct: 2.53 }
per_level { skill_pct: 0.03 }
