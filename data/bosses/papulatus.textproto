name: "Papulatus"
difficulties {
  # No Normal: GMS's Easy and Normal sit at 115 and 155, and both are behind
  # what a character already clears by the time this gate opens.
  name: "Chaos"
  # The robot, stationary in the middle of a room with a ledge over each side
  # of it. Three quarters of the fight is here.
  phases {
    bgm: "ClockTowerofNightmare"
    spawns {
      mob: "chaos_papulatus_clock"
      spots { x: 4 y: 4 }
    }
    # The floor under him, and a platform two off it at each end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 3 }
    player_spots { x: 6 y: 3 }
    arena_width: 9
    arena_height: 6
  }
  # The clock gone, the platforms with it, and the thing that was piloting it
  # loose in the room: it steps to a neighbouring cell twice a second, anywhere
  # the player cannot stand. The floor between their spots is fair game.
  phases {
    spawns {
      mob: "chaos_papulatus"
      spots { x: 4 y: 4 }
      walk { interval_ms: 500 range: RANGE_STEP }
    }
    # The floor alone. Nothing to climb now.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twenty minutes, which only Princess No and Chaos Vellum otherwise have.
  # GMS allows thirty; this is 504B behind 250% PDR, the largest body in the
  # game, and the clock is the wall.
  time_limit_seconds: 1200
  # The level cap, where everything until Seren opens.
  unlock_level: 200
  # Five Intense Power Crystals at what GMS prices this fight, divided by
  # seven: GMS clears Chaos once a week and this game once a day.
  meso: 18900000
  # GMS pays this on the body itself; here the clear pays it, flat and
  # untouched by any EXP bonus, as every other fight's is.
  exp: 1234200
  drops {
    equip: "papulatus_mark"
    per_kill: 1.0
  }
  drops {
    item: "papulatuss_soul_shard"
    per_kill: 1.0
  }
}
