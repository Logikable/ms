# Meso Explosion isn't a swing: the coins Pick Pocket drops ride the Shadower's
# own attack like a Final Attack. Everything the node gives applies to that
# strike, which is why the coins needed to carry a critical rate and final
# damage.
name: "Meso Explosion Boost"
description: "Strengthens Meso Explosion."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 6 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Meso Explosion"
  effect { final_dmg_pct: 0.03 }
  effect_per_level { final_dmg_pct: 0.03 }
}
boost {
  skill_name: "Meso Explosion"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Meso Explosion"
  min_level: 40
  effect { ied_pct: 0.20 }
}
