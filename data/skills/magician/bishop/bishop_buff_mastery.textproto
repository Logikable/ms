# Magic attack, final damage, and Buff Duration beside them. The last grants
# nothing today: no magician skill raises a buff with a duration to lengthen.
# It is written because the lever is what the class is for, and a page showing
# only the attack would be describing a different skill.
#
# GMS pays 3+4*floor(x/5)% final damage, which is 11% at the master level.
# Walked here as L+1, so the ladder is even and the top is GMS's.
#
# GMS's knockback resistance is dropped -- nothing here knocks a character
# back.
name: "Buff Mastery"
skill_order: 9
description:
  "Permanently increases your Magic ATT and Final Damage, and keeps every "
  "buff you raise standing for longer."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BISHOP
max_level: 10
exceeds_master_level: true
base {
  magic_attack: 3
  final_dmg_pct: 0.02
  buff_duration_pct: 0.05
}
per_level {
  magic_attack: 3
  final_dmg_pct: 0.01
  buff_duration_pct: 0.05
}
