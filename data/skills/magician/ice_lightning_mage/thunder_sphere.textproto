# GMS's non-boss bonus is a share of the character's damage, as its "(additive)"
# says.
#
# 1.8s is the orb's own attack animation, fifteen frames of 120ms; it strikes
# on its own `attackAfter` timing, like Phoenix.
name: "Thunder Sphere"
description:
  "Summon an orb of condensed lightning. The orb discharges a high-voltage "
  "current at nearby enemies to deal lightning-based damage."
kind: SKILL_KIND_AUTO_ATTACK
tags: SKILL_TAG_LIGHTNING
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_MAGE skill_order: 2 }
max_level: 20
max_enemies: 6
lines: 3
cast_interval_seconds: 1.8
base {
  skill_pct: 2.01
  normal_pct: 0.75
}
per_level {
  skill_pct: 0.05
  normal_pct: 0.05
}
