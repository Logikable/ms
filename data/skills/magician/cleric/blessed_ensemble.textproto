# One level in GMS, worth 3% final damage and 20% bonus EXP for every other
# Cleric in the party. Ten levels here for both, so the book has a ladder.
#
# The final damage is the Cleric's own, as in GMS. The EXP is not: GMS says
# "your own effects do not apply to you", so it only goes to others, and a
# Cleric hunting alone gets nothing from it. It stacks, since it pays for the
# company, not for a buff over the party. See Skill.ally_effect_stacks.
name: "Blessed Ensemble"
description:
  "Blessings increase your Final Damage. Obtains additional EXP based on the "
  "number of Clerics, Priests, Bishops in the party. Your own effects do not "
  "apply to you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 2 }
max_level: 10
ally_effect_stacks: true
base { final_dmg_pct: 0.003 }
per_level { final_dmg_pct: 0.003 }
ally_base { exp_pct: 0.02 }
ally_per_level { exp_pct: 0.02 }
