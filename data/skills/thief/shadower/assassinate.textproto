# A Shadower always has Murderous Intent, so the buff isn't modelled and its
# final damage is written on the blow, as GMS states it on the blow's own line.
#
# 1200ms covers both presses, 660 for the strike and 540 for the blow.
name: "Assassinate"
description:
  "Attack an enemy's vital points over and over to deal tremendous damage, "
  "then strike a finishing blow."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 1 }
max_level: 30
required_equip_type: EQUIP_TYPE_DAGGER
exceeds_master_level: true
base_delay_ms: 1200
max_enemies: 1
lines: 6
base { skill_pct: 1.83 }
per_level { skill_pct: 0.03 }
extra_hit {
  label: "Finishing Blow"
  lines: 6
  base {
    skill_pct: 3.45
    final_dmg_pct: 0.50
  }
  per_level { skill_pct: 0.05 }
}
