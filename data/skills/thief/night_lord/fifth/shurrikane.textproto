# The tooltip never gives the beat; the client's `subTime` is 180ms. The
# shuriken's 0.4s flight plus 2 seconds spinning land fourteen strikes.
#
# GMS cuts Assassin's Mark to 40% of its chance on this swing, which would
# otherwise roll it fourteen times a press.
#
# The recast that stops it in place needs a place, so it is dropped.
name: "Shurrikane"
description:
  "Throws a massive shuriken said to be used by the thieves of old. Reduced "
  "chance of activating Assassin's Mark."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
final_attack_label: "Assassin's Mark"
required_equip_type: EQUIP_TYPE_CLAW
base_delay_ms: 480
cooldown_seconds: 25.0
max_enemies: 6
lines: 7
casts: 14
cast_interval_ms: 180
base {
  skill_pct: 2.96
  final_attack_chance_cut: 0.60
}
per_level { skill_pct: 0.11 }
