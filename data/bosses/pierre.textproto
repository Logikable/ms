name: "Pierre"
difficulties {
  # No Normal: GMS fights Root Abyss only on Chaos.
  name: "Chaos"
  phases {
    bgm: "JoyfulTeaParty"
    spawns { mob: "chaos_pierre" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 900
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price, divided by seven, since GMS
  # clears Root Abyss once a week and this game once a day.
  meso: 11550000
  drops {
    item: "piece_of_mockery"
    per_kill: 1.0
  }
  drops {
    item: "pierres_soul_shard"
    per_kill: 1.0
  }
}
