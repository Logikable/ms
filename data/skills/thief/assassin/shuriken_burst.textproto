# GMS throws it in two parts, so the first throw is the lead hit (see
# lead_enemies in fight.h); one column would give bystanders the target's
# shuriken.
#
# Two enemies against GMS's six: the explosion's 200x220 box fits the target and
# one neighbour (see Skill.max_enemies).
name: "Shuriken Burst"
description:
  "Throw exploding shurikens that ricochet to nearby enemies on hit. "
  "Shurikens detonate when they hit their first enemy."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_ASSASSIN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_CLAW
base_delay_ms: 720
max_enemies: 2
lines: 6
lead_lines: 1
base {
  skill_pct: 0.48
  lead_pct: 4.08
}
per_level {
  skill_pct: 0.03
  lead_pct: 0.08
}
