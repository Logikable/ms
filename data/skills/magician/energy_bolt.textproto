# The magician's first attack, and a weak one: four bolts of 18+3x% make 84% on
# a single target at first, less than the basic attack, and 312% at max. It
# still wins from the first point on a crowded map, because it hits four; the
# basic attack only wins on the last mob. True to GMS, where a magician's damage
# comes with 2nd job.
name: "Energy Bolt"
description:
  "Fire a condensed energy bolt that explodes on contact with an enemy."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_MAGICIAN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
lines: 4
max_enemies: 4
base {
  skill_pct: 0.21
}
per_level {
  skill_pct: 0.03
}
