# Nothing here stays on the ground, so GMS's wall of fire becomes a Final Attack
# after the fire spell that lit it.
#
# Twelve hits, not three: the client's three are one burst, fired every 1.5
# seconds (`subTime`) for the 4+floor(x/4) seconds the wall lasts.
name: "Ignite"
description:
  "Grants Fire magic a chance to create a wall of fire at the target "
  "location."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 6 }
max_level: 10
final_attack_label: "Wall of Fire"
follows_skill_tag: SKILL_TAG_FIRE
base {
  final_attack_chance: 0.14
  final_attack_pct: 0.31
  final_attack_lines: 12
}
per_level {
  final_attack_chance: 0.04
  final_attack_pct: 0.01
}
