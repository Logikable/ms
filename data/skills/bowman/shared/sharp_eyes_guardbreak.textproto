# Party-wide because of the client: GMS stores this 5% in its own block with no
# psd flag or target skill, the shape of a value added to the Sharp Eyes buff,
# and that buff reaches the party.
name: "Sharp Eyes - Guardbreak"
description:
  "Grants Sharp Eyes a bonus to Enemy DEF Ignored. Applies to party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 5 }
hyper: true
required_level: 150
max_level: 1
base { ied_pct: 0.05 }
ally_base { ied_pct: 0.05 }
