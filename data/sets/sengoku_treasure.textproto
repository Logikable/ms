name: EQUIP_SET_NAME_SENGOKU_TREASURE
# Three slots, all filled the day Princess No opens: she drops the whole set in
# one clear, so this is the one set a player never has to collect.
complete_pieces: 3
members {
  slot: EQUIP_SLOT_RING
  items { name: "Kanna's Treasure" }
}
members {
  slot: EQUIP_SLOT_BELT
  items { name: "Ayame's Treasure" }
}
members {
  slot: EQUIP_SLOT_SHOULDER
  items { name: "Hayato's Treasure" }
}
tiers {
  pieces: 2
  effect {
    str: 2
    dex: 2
    int: 2
    luk: 2
    attack: 3
    magic_attack: 3
    def: 20
    damage_pct: 0.03
  }
}
# The ring and belt slots are free to spare; the shoulder is not, because the
# Boss Accessory Set wants that slot too. Wearing all three gives up that set's
# ninth piece for this one's %Damage.
tiers {
  pieces: 3
  effect {
    str: 8
    dex: 8
    int: 8
    luk: 8
    attack: 12
    magic_attack: 12
    def: 80
    damage_pct: 0.06
  }
}
