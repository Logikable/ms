# GMS's own summon: 90+2x% three times, and a burn of 50+3x% a second for two
# on whatever it touched. Twenty levels here against GMS's thirty, so both
# ladders are steeper and both end where GMS ends.
name: "Ifrit"
skill_order: 6
description:
  "Summon an ifrit to fight beside you. Its flames burn what they touch, and "
  "learning to call it permanently increases your Mastery."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Spell Mastery"
  level: 10
}
max_enemies: 3
lines: 3
cast_interval_seconds: 3.0
base {
  skill_pct: 0.93
  mastery: 0.51
}
per_level {
  skill_pct: 0.03
  mastery: 0.01
}
dot {
  base { skill_pct: 0.45 }
  per_level { skill_pct: 0.05 }
  interval_seconds: 1.0
  duration_seconds: 2.0
}
