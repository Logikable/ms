name: "Dominator Pendant"
required_level: 140
# GMS gives it MaxHP and MaxMP +10% on top of this. There is no percentage
# field on an equip, so the flat half of it is what a player gets.
base_stats {
  str: 20
  dex: 20
  int: 20
  luk: 20
  attack: 3
  magic_attack: 3
  def: 100
}
equip_job_categories: EQUIP_JOB_CATEGORY_UNIVERSAL
equip_slot: EQUIP_SLOT_PENDANT
upgrade_slots: 5
# Dropped by Arkarium, never stocked, at the rung his 180 gate puts it on.
# A boss accessory is priced by the earliest gate that drops it: 110 500k,
# 130 750k, 150 1M, 160 1.5M, 170 2M, 180 2.5M, 190 3M.
sell_price: 2500000
