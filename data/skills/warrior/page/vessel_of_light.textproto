# GMS gives all of this at once, and only while a Holy Power skill is in use.
# Here it is permanent and bought a twentieth at a time, ending exactly at GMS's
# single level. The HP recovery is left out, and so is the status resistance,
# since nothing in this game needs resisting.
name: "Vessel of Light"
description: "Amasses the power of light within you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PAGE skill_order: 2 }
max_level: 20
base {
  damage_pct: 0.005
  attack: 2
  damage_taken_pct: 0.005
  status_resistance: 0.5
}
per_level {
  damage_pct: 0.005
  attack: 2
  damage_taken_pct: 0.005
  status_resistance: 0.5
}
