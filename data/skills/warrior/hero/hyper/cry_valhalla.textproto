# A Hero at this level only uses Swordsmanship swings, so GMS's condition is
# always met and only the clock is left.
#
# Two seconds is an estimate: GMS says only "periodically". The twelve ticks
# were cut 16% for not fitting in thirty seconds; at two they finish with six to
# spare.
#
# Buff Duration is worth nothing here: twelve ticks are twelve ticks.
name: "Cry Valhalla"
description:
  "Calls upon the power of the ancients to defend you. Your "
  "Swordsmanship skills will periodically leave afterimages, which deal "
  "additional attacks to the enemy."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 30.0
  base {
    attack: 50
    crit_rate: 0.30
    status_resistance: 100
    elemental_resistance: 1.00
  }
  pulse {
    label: "Sword Strikes"
    cast_interval_seconds: 2.0
    lines: 2
    casts: 3
    max_enemies: 6
    max_pulses: 12
    base { skill_pct: 5.20 }
  }
}
