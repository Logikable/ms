# The orbs are taken as full: GMS builds them up over 40% of your swings, and
# a fight paid out in expected damage has nowhere to put a counter. Stated per
# orb rather than as the +10 it comes to, because a later skill raises the
# count and nothing else.
name: "Combo Attack"
description: "Grants a chance to add each attack to the Combo Orb."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 3 }
max_level: 1
combo_orbs: 5
base { attack_per_combo_orb: 2 }
