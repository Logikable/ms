# Advanced Final Attack reaches 60% at max level, so this takes it to 75%. A
# boost lever that never reaches a swing: it raises how often the extra hit
# lands, which belongs to the source, not the attack that triggered it.
name: "Advanced Final Attack - Opportunity"
description:
  "Increases the activation chance of Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 9 }
hyper: true
required_level: 180
max_level: 1
boost {
  skill_name: "Advanced Final Attack"
  effect { final_attack_chance: 0.15 }
}
