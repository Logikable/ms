# The one attack in the game that pays MORE against a boss, where every other
# bonus of the shape pays against ordinary monsters. It ships dead: no mob sets
# `boss`, so the 30% buys nothing today and the skill is tuned on the eight
# strikes across fifteen enemies, which is what it really does.
#
# Its wait is the first in the game to shorten as the skill is taught -- GMS's
# 30 - floor(L/2), walked as a line to the same 15 seconds at master level.
name: "Heaven's Hammer"
skill_order: 4
description:
  "Slam an enormous hammer into the ground, damaging everything around you. "
  "Strikes bosses harder still."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_PALADIN
max_level: 30
exceeds_master_level: true
base_delay_ms: 660
cooldown_seconds: 29.5
cooldown_seconds_per_level: -0.5
max_enemies: 15
lines: 8
base {
  skill_pct: 4.46
  boss_pct: 0.30
}
per_level { skill_pct: 0.06 }
