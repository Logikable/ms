# The duration is ours: GMS's fog lasts a few seconds and can be laid over
# itself, while here the mark stays on the monster, so the fog becomes a burn
# that is relit.
name: "Poison Mist"
description:
  "Creates a poisonous fog around you, dealing poison damage to all enemies "
  "nearby on its own."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 2 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
max_enemies: 6
base_delay_ms: 660
base { skill_pct: 1.94 }
per_level { skill_pct: 0.04 }
dot {
  interval_seconds: 1.0
  duration_seconds: 9.6
  duration_seconds_per_level: 0.6
  lines: 1
  base { skill_pct: 1.26 }
  per_level { skill_pct: 0.06 }
}
