module(name = "ms")

bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_cc", version = "0.0.9")

# Named so //tools:llvm_mingw.bzl can resolve the OS and CPU constraints it
# writes into the generated toolchain.
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Builds the two release zips under //release.
bazel_dep(name = "rules_pkg", version = "1.1.0")

# For //tools:embed_data, which compiles the game's data files into the binary.
# Already in the graph under protobuf; named here so it can be depended on.
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "ftxui", version = "6.1.9")

# Hermetic Clang/LLVM toolchain (replaces the system gcc).
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "19.1.0")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# Cross-compiles the Windows release from here. Only ever selected by a build
# that asks for the Windows platform; the toolchain above still owns Linux.
llvm_mingw = use_extension("//tools:llvm_mingw.bzl", "llvm_mingw")
use_repo(llvm_mingw, "llvm_mingw")

register_toolchains("@llvm_mingw//:toolchain")
