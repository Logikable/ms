# GMS names Final Attack, but Advanced Final Attack supersedes it, so the grant
# targets the skill that actually strikes. Cry Valhalla's reach is stated on its
# pulse, so it gets critical rate at 20.
name: "Cry Valhalla Boost"
description: "Strengthens Cry Valhalla, Puncture and Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 11 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Cry Valhalla"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Cry Valhalla"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Cry Valhalla"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Puncture"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Puncture"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Puncture"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Advanced Final Attack"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 40
  effect { ied_pct: 0.20 }
}
