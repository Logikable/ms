# Twenty levels instead of the other branches' ten, because the Page's book
# drops two skills this game has no use for and the points must go somewhere. So
# mastery climbs 2% a level from 12 and still reaches GMS's 50 at the top.
name: "Weapon Mastery"
description: "Increases Sword Mastery, Blunt Weapon Mastery, and Attack Speed."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PAGE skill_order: 4 }
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
base {
  mastery: 0.12
  attack_speed: 1
}
per_level { mastery: 0.02 }
