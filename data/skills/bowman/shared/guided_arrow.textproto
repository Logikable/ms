# A toggle in GMS with no cooldown, so really an attack on its own clock. GMS's
# `nbdR` is a share of the archer's damage, not points on the arrow.
#
# GMS hides its rate: the hidden half has 90 strikes over 60 seconds, and the
# user timed a video that agreed.
name: "Guided Arrow"
description: "Creates spirit arrows that pursue and attack nearby enemies."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_V skill_order: 12 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 6 }
v_node: V_NODE_KIND_ARCHETYPE
max_level: 30
max_enemies: 1
cast_interval_seconds: 0.66
base {
  skill_pct: 4.16
  normal_pct: 0.20
}
per_level { skill_pct: 0.16 }
