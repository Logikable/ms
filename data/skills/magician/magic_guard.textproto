# Sends 15+7x% of a hit to MP instead of HP. Nothing here tracks MP, so it
# counts as plain damage reduction alongside damage_taken_pct.
name: "Magic Guard"
description:
  "A portion of the damage dealt to you affects your MP instead of your HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MAGICIAN skill_order: 2 }
max_level: 10
base {
  damage_to_mp_pct: 0.22
}
per_level {
  damage_to_mp_pct: 0.07
}
