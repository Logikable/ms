# All eight bolts hit: GMS gives the wall two attack objects, one moving and one
# locked, each with the full `mobCount 12` and `attackCount 15`.
#
# `cast_interval_ms` is GMS's `subTime`, so each bolt hits what the one before
# left standing.
#
# The recast that locks the wall in place needs a place, so it is dropped.
name: "Bolt Barrage"
description:
  "Summons a wall of lightning that pulses forward, electrocuting enemies in "
  "its path."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_LIGHTNING
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
cooldown_seconds: 40.0
max_enemies: 12
lines: 15
casts: 8
cast_interval_ms: 210
base { skill_pct: 3.96 }
per_level { skill_pct: 0.16 }
