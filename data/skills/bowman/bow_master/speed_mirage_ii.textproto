# GMS lowers the strikes Speed Mirage needs from twelve to seven and raises the
# afterimages from three to four; our Speed Mirage is one rate, so this is
# written out as sixteen strikes every seven attacks.
#
# A boost, not a supersede: Speed Mirage's Wind Arrow bonus must keep paying.
name: "Speed Mirage II"
description: "Your continued archery training has empowered your Speed Mirage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 3 }
max_level: 20
exceeds_master_level: true
boost {
  skill_name: "Speed Mirage"
  lines: 12
  attacks_per_cast: 7
  effect { skill_pct: 0.82 }
  effect_per_level { skill_pct: 0.02 }
}
