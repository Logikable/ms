# Chance is 2*L%; damage is two hits of (60+L)%, told apart rather than folded
# so each rolls its own crit and mastery -- see SkillEffect::final_attack_lines.
#
# The extra hit lands on ONE of the enemies the swing reached, not on each
# of them: GMS's Final Attack carries no mobCount and no hitbox of its own,
# and its readout names the target it picks -- "attacks the boss with the
# highest HP first".
name: "Final Attack"
skill_order: 7
description:
  "Grants a chance to deliver an additional hit after a direct skill attack."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_SPEARMAN
final_attack_single_enemy: true
max_level: 20
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
required_skill {
  skill_name: "Weapon Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 0.61
  final_attack_lines: 2
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.01
}
