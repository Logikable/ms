# GMS's "increases stat bonuses as Maple Warrior by 400%" counts the base
# hundred, so 15% of pure stat becomes 60%, not 75%; this value is what is added
# to the hundred.
name: "Maple World Goddess's Blessing"
description:
  "The Maple World Goddess's Blessing increases all stats and damage. Can "
  "only be used when you have Maple Warrior."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 1 }
v_node: V_NODE_KIND_COMMON
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 60.0
  base {
    ap_stat_bonus_pct: 0.10
    damage_pct: 0.055
  }
  per_level {
    ap_stat_bonus_pct: 0.10
    damage_pct: 0.005
  }
}
