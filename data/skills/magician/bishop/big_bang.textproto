# The mobbing swing: four strikes on ten enemies, hitting anything that is not
# a boss for half again.
#
# GMS climbs 300+6x% over 30 levels. Twenty levels here keep GMS's step and
# its ceiling, so the ladder starts at what GMS reaches at 11 rather than at
# its own level 1 -- a skill this central is not worth 306% for a decade.
name: "Big Bang"
description: "Holy power spreads out, culminating in a holy explosion."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 2 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 10
lines: 4
base {
  skill_pct: 3.66
  normal_pct: 0.50
}
per_level { skill_pct: 0.06 }
