# GMS writes it "Damage: +20%": the %Damage stat for one swing, adding to what
# the character already has, not points on Raging Blow's multiplier. Both halves
# of the swing get it, since the two guaranteed criticals are the same swing.
name: "Raging Blow - Reinforce"
description:
  "Increases Raging Blow's damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Raging Blow"
  effect { damage_pct: 0.20 }
}
