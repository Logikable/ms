# GMS climbs ceil(L/4)% per orb, a staircase base + per_level can't follow.
# Straightened to a quarter of a percent a level, which ends where the staircase
# does: 5% an orb, 25% with all orbs.
#
# The orbs belong to Combo Attack: this skill sets their value but not their
# count, so raising the count later is one edit.
name: "Combo Synergy"
description: "Increases Final Damage for each Combo Orb."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 3 }
max_level: 20
base { final_dmg_pct_per_combo_orb: 0.0025 }
per_level { final_dmg_pct_per_combo_orb: 0.0025 }
