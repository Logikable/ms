name: "Pink Bean"
difficulties {
  name: "Normal"
  phases {
    bgm: "FightingPinkBeen"
    spawns { mob: "solomon_the_wise" spots { x: 0 y: 3 } }
    spawns { mob: "hugin" spots { x: 2 y: 3 } }
    spawns { mob: "ariel" spots { x: 4 y: 2 } }
    spawns { mob: "munin" spots { x: 6 y: 3 } }
    spawns { mob: "rex_the_wise" spots { x: 8 y: 3 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "pink_bean" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 600
  # At 170 the Shadower runs out of time and the Paladin and Bow Master finish
  # with seconds to spare; ten levels later every branch clears in under 7:20.
  unlock_level: 170
  # Five Intense Power Crystals at his level's price.
  meso: 7022500
  # The statues account for 3,300,000 of it and the bean 6,290,000.
  exp: 9590000
  drops {
    equip: "black_bean_mark"
    per_kill: 1.0
  }
  drops {
    equip: "golden_clover_belt"
    per_kill: 1.0
  }
  drops {
    equip: "pink_holy_cup"
    per_kill: 1.0
  }
  drops {
    item: "pink_beans_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Chaos"
  phases {
    bgm: "FightingPinkBeen"
    spawns { mob: "chaos_solomon_the_wise" spots { x: 0 y: 3 } }
    spawns { mob: "chaos_hugin" spots { x: 2 y: 3 } }
    spawns { mob: "chaos_ariel" spots { x: 4 y: 2 } }
    spawns { mob: "chaos_munin" spots { x: 6 y: 3 } }
    spawns { mob: "chaos_rex_the_wise" spots { x: 8 y: 3 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "chaos_pink_bean" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 900
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price, divided by seven, since GMS
  # clears him once a week and this game once a day.
  meso: 9150000
  # GMS gives the Chaos bean the same EXP as the Normal one.
  exp: 9590000
  # Normal's drops. Chaos adds nothing of its own in GMS either.
  drops {
    equip: "black_bean_mark"
    per_kill: 1.0
  }
  drops {
    equip: "golden_clover_belt"
    per_kill: 1.0
  }
  drops {
    equip: "pink_holy_cup"
    per_kill: 1.0
  }
  drops {
    item: "pink_beans_soul_shard"
    per_kill: 1.0
  }
}
