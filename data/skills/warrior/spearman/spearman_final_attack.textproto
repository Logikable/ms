# Two hits kept separate, each rolling its own crit and mastery (see
# SkillEffect.final_attack_lines).
#
# The extra hit lands on one enemy: GMS's Final Attack has no mobCount of its
# own and its text says "attacks the boss with the highest HP first".
name: "Final Attack"
description:
  "Grants a chance to deliver an additional hit after a direct skill attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 7 }
final_attack_max_enemies: 1
max_level: 20
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
required_skill {
  skill_name: "Weapon Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 0.61
  final_attack_lines: 2
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.01
}
