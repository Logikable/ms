# The first share ever taken off another skill's wait -- see
# SkillBoost::cooldown_pct. Heaven's Hammer walks 29.5 seconds down to 15 as it
# is taught, and the cut is 30% of wherever it stands, so a maxed hammer comes
# back in 10.5.
name: "Heaven's Hammer - Cooldown Cutter"
skill_order: 11
description:
  "Reduces the cooldown of Heaven's Hammer."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_PALADIN
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Heaven's Hammer"
  cooldown_pct: 0.30
}
