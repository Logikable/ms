# The summon, and the book's mastery in one. Three strikes on three enemies
# every three seconds -- 3030ms in the client, and the same clock Ifrit and
# Bahamut run on.
#
# It freezes what it touches, which GMS says in as many words and which is what
# keeps a boss frozen the whole fight: three seconds between pulses against
# eight seconds of ice. GMS states no duration for it, so it takes the family's.
#
# Its 70% mastery over the magician's own 25% reaches 95%, which is where
# every 4th job mastery lands. Spell Mastery keeps its page and stops paying:
# a character holds the better of two masteries, never their sum.
name: "Elquines"
skill_order: 5
description:
  "Summon Elquines. Elquines can attack multiple enemies at once. Attacks "
  "from Elquines freeze enemies. Permanently increases Spell Mastery."
kind: SKILL_KIND_AUTO_ATTACK
tags: SKILL_TAG_ICE
freeze_seconds: 8.0
job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Spell Mastery"
  level: 10
}
max_enemies: 3
lines: 3
cast_interval_seconds: 3.0
base {
  skill_pct: 0.70
  mastery: 0.51
}
per_level {
  skill_pct: 0.03
  mastery: 0.01
}
