# GMS maxes this at 14; the same tops over 20 levels step evenly.
#
# Nothing here casts one skill into another, so every fourth tick is the
# detonation instead: an empowered form naming no skill, since it upgrades
# itself.
name: "Creeping Toxin"
description:
  "Conjures a poison-attribute totem, which spreads a toxic pool. The pool is "
  "highly combustible, detonating in a massive explosion."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 3 }
max_level: 20
max_enemies: 10
cast_interval_seconds: 1.0
base {
  skill_pct: 1.28
  normal_pct: 0.50
}
per_level { skill_pct: 0.04 }
empowered_form {
  casts_per_trigger: 4
  lines: 4
  base {
    skill_pct: 1.62
    normal_pct: 0.50
  }
  per_level { skill_pct: 0.02 }
}
