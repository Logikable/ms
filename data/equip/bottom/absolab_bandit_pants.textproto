# The AbsoLab bottom for this branch, bought with the coins Damien and Lotus
# drop. One of four, since each class wears its own piece, so the set is defined
# four times rather than once around a universal item.
#
# GMS has the top and bottom as one overall. They are split here because the
# two slots are separate; together they add up to the overall's stats.
name: "AbsoLab Bandit Pants"
required_level: 160
base_stats {
  dex: 30
  luk: 30
  attack: 2
  def: 120
}
equip_job_categories: EQUIP_JOB_CATEGORY_THIEF
equip_slot: EQUIP_SLOT_BOTTOM
upgrade_slots: 7
token_item: "absolab_coin"
token_price: 2
