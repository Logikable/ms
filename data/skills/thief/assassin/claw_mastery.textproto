# The mastery skill, over 20 levels instead of GMS's 10 so the book costs the 90
# SP the Assassin's levels give. Mastery goes from 12% to 50%, the same climb as
# every other 20-level mastery.
#
# GMS also raises how many throwing stars a claw holds. Stars here are an
# equipped item that never runs out, so there is no count to raise.
name: "Claw Mastery"
description: "Increases Claw Mastery."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ASSASSIN skill_order: 3 }
max_level: 20
required_equip_type: EQUIP_TYPE_CLAW
base { mastery: 0.12 }
per_level { mastery: 0.02 }
