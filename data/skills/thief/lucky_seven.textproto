# Three stars of 70+2x%: 216% per target at level 1 and 330% at max, even with
# Double Stab there and ahead of it at every level before. GMS gives 65+3x over
# 15 levels; the max stays at 110% a star. Claw only, and the claw is what makes
# the two differ: equipped throwing stars add their attack to a claw's swing and
# nothing else.
#
# "7 lucky throwing stars" is the skill's own boast, not a count: GMS throws
# three and always has. Kept as the wiki words it, because the name is built on
# the seven.
#
# Four enemies against GMS's five, from a 310x150 box: the same cut as Double
# Stab, for the same reason. See Skill.max_enemies.
name: "Lucky Seven"
description: "Throw lucky throwing stars to attack enemies in front."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_ROGUE skill_order: 2 }
max_level: 20
base_delay_ms: 690
lines: 3
max_enemies: 4
required_equip_type: EQUIP_TYPE_CLAW
base {
  skill_pct: 0.72
}
per_level {
  skill_pct: 0.02
}
