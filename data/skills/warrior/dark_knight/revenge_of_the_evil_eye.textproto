# Three attacks out of one row in the book. The Evil Eye counterattacks as the
# player swings -- once every 5 seconds, which for a character who never stops
# attacking is simply its own clock -- and Evil Eye Shock III lands a volley
# every 10 seconds with four auras of darkness behind it.
#
# Shock III is the top of the one shout, so this supersedes Evil Eye Shock II,
# which already supersedes the first. GMS states it as a permanent damage
# increase to Evil Eye Shock, and the clock it takes over shortens from 12
# seconds to 10.
#
# The auras reach 3 enemies where the volley reaches 10, so they cannot be one
# attack: four auras of five strikes are 20 lines on the three.
#
# The aura heal is restated for the reason Evil Eye Shock II restates it: this
# supersedes that, and the eye heals whatever it is shouting.
name: "Revenge of the Evil Eye"
description:
  "An Evil Eye counterattacks the enemy. Your deepened connection with the "
  "Evil Eye enhances Evil Eye Shock."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 6 }
max_level: 30
exceeds_master_level: true
supersedes_skill_name: "Evil Eye Shock II"
required_skill {
  skill_name: "Evil Eye Shock II"
  level: 20
}
max_enemies: 10
lines: 7
cast_interval_seconds: 5.0
base {
  skill_pct: 1.35
  regen_hp: 24
  regen_interval_seconds: 24.0
}
per_level { skill_pct: 0.06 }
auto_mode {
  label: "Shock III"
  cast_interval_seconds: 10.0
  max_enemies: 10
  lines: 7
  base { skill_pct: 3.40 }
  per_level { skill_pct: 0.10 }
}
auto_mode {
  label: "Dark Auras"
  cast_interval_seconds: 10.0
  max_enemies: 3
  lines: 20
  base { skill_pct: 2.20 }
  per_level { skill_pct: 0.07 }
}
