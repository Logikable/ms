# `base 1, per_level 0.2` is rounded down when read, which gives exactly GMS's
# ceil(L/5).
name: "Decent Mystic Door"
description:
  "Opens a portal to the nearest town. Nobody here remembers what it was for."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 11 }
v_node: V_NODE_KIND_COMMON
max_level: 30
base {
  str: 1
  dex: 1
  int: 1
  luk: 1
}
per_level {
  str: 0.2
  dex: 0.2
  int: 0.2
  luk: 0.2
}
