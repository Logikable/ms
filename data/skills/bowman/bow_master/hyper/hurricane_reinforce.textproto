# Two boosts because GMS names two skills: the client targets Hurricane, Arrow
# Blaster and the turret it leaves. The second boost covers both halves of Arrow
# Blaster, because the turret carries its parent's name and boosts are keyed by
# name.
name: "Hurricane - Reinforce"
description:
  "Increases damage for Hurricane, Arrow Blaster, and installed Arrow "
  "Blaster."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Hurricane"
  effect { damage_pct: 0.30 }
}
boost {
  skill_name: "Arrow Blaster"
  effect { damage_pct: 0.30 }
}
