# GMS's own figures: 200+8x% on three enemies. The summon's duration is
# dropped, as every duration here is -- the shuriken simply always hangs there.
#
# 900ms between pulses is the skill's own `subTime`, and dpm_calc counted 62
# strikes over its 60 seconds, which agrees within a frame. Nothing in the
# shuriken's animation sets a cadence -- that clock is the server's.
name: "Dark Flare"
skill_order: 3
description:
  "Release dark energy to summon a large shuriken that attacks enemies "
  "nearby."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_HERMIT
max_level: 20
max_enemies: 3
cast_interval_seconds: 0.9
base { skill_pct: 2.08 }
per_level { skill_pct: 0.08 }
