# GMS maxes this at 30 with 10% final damage an orb, ten orbs and 70% mastery.
# Scaled to 20 levels ending at exactly those three: it is the job's mastery
# skill, and 20 is what the book has room for. Mastery climbs from 51% to 70%,
# like every 4th job mastery skill.
#
# The orb rate is written as 5/19: five orbs over the nineteen levels after
# level 1, so the tenth arrives at max level and the two extra levels from
# Combat Orders don't buy an eleventh.
#
# It supersedes Combo Synergy, whose only grant is the per-orb final damage this
# restates. It does not supersede Combo Attack: the largest orb count is used,
# not the sum, so the Fighter's 2 ATT per orb keeps paying, now for ten orbs.
name: "Advanced Combo"
description:
  "Increases the Final Damage dealt per Combo Orb and enables you to gain "
  "more orbs. Additionally increases mastery."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 4 }
max_level: 20
exceeds_master_level: true
supersedes_skill_name: "Combo Synergy"
combo_orbs: 5
combo_orbs_per_level: 0.26316
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_skill {
  skill_name: "Weapon Mastery"
  level: 10
}
base {
  final_dmg_pct_per_combo_orb: 0.062
  mastery: 0.51
}
per_level {
  final_dmg_pct_per_combo_orb: 0.002
  mastery: 0.01
}
