# GMS counts the Ranger's hits and gives a window when the count is reached: "if
# the direct skill attacks hit 30 times, damage increases by 3L+5% for 5 sec."
# Hits are lines, so a fast multi-line swing keeps it up and a slow one barely
# triggers it.
#
# Nothing counts while the window is up, so its uptime is capped however fast
# the character attacks: five seconds out of five plus the time thirty more
# lines take.
name: "Mortal Blow"
description:
  "If the attack hits a certain number of times, the damage increases."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 5 }
max_level: 10
buff {
  base { damage_pct: 0.08 }
  per_level { damage_pct: 0.03 }
  duration_seconds: 5.0
  charge_lines: 30
}
