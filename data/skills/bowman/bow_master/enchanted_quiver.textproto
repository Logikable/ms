# GMS states the whole arrowhead, not an increase over the Hunter's, so this
# supersedes Quiver Cartridge instead of stacking with it. Level 1 already beats
# that skill's best (33% vs 30%, 224% vs 220%), so buying it is never a step
# back.
#
# The arrow chases one enemy, like Quiver Cartridge's.
#
# The blood arrowhead is left out. It heals part of the HP pool on a chance,
# which the Berserker's lever already does, and in GMS the two arrowheads are
# alternatives, not a pair.
name: "Enchanted Quiver"
description:
  "Equips specialized arrowheads. Also permanently increases Final Damage."
kind: SKILL_KIND_PASSIVE
final_attack_max_enemies: 1
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 4 }
max_level: 10
final_attack_label: "Magic Arrow"
supersedes_skill_name: "Quiver Cartridge"
base {
  final_attack_chance: 0.33
  final_attack_pct: 2.24
  final_dmg_pct: 0.015
}
per_level {
  final_attack_chance: 0.03
  final_attack_pct: 0.04
  final_dmg_pct: 0.005
}
