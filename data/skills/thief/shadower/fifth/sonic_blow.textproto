# Fifteen attacks, though `updatableTime 2000` over `attackDelay 100` gives
# twenty: at twenty, GMS's 3.3-second refund per unused attack would make a
# cancelled cast refund more than the 60-second cooldown.
#
# It always runs to its last attack: GMS's reason to release early is the
# refund, which isn't modelled.
name: "Sonic Blow"
description:
  "Move faster than the speed of sound, dealing consecutive attacks along the "
  "way. You take less damage for as long as the attack runs."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 600
cooldown_seconds: 60.0
max_enemies: 8
lines: 7
base {
  skill_pct: 6.87
  ied_pct: 1.00
}
per_level { skill_pct: 0.27 }
channel {
  pulse_interval_ms: 100
  max_pulses: 15
  finish_delay_ms: 360
  damage_taken_pct: 0.50
}
