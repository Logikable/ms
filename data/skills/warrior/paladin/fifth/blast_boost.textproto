# GMS names two boosts over one swing here -- Blast's own, and Divine
# Judgment's for the Divine Brand it detonates. Divine Judgment is not a swing
# in this game but Blast's empowered form, so both land on Blast and the reach
# on each says which of the two it is: the enemy is the swing's, the critical
# rate the brand's.
name: "Blast Boost"
description: "Strengthens Blast and the Divine Brand it detonates."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 4 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Blast"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Blast"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Blast"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Blast"
  reach: BOOST_REACH_EMPOWERED
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Blast"
  reach: BOOST_REACH_EMPOWERED
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Blast"
  reach: BOOST_REACH_EMPOWERED
  min_level: 40
  effect { ied_pct: 0.20 }
}
