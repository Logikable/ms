# GMS gives 5x% HP and 6+6x resistance over 4 levels. Five levels here, at 4%
# HP and 5 resistance apiece, which ends near GMS's ceiling for a point more.
#
# Both resistances ship dead, as every resistance here does: nothing inflicts a
# status or an element.
name: "Enveloping Darkness"
description:
  "Cloaks yourself in darkness, increasing Max HP, Abnormal Status Resistance "
  "and Elemental Resistance permanently."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERMIT skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 9 }
max_level: 5
base {
  max_hp_pct: 0.04
  status_resistance: 10
  elemental_resistance: 0.10
}
per_level {
  max_hp_pct: 0.04
  status_resistance: 5
  elemental_resistance: 0.05
}
