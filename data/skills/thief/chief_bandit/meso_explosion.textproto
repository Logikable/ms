# GMS's own figures: 40+3x% twice per meso per enemy. It throws the mesos Pick
# Pocket drops on the ground, never the ones in the purse, so it costs the
# character only coins they wouldn't have picked up.
#
# A passive here, because there is no ground and no mesos to walk over: every
# meso that drops is thrown at once. For the same reason GMS's cap of 15 on the
# ground has nothing to cap.
#
# GMS's normal-enemy bonus is POINTS on a line, not a share: 2+floor(x/6)%,
# which is 5 at max and 10 on a two-line meso. Stepped evenly to that top, so
# only the start moves.
name: "Meso Explosion"
description: "Fling Mesos, dropped by Pick Pocket, to damage enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 2 }
max_level: 20
lines: 2
required_skill { skill_name: "Pick Pocket" level: 1 }
base {
  meso_hit_pct: 0.43
  normal_skill_pct: 0.012
}
per_level {
  meso_hit_pct: 0.03
  normal_skill_pct: 0.002
}
