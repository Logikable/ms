# GMS gives 65+3x over 15 levels; the max stays at 110% a star.
#
# "7 lucky throwing stars" is the skill's boast: GMS throws three. Kept as the
# wiki words it, because the name is built on the seven.
#
# Four enemies against GMS's five: the 310x150 box fits four across (see
# Skill.max_enemies).
name: "Lucky Seven"
description: "Throw lucky throwing stars to attack enemies in front."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_ROGUE skill_order: 2 }
max_level: 20
base_delay_ms: 690
lines: 3
max_enemies: 4
required_equip_type: EQUIP_TYPE_CLAW
base {
  skill_pct: 0.72
}
per_level {
  skill_pct: 0.02
}
