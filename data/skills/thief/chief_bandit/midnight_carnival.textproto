# GMS gives this 150+2x% four times on eight enemies, and Phase Dash 320+5x%
# twice on the same eight: 760% against 840% at max, with a swing 270ms shorter.
# Phase Dash is simply better, and two buttons where one is always worse isn't a
# choice.
#
# So here they are one skill: Midnight Carnival's four lines with Phase Dash's
# total. 750ms is Midnight Carnival's own, from the frame data.
#
# Five enemies against GMS's eight: 360x210 is one storey and fits five across.
# Phase Dash's own 380x125 gives the same five. See Skill.max_enemies.
name: "Midnight Carnival"
description: "Overwhelm enemies with supersonic slashes."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 750
max_enemies: 5
lines: 4
base { skill_pct: 1.72 }
per_level { skill_pct: 0.02 }
