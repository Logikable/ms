# The first bow arrow. An arrow has far less attack than the throwing star of
# the same tier, since a claw is nothing without what it throws, while a bow
# already hits harder on its own.
name: "Bronze Arrow for Bow"
required_level: 10
base_stats {
  attack: 1
}
equip_type: EQUIP_TYPE_ARROW_FOR_BOW
equip_job_categories: EQUIP_JOB_CATEGORY_BOWMAN
equip_slot: EQUIP_SLOT_PROJECTILE
unsupported_upgrades: UPGRADE_SCROLL
unsupported_upgrades: UPGRADE_STAR_FORCE
shop_price: 5000
