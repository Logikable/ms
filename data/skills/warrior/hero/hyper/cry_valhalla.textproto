# In GMS the strikes come with the Hero's Swordsmanship swings. A Hero at this
# level uses Raging Blow or Puncture, both tagged that way, so the condition is
# always met and only the clock is left.
#
# Two seconds is an estimate: GMS says only "periodically", and the client keeps
# the interval where the data doesn't reach. It must be close to this: the
# twelve ticks were cut 16% for not fitting in the thirty seconds, and at two
# seconds they finish with six to spare.
#
# What the cap really means is that Buff Duration is worth nothing here. Twelve
# ticks are twelve ticks however long the window lasts.
#
# GMS also fills the orbs on cast and prevents knockback. Orbs are always full
# here and nothing knocks the player back, so neither is written.
name: "Cry Valhalla"
description:
  "Calls upon the power of the ancients to defend you. Your "
  "Swordsmanship skills will periodically leave afterimages, which deal "
  "additional attacks to the enemy."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 30.0
  base {
    attack: 50
    crit_rate: 0.30
    status_resistance: 100
    elemental_resistance: 1.00
  }
  pulse {
    label: "Sword Strikes"
    cast_interval_seconds: 2.0
    lines: 2
    casts: 3
    max_enemies: 6
    max_pulses: 12
    base { skill_pct: 5.20 }
  }
}
