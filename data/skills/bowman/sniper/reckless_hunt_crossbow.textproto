# GMS sells avoidability here without saying how much, and it is the avoid stat,
# not the roll dodge_chance models, so this gives DEF instead.
name: "Reckless Hunt: Crossbow"
description: "Reduces DEF and instead increases Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SNIPER skill_order: 4 }
max_level: 10
required_equip_type: EQUIP_TYPE_CROSSBOW
base { def_pct: -0.07 crit_dmg: 0.11 }
per_level { def_pct: -0.02 crit_dmg: 0.01 }
