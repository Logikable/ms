name: "Hilla"
difficulties {
  name: "Normal"
  # One phase, one monster: she stands alone in the middle of the arena with the
  # player below her, and there is nothing else to kill.
  phases {
    bgm: "RedWitch"
    spawns { mob: "hilla" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  unlock_level: 130
  # GMS pays this as Intense Power Crystals, a drop nobody keeps, like the meso
  # that stands in for Zakum's: five of them at her level's price.
  meso: 4000000
  # Paid for the clear, flat and unaffected by EXP bonuses, like Zakum's and
  # Horntail's.
  exp: 5820000
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "stone_of_eternal_life"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  # The same single fight at GMS's Hard numbers, and the only body in the game
  # behind 100% PDR.
  phases {
    bgm: "RedWitch"
    spawns { mob: "hard_hilla" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twice what Normal allows, like every fight past the level-160 gate.
  time_limit_seconds: 600
  unlock_level: 190
  # Five Intense Power Crystals at her level's price, like every boss's meso,
  # divided by seven because GMS prices hers as a weekly clear and here she is
  # fought once a day.
  meso: 8050000
  # Paid for the clear, flat and unaffected by EXP bonuses.
  exp: 20400000
  drops {
    equip: "will_o_the_wisps"
    per_kill: 1.0
  }
  # The same shard Normal drops: a soul belongs to the boss, not to the
  # difficulty the player chose.
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
}
