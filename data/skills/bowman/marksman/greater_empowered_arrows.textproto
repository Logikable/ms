# GMS states each form's damage on this skill's page, which is why both ladders
# climb with this one.
#
# The Marked Target buff is folded into the passive: 4+8% final damage, and 13%
# Ignore DEF combined with 20% for 30.4%.
#
# Empowered Snipe's Ignore DEF climbs to the 25% Snipe reaches. Copying Snipe's
# thirty-level GMS ladder onto twenty levels made it ignore less than Snipe.
name: "Greater Empowered Arrows"
description:
  "Enhances the strength of your Empowered Arrows. Empowered Piercing Arrow "
  "is enhanced to Empowered Piercing Arrow II, and Empowered Arrows can also "
  "be used during Snipe. Permanently increases Final Damage and Ignore "
  "Defense."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 3 }
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Empowered Arrows"
  level: 10
}
base {
  final_dmg_pct: 0.006
  ied_pct: 0.019
}
per_level {
  final_dmg_pct: 0.006
  ied_pct: 0.015
}
empowered_form {
  skill_name: "Piercing Arrow II"
  casts_per_trigger: 4
  max_enemies: 10
  lines: 6
  base { skill_pct: 3.51 }
  per_level { skill_pct: 0.04 }
  extra_hit {
    label: "Fragment"
    lines: 10
    base { skill_pct: 2.42 }
    per_level { skill_pct: 0.02 }
  }
}
empowered_form {
  skill_name: "Snipe"
  casts_per_trigger: 4
  max_enemies: 1
  lines: 10
  base {
    skill_pct: 3.80
    ied_pct: 0.06
    crit_rate: 1.0
  }
  per_level {
    skill_pct: 0.06
    ied_pct: 0.01
  }
  extra_hit {
    label: "Mark"
    lines: 5
    base { skill_pct: 2.20 }
    per_level { skill_pct: 0.04 }
  }
}
