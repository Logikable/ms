# GMS's own figures: +50 attack, and a bleed on everything the Night Lord hits
# for 2000% a second over three seconds. A passive instead of GMS's 90-second
# buff, at the user's request: the coating is on the stars, so everything the
# stars hit gets it.
#
# The burn always applies and doesn't stack, so a second swing refreshes the
# mark instead of adding one: it is worth 2000% a second for as long as the
# Night Lord keeps attacking.
name: "Bleed Dart"
description:
  "Coats your stars with a deadly poison that causes bleeding, increasing "
  "Attack Power and inflicting continuous damage on enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base { attack: 50 }
dot {
  interval_seconds: 1.0
  duration_seconds: 3.0
  lines: 1
  base { skill_pct: 20.0 }
}
