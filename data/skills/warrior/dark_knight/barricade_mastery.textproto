# GMS caps this at 30 and ends at 70% mastery, 30 attack and 15% critical
# damage. Scaled to 20 levels to exactly those three, so the book totals 200 --
# the levels are coarser, the skill is no stronger. Mastery climbs 51% to 70%,
# the ladder every 4th job mastery skill takes. Attack starts at 11 rather than
# GMS's 10 because it is a whole number and has to reach 30 in twenty steps.
name: "Barricade Mastery"
skill_order: 7
description:
  "Improves Spear and Polearm Mastery to their human limits, and increases "
  "Attack Power and Critical Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT
max_level: 20
exceeds_master_level: true
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
required_skill {
  skill_name: "Weapon Mastery"
  level: 10
}
base {
  mastery: 0.51
  attack: 11
  crit_dmg: 0.055
}
per_level {
  mastery: 0.01
  attack: 1
  crit_dmg: 0.005
}
