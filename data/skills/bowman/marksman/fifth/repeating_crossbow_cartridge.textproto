# A magazine, not a swing: the cast loads eight cartridges and each press of
# Full Burst Shot uses one, which is what Buff.magazine is for. The other option
# was one 5,940ms swing for the whole burst: eight animations in a row would
# show as a six-second cast, and Split Shot would trigger once instead of GMS's
# eight.
#
# Single target on purpose: GMS gives the shot mobCount 1 and aims it at the
# highest Max HP in range, which is what the fight already does for a swing that
# hits one. The 790x290 box is where the arrows fly, not a crowd they hit.
#
# The group belongs to the skill, not the magazine: it is one button, so Split
# Shot follows it the same way either way.
name: "Repeating Crossbow Cartridge"
description:
  "Load a special cartridge that fires several arrows at once. Full Burst Shot "
  "seeks the enemy in range with the most health, striking the sturdiest part "
  "of a boss first."
kind: SKILL_KIND_ACTIVE
tags: SKILL_TAG_MARKSMANSHIP
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_CROSSBOW
base_delay_ms: 660
cooldown_seconds: 120.0
buff {
  duration_seconds: 60.0
  magazine {
    label: "Full Burst Shot"
    charges: 8
    base_delay_ms: 660
    max_enemies: 1
    lines: 9
    casts: 4
    base {
      skill_pct: 5.20
      ied_pct: 0.25
      crit_rate: 1.0
    }
    per_level { skill_pct: 0.20 }
  }
}
