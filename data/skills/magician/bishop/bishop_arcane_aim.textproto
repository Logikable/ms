# GMS stacks this five times off a 95% chance a hit, which at that rate is a
# character who is simply always at five. The steady state is written flat:
# 40% of damage at the top, in twenty levels rather than GMS's thirty.
#
# The ignored defence beside it cancels nothing yet -- no mob in the game
# carries any.
name: "Arcane Aim"
skill_order: 10
description:
  "Taking careful aim permanently increases your Damage and ignores a portion "
  "of enemy DEF."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BISHOP
max_level: 20
exceeds_master_level: true
base {
  damage_pct: 0.02
  ied_pct: 0.01
}
per_level {
  damage_pct: 0.02
  ied_pct: 0.01
}
