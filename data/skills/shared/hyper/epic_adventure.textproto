# Every Explorer has this, and no two stack: one buff covers the party however
# many cast it, so a party takes turns, and each player's own cooldown doesn't
# matter. That is Buff.party_shared, and it is why none of this uses ally_base:
# a partner's cast covers this character because they have the skill themselves,
# which is all of the faction rule GMS states.
#
# GMS removed this skill's cast action entirely, so the frame data has no entry
# for it. It costs what casting any buff costs: the 120ms a skill sequence paces
# its skills at.
name: "Epic Adventure"
description:
  "Call upon the bravery deep within to increase damage output. Applies to "
  "any Explorer class in the party."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 12 }
hyper: true
required_level: 190
max_level: 1
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 60.0
  party_shared: true
  base { damage_pct: 0.10 }
}
