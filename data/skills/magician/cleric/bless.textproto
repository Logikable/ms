# A party buff on a timer in GMS, at 5+x attack, 5+x magic attack and 30x
# DEF. Nothing runs out here, so it simply stands -- over the Cleric and over
# everybody beside them, which is who GMS casts it on.
#
# This is the Cleric's whole magic attack: they have no Meditation, so where
# the other wizards end on +30 this ends on +15. The attack is granted as well
# because GMS grants it, though a magician swings on the other number.
name: "Bless"
skill_order: 4
description:
  "Increases the Attack Power, Magic ATT, and Defense of you and nearby party "
  "members."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_CLERIC
exclusive_group: "Blessing"
max_level: 10
required_skill {
  skill_name: "Invincible"
  level: 5
}
base {
  attack: 6
  magic_attack: 6
  def: 30
}
per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
ally_base {
  attack: 6
  magic_attack: 6
  def: 30
}
ally_per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
