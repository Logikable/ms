# GMS's own figures: 10+x% boss damage on Meso Explosion, x% critical damage,
# and ceil(x/2) LUK. The boss damage brands the coins rather than the Shadower,
# which is what a boost aimed at Meso Explosion is for.
#
# A passive here, and a toggle in GMS that swaps places with Pick Pocket for
# the same 30% chance -- so what it replaces is what it grants, and nothing
# about the drop needs saying. Its buff is Assassinate's finishing blow, which
# that skill already assumes. Combat Orders does not reach it in GMS either.
name: "Blood Money"
skill_order: 3
description:
  "Drops coins branded with an Assassin's Mark. Enhances Meso Explosion. "
  "Permanently increases LUK and Critical Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_SHADOWER
max_level: 20
required_skill {
  skill_name: "Meso Explosion"
  level: 1
}
base {
  luk: 10
  crit_dmg: 0.01
}
per_level { crit_dmg: 0.01 }
boost {
  skill_name: "Meso Explosion"
  effect { boss_pct: 0.11 }
  effect_per_level { boss_pct: 0.01 }
}
