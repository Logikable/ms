# Written as a second Final Attack, so it adds to Final Attack: Bow instead of
# competing with it.
#
# GMS unlocks the arrowheads with a later skill and lets you switch; there is
# nothing to switch here, so only one arrowhead is kept.
name: "Quiver Cartridge"
description: "Uses a special arrowhead."
kind: SKILL_KIND_PASSIVE
final_attack_max_enemies: 1
placement { job_advancement: JOB_ADVANCEMENT_HUNTER skill_order: 2 }
max_level: 10
final_attack_label: "Magic Arrow"
base {
  final_attack_chance: 0.12
  final_attack_pct: 1.21
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.11
}
