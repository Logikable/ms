# GMS maxes this at 30; compressed to 10 levels ending at GMS's top figures.
#
# The avoidability is the flat roll dodge_chance models. It combines with
# Evasion Boost's as two separate rolls: 51%, not 60%.
name: "Illusion Step"
description:
  "Greatly increases your DEX and Avoidability, and reduces damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 8 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 8 }
max_level: 10
exceeds_master_level: true
base {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
per_level {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
