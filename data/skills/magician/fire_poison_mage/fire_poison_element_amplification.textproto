# GMS buys the damage with MP the spells then cost more of. Nothing here spends
# MP, so the bargain is one-sided: 5x% damage, the biggest single lever in the
# book, and the same one the I/L mage carries.
name: "Element Amplification"
description: "Increases the Damage of your magic skills."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 8 }
max_level: 10
base { damage_pct: 0.05 }
per_level { damage_pct: 0.05 }
