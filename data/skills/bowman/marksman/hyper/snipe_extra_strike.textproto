# Nine strikes to ten, and the mark spent by the empowered shot from five to
# six. The mark rides Empowered Snipe rather than Snipe -- see Greater
# Empowered Arrows -- which is what the boost following the skill into its
# form reaches.
name: "Snipe - Extra Strike"
description:
  "Increases the number of attacks of Snipe, Empowered Snipe, and of Snipe's "
  "additional hits."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 10 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Snipe"
  lines: 1
  extra_hit_lines: 1
  reach: BOOST_REACH_BOTH
}
