# GMS's decoy, cut down to damage on a timer and its stun, at GMS's max 10+2x%
# for ceil(x/8) seconds. Its health bar and the counterattack when hit are
# dropped: nothing here draws aggro, so a decoy for aggro would do nothing.
#
# Six enemies instead of GMS's eight, and its top 200% at 20 levels instead of
# 30. With nothing left but damage, it would otherwise overshadow Frostprey,
# the Sniper's only summon.
#
# Three seconds between strikes, observed rather than read: GMS states no rate,
# and unlike Phoenix its animation has no timing either.
name: "Arrow Illusion"
description:
  "Summons an arrow illusion that damages enemies on its own. Also increases "
  "Ignore Defense permanently."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 4 }
max_level: 20
exceeds_master_level: true
max_enemies: 6
cast_interval_seconds: 3.0
stun {
  duration_seconds: 4.0
  chance: 0.7
}
base { skill_pct: 1.05 }
per_level { skill_pct: 0.05 }
# GMS lists the Ignore DEF under "[Passive Effects]", so it belongs to the
# Marksman, not the decoy. Radiant Evil's is different: the eye ignores DEF with
# its own strikes.
passive { ied_pct: 0.015 }
passive_per_level { ied_pct: 0.015 }
