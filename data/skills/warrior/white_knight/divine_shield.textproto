# Built with Buff.shield: the shell blocks whole hits and breaks when its count
# runs out. The chance of raising it is dropped: it is certain at max level.
#
# GMS's reduction applies "only for attacks that inflict damage at a certain
# ratio of the max HP"; bosses stand in for those, as with Holy Magic Shell.
name: "Divine Shield"
description:
  "When struck, generates a shield that blocks a number of blows and "
  "permanently increases your Attack Power."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 8 }
max_level: 10
base { attack: 2 }
per_level { attack: 2 }
buff {
  duration_seconds: 90.0
  shield {
    hits: 1.0
    hits_per_level: 1.0
    boss_damage_taken_pct: 0.07
  }
}
cooldown_seconds: 30.0
