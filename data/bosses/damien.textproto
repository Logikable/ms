name: "Damien"
difficulties {
  name: "Normal"
  # He moves along the row above the player's heads one cell at a time, and the
  # whole floor is the player's.
  phases {
    bgm: "Demian Spine"
    spawns {
      mob: "damien_phase_1"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  # Blade drawn, with the same movement, but every thirty seconds he charges
  # across the room: four cells one way, a cell every 120ms, stopping at the
  # wall.
  phases {
    bgm: "Demian True"
    spawns {
      mob: "damien_phase_2"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twenty-five minutes, which only Lotus also has. GMS allows thirty; this is
  # 1.2T HP behind 300% PDR, and the time limit is the real obstacle.
  time_limit_seconds: 1500
  # The same level as Lotus.
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price for this fight, divided by seven
  # (GMS clears Damien once a week and this game once a day), rounded to the
  # nearest 50k.
  meso: 24150000
  # GMS pays this on the second body; here the clear pays it, flat and
  # unaffected by EXP bonuses, like every other fight.
  exp: 22000000
  # One coin per clear, the currency for AbsoLab gear.
  drops {
    item: "absolab_coin"
    per_kill: 1.0
  }
  drops {
    item: "damiens_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  # Defined but not built: 36T over the same two bodies, thirty times Normal. No
  # time limit, unlock level or reward until the fight is built.
  name: "Hard"
  coming_soon: true
  phases {
    bgm: "Demian Spine"
    spawns {
      mob: "hard_damien_phase_1"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Demian True"
    spawns {
      mob: "hard_damien_phase_2"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
}
