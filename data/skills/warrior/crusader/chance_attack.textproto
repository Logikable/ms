# GMS only gives the final damage against an enemy that is already pierced or
# held. Scarring Sword is what pierces, so the condition is real here: the
# damage lands on scarred monsters and nothing else. The critical rate is
# permanent, as GMS states.
#
# GMS's own ten levels and ladder, exact at every level.
name: "Chance Attack"
description:
  "Deals greater damage when attacking weakened enemies. Permanently "
  "increases Critical Rate."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 6 }
max_level: 10
base {
  final_dmg_pct_when_scarred: 0.07
  crit_rate: 0.02
}
per_level {
  final_dmg_pct_when_scarred: 0.02
  crit_rate: 0.02
}
