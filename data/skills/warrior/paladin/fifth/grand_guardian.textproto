# The Paladin's third class node, a hold like Calamitous Cyclone: a cross of
# light the player keeps up while the key is held, sheltering behind it while it
# pulses.
#
# It is a hold that GROWS. The client has two full keydown sets,
# 5thGrandCrossLoop at 480ms and again at 720, and the four seconds of holding
# split into 1080ms small, 480 of growing, then 2440 grown. At the 150ms pulse
# that is 7 pulses then 16, the 23 the data states.
#
# 1680ms is the wind-up plus the release (900ms of 5thGrandCrossPre and 780 of
# 5thGrandCrossEnd), read like Calamitous Cyclone's 870. There is no strike on
# release: GMS ends the cross by letting go, so the 780ms costs time and does
# nothing.
#
# Dropped: the knockback and status immunity while held, and the attack speed
# the growth also gives, which has no number anywhere.
name: "Grand Guardian"
description:
  "Blaze a glorious cross-section of light, symbolizing noble sacrifice. You "
  "can continuously attack while moving, and gain more strength the longer "
  "the sacrifice continues."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
base_delay_ms: 1680
cooldown_seconds: 120.0
max_enemies: 12
lines: 12
base {
  skill_pct: 2.54
  crit_rate: 1.00
  ied_pct: 1.00
}
per_level { skill_pct: 0.09 }
channel {
  pulse_interval_ms: 150
  max_pulses: 23
  small_pulses: 7
  finish_delay_ms: 780
  damage_taken_pct: 0.50
  grown {
    label: "Grand Cross"
    lines: 12
    base { skill_pct: 4.89 }
    per_level { skill_pct: 0.19 }
  }
}
