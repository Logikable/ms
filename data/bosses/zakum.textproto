name: "Zakum"
difficulties {
  name: "Normal"
  # The eight arms stand in two columns down the middle of the arena, a spot
  # apiece. The lanes on either side of them are the player's, who fights from
  # the floor or from a ledge.
  phases {
    spawns {
      mob: "zakum_arm"
      spots { x: 2 y: 1 }
      spots { x: 2 y: 2 }
      spots { x: 2 y: 3 }
      spots { x: 2 y: 4 }
      spots { x: 4 y: 1 }
      spots { x: 4 y: 2 }
      spots { x: 4 y: 3 }
      spots { x: 4 y: 4 }
    }
    # The floor of the arena and the two ledges over its ends, which is where
    # the map puts them. The arms stand between the lanes rather than in them.
    player_spots { x: 3 y: 5 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 6 y: 3 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 7
    arena_height: 6
  }
  # The body alone, low over the floor the player crosses.
  phases {
    spawns {
      mob: "zakum"
      spots { x: 3 y: 2 }
    }
    # No ledges: the body fills the arena and the floor is all there is.
    player_spots { x: 3 y: 3 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 6 y: 3 }
    arena_width: 7
    arena_height: 4
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  # GMS opens Normal Zakum at 110, which is also the level his arms are.
  unlock_level: 110
  # What GMS pays as an Intense Power Crystal, which is a drop nobody keeps:
  # five of them at the Heroic price, handed over as the meso they would fetch.
  meso: 3062500
  # Paid for the clear rather than for the body that ends it, as every boss's
  # EXP is: flat, and no EXP bonus touches it.
  exp: 4750740
  drops {
    equip: "aquatic_letter_eye_accessory"
    per_kill: 0.5
  }
  drops {
    equip: "condensed_power_crystal"
    per_kill: 0.5
  }
  drops {
    item: "zakums_soul_shard"
    per_kill: 1.0
  }
}
# Written down, not built: the eight arms and the body again, at the numbers
# GMS gives Chaos. Only the HP is stated, because nothing else is decided.
difficulties {
  name: "Chaos"
  phases {
    spawns {
      mob: "chaos_zakum_arm"
      spots { x: 2 y: 1 }
      spots { x: 2 y: 2 }
      spots { x: 2 y: 3 }
      spots { x: 2 y: 4 }
      spots { x: 4 y: 1 }
      spots { x: 4 y: 2 }
      spots { x: 4 y: 3 }
      spots { x: 4 y: 4 }
    }
    # The floor of the arena and the two ledges over its ends, which is where
    # the map puts them. The arms stand between the lanes rather than in them.
    player_spots { x: 3 y: 5 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 6 y: 3 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 7
    arena_height: 6
  }
  phases {
    spawns {
      mob: "chaos_zakum"
      spots { x: 3 y: 2 }
    }
    # No ledges: the body fills the arena and the floor is all there is.
    player_spots { x: 3 y: 3 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 6 y: 3 }
    arena_width: 7
    arena_height: 4
  }
  coming_soon: true
}
