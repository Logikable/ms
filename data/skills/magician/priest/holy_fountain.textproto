# GMS's 10+3x% of HP per drink, from a fountain the party walks to. Nobody walks
# here, so it just pours, for the Priest and everyone with them, on a cooldown
# that drops half a second a level.
#
# Half seconds, not whole ones, because the drop from level 1 to 10 must divide
# by nine, and 7.5 is the nearest start to eight that does.
name: "Holy Fountain"
description:
  "Summons a Holy Fountain that restores party members' HP on its own."
kind: SKILL_KIND_PASSIVE
tags: SKILL_TAG_BENEVOLENCE
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 3 }
max_level: 10
base {
  regen_pct: 0.13
  regen_interval_seconds: 7.5
}
per_level {
  regen_pct: 0.03
  regen_interval_seconds: -0.5
}
ally_base {
  regen_pct: 0.13
  regen_interval_seconds: 7.5
}
ally_per_level {
  regen_pct: 0.03
  regen_interval_seconds: -0.5
}
