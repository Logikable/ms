  # GMS never published the boxes' odds. Unlike GMS, drop rate raises them.
  drops {
    item: "absolab_weapon_box"
    per_kill: 0.11
  }
  drops {
    item: "absolab_armor_box"
    per_kill: 0.33
  }
  # GMS's rate is about 0.2%. Pitched gear is tier 3 at one difficulty up:
  # 1/20 days x 2 x the accessory multiplier of 2.
  drops {
    equip: "berserked"
    per_kill: 0.2
  }
  drops {
    equip: "black_heart"
    per_kill: 0.2
  }
  # The user's rate (2026-10-04); GMS publishes none.
  drops {
    item: "scroll_for_accessory"
    per_kill: 0.5
  }
}
