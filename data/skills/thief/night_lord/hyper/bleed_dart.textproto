# A passive instead of GMS's 90-second buff, at the user's request.
name: "Bleed Dart"
description:
  "Coats your stars with a deadly poison that causes bleeding, increasing "
  "Attack Power and inflicting continuous damage on enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base { attack: 50 }
dot {
  interval_seconds: 1.0
  duration_seconds: 3.0
  lines: 1
  base { skill_pct: 20.0 }
}
