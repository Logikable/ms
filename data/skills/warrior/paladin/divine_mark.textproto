# Two hits landing at once: the hammer, and the brand of light it leaves, which
# GMS detonates a moment later. Nothing here would use the gap, so they are one
# swing, but calculated separately, because only the explosion does more to
# ordinary monsters, and one averaged multiplier would spread that over the
# hammer's seven strikes too. See Skill.extra_hit.
#
# The silence and extra range it also gives are dropped: nothing here is ever
# silenced, and this game has no range.
#
# 660ms is Divine Charge's, the same hammer one tier down: this one's animation
# frames aren't published anywhere we could read.
name: "Divine Mark"
description:
  "Allows you to summon a more powerful holy hammer. Enhances the damage and "
  "range of Divine Charge. When Divine Mark is used, a brand of light appears "
  "at the target location, detonating after a set period and striking enemies "
  "in a wide area. This explosion deals additional damage to normal enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 1 }
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
exceeds_master_level: true
required_skill {
  skill_name: "Divine Charge"
  level: 20
}
tags: SKILL_TAG_HOLY_POWER
base_delay_ms: 660
cooldown_seconds: 7.0
max_enemies: 10
lines: 7
base { skill_pct: 3.04 }
per_level { skill_pct: 0.04 }
boost {
  skill_name: "Divine Charge"
  effect { skill_pct: 0.42 }
  effect_per_level { skill_pct: 0.02 }
}
extra_hit {
  label: "Explosion"
  lines: 5
  base {
    skill_pct: 2.03
    normal_pct: 0.30
  }
  per_level { skill_pct: 0.03 }
}
