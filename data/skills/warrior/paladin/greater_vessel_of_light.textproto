# GMS says this overrides Vessel of Light, so it supersedes it and states
# everything a Paladin gets instead of the difference. Its first level already
# beats the 2nd job skill's last, so buying it is never a step back.
#
# Its HP recovery is dropped, as the user asked. GMS stops the damage at 25% and
# the attack at 60 after level 10; the ladder here goes a little past both with
# Combat Orders, which is the cost of climbing them at all.
#
# The strikes and reach are the rest of the skill and the reason SkillBoost
# exists: a strike each for Divine Charge and Blast, and two more enemies for
# Divine Charge by level 10 (GMS's ceil(L/5)).
#
# Those two take Divine Charge to seven, more than the five its 415x200 box
# holds. That stands: the reach rule only lowers what a swing states for itself,
# and a book's grant may raise it.
name: "Greater Vessel of Light"
description:
  "Empowers Vessel of Light to its limit with your mastery. Increases Divine "
  "Charge's max number of targets and the attack count of both Divine Charge "
  "and Blast."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 8 }
max_level: 10
exceeds_master_level: true
supersedes_skill_name: "Vessel of Light"
base {
  damage_pct: 0.205
  attack: 51
  damage_taken_pct: 0.10
  status_resistance: 10.0
}
per_level {
  damage_pct: 0.005
  attack: 1
}
boost {
  skill_name: "Divine Charge"
  lines: 1
  max_enemies: 1
  max_enemies_per_level: 0.2
}
boost {
  skill_name: "Blast"
  lines: 1
}
