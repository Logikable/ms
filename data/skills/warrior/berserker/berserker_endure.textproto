# GMS caps this at 14 and ends at +20 of each. Stretched over 20 levels to the
# same place, as Lord of Darkness is.
#
# Nothing in this game inflicts an abnormal status or deals elemental damage,
# so this grants nothing today. It is written out in full anyway: the figures
# belong with the skill, and the stats page shows both rows so a player can see
# what their points bought.
name: "Endure"
skill_order: 6
description:
  "Stand through what would put another warrior down. Increases resistance to "
  "abnormal status and to elemental damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BERSERKER
max_level: 20
base {
  status_resistance: 1
  elemental_resistance: 0.01
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
