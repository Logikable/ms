# The Dark Knight's second class node: an aura that pulses once a second for
# forty seconds, and one dark slash released from it whenever the player
# chooses.
#
# Here the slash is the swing, and the aura goes up with it. GMS takes two
# presses, one for each, but the slash lands once per cast wherever it falls in
# the window, so nothing is lost by paying both animations at once:
# base_delay_ms is 5thDarknessAura's 600ms plus 5thDarknessAuraEnd's 570.
#
# The 3% heal is per pulse, not per line, as Calamitous Cyclone's heal is read,
# so the aura heals 120% of HP over its forty seconds.
#
# Dropped: the shield built from overhealing (75% of it, capped at a third of
# HP), the tenth off damage taken while the key is held, and cancelling
# Gungnir's Descent, Nightshade Explosion and Calamitous Cyclone's detonations;
# nothing here models cancels.
name: "Darkness Aura"
description:
  "Unleash a dark aura that siphons the life force of nearby enemies. "
  "Reusing the skill looses a dark slash out of it."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 1170
cooldown_seconds: 120.0
max_enemies: 8
lines: 13
base { skill_pct: 4.36 }
per_level { skill_pct: 0.16 }
buff {
  duration_seconds: 40.0
  pulse {
    label: "Dark Aura"
    cast_interval_seconds: 1.0
    lines: 5
    max_enemies: 3
    base {
      skill_pct: 3.00
      hp_recover_pct: 0.03
    }
    per_level { skill_pct: 0.10 }
  }
}
