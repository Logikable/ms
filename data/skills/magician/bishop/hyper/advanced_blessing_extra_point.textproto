# A thousand onto each pool, for the party as well as the caster -- flat, the
# way a worn item grants one, since it is the same number at every level of the
# skill it is named for.
name: "Advanced Blessing - Extra Point"
description:
  "Increases the Max HP and Max MP Advanced Blessing grants you and your "
  "party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 12 }
hyper: true
required_level: 190
max_level: 1
base {
  max_hp: 1000
  max_mp: 1000
}
ally_base {
  max_hp: 1000
  max_mp: 1000
}
