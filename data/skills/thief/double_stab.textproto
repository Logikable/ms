# Two stabs of 85+4x%: 178% per target at level 1 and 330% at max. GMS gives
# 90+5x over 15 levels; stretching to 20 keeps the same 165% a stab at the top,
# the rule every skill here follows. It ends even with Lucky Seven, which is why
# the dagger it needs matters: both are 330% on the same four targets, and only
# the weapon differs.
#
# Four enemies against GMS's five: the box is 330x175, one storey tall, and fits
# four across. See Skill.max_enemies.
name: "Double Stab"
description: "Quickly stab a nearby enemy."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_ROGUE skill_order: 1 }
max_level: 20
base_delay_ms: 690
lines: 2
max_enemies: 4
required_equip_type: EQUIP_TYPE_DAGGER
base {
  skill_pct: 0.89
}
per_level {
  skill_pct: 0.04
}
