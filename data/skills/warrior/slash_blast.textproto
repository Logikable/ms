# Reach cut from GMS's 6 to 4. Its hitbox is 295x175 -- one storey of a map,
# holding 4 monsters side by side -- so 6 is a cap GMS never fills and this
# fight would hit every time. See Skill.max_enemies.
#
# The wiki leads with the MP the swing costs. Nothing here spends MP, so the
# attack is all that is left to say.
name: "Slash Blast"
description: "Attack nearby enemies all at once."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SWORDMAN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 750
max_enemies: 4
base { skill_pct: 1.83 }
per_level { skill_pct: 0.08 }
