# GMS gives this a 12-second cooldown, which for a skill worth using every time
# it is ready is the same as a cast interval, so that is what it becomes here.
# The stun is GMS's max value, 9*ceil(x/2)% for 5 seconds.
#
# The aura heal belongs to the eye, not the shout, and GMS attaches it to a
# separate one-point Evil Eye skill this book doesn't have. It goes here
# instead, and is restated on both tiers above, since a superseded skill stops
# paying and a Dark Knight would otherwise lose the heal by upgrading. 24 HP
# every 24 seconds is nothing to a real HP bar, which is why Evil Eye - Aura
# Reinforce exists.
name: "Evil Eye Shock"
description: "Your Evil Eye shouts, stunning and damaging nearby enemies."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 2 }
max_level: 10
max_enemies: 10
lines: 6
cast_interval_seconds: 12.0
stun {
  duration_seconds: 5.0
  chance: 0.45
}
base {
  skill_pct: 1.23
  regen_hp: 6
  regen_interval_seconds: 24.0
}
per_level {
  skill_pct: 0.03
  regen_hp: 2
}
