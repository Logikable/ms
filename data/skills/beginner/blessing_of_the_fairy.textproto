# The one skill nobody buys. Its level is the account's highest other character
# divided by ten, so a new character has it at once and it rises on its own. GMS
# caps it at 20; here it runs to the level cap, like every other ladder.
name: "Blessing of the Fairy"
description:
  "Permanently increases your Attack Power and Magic Attack, based on the "
  "level of the highest-level character on your account."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BEGINNER skill_order: 1 }
account_levels_per_level: 10
base {
  attack: 1
  magic_attack: 1
}
per_level {
  attack: 1
  magic_attack: 1
}
