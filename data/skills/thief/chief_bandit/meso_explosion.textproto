# A passive here, because there is no ground and no mesos to walk over: every
# meso that drops is thrown at once.
#
# GMS's normal-enemy bonus is points on a line, not a share.
name: "Meso Explosion"
description: "Fling Mesos, dropped by Pick Pocket, to damage enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 2 }
max_level: 20
lines: 2
required_skill { skill_name: "Pick Pocket" level: 1 }
base {
  meso_hit_pct: 0.43
  normal_skill_pct: 0.012
}
per_level {
  meso_hit_pct: 0.03
  normal_skill_pct: 0.002
}
