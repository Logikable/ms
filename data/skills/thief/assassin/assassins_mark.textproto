# GMS marks an enemy on hit and spends the mark on the next attack, throwing
# two stars for 150%. One level there; ten here, climbing to GMS's own figures
# from a little over half of them.
#
# The mark and the spending of it are one beat apart in GMS and none here, so
# what is left is a Final Attack -- a chance, on every enemy the swing reached,
# of two more stars. It names no tag, so every swing sets it off.
#
# The two stars are two lines rather than one worth double, so each rolls its
# own crit and its own mastery. Same 300% at master level either way.
name: "Assassin's Mark"
description:
  "Has a chance to tag the enemy with the assassin's mark when attacking. The "
  "next attack on a marked enemy will cause throwing stars to form on that "
  "enemy and attack other enemies nearby."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ASSASSIN skill_order: 2 }
max_level: 10
base {
  final_attack_chance: 0.22
  final_attack_pct: 0.78
  final_attack_lines: 2
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.08
}
