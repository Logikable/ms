# The AbsoLab top for this branch, bought with the coins Damien and Lotus drop.
# One of four, since each class wears its own piece, so the set is defined four
# times rather than once around a universal item.
#
# GMS has the top and bottom as one overall. They are split here because the
# two slots are separate; together they add up to the overall's stats.
name: "AbsoLab Mage Armor"
required_level: 160
base_stats {
  int: 35
  luk: 35
  magic_attack: 3
  def: 180
}
equip_job_categories: EQUIP_JOB_CATEGORY_MAGICIAN
equip_slot: EQUIP_SLOT_TOP
upgrade_slots: 7
token_item: "absolab_coin"
token_price: 2
