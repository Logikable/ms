# GMS shields the party but not the caster: allies take 10+x% less damage and
# guard against 10+x% of what gets through, and the caster gets 2x attack for
# keeping the guard up. Both halves need someone to shield, so a White Knight
# alone gets nothing. See Skill.requires_party.
#
# A guard blocks the whole hit instead of reducing it, which is what
# dodge_chance is. GMS's own ten levels, exact at every level.
name: "Parashock Guard"
description:
  "Reduces the damage nearby party members receive and gives them a chance to "
  "guard. Increases your Attack Power."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 5 }
max_level: 10
requires_party: true
base { attack: 2 }
per_level { attack: 2 }
ally_base {
  damage_taken_pct: 0.11
  dodge_chance: 0.11
}
ally_per_level {
  damage_taken_pct: 0.01
  dodge_chance: 0.01
}
