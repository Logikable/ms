# The magicians' link skill: a stack rolled on every swing, up to three at once,
# each lasting its own ten seconds.
#
# GMS's value per stack is 1% through level 2, 2% through 4 and so on: half a
# point a level in whole numbers. Half a point is written here, so levels 1 and
# 9 match GMS and the even levels are half a point above.
#
# The Ignore DEF doesn't simply triple: the three stacks combine like any two
# sources of it. See CombineIgnoredDefense.
name: "Empirical Knowledge"
description:
  "Has a chance when attacking to increase your damage and your ignored "
  "enemy DEF. Stacks up to 3 times."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_LINK skill_order: 2 }
link_line: JOB_MAGICIAN
max_level: 9
buff {
  duration_seconds: 10.0
  raise_chance: 0.15
  raise_chance_per_level: 0.02
  stacks: 3
  base {
    damage_pct: 0.01
    ied_pct: 0.01
  }
  per_level {
    damage_pct: 0.005
    ied_pct: 0.005
  }
}
