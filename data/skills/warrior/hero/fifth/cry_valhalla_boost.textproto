# GMS names Final Attack here, but a Hero's extra hit comes from Advanced Final
# Attack, which supersedes it, so the grant targets the skill that actually
# strikes. Cry Valhalla gets critical rate at 20 instead of the extra enemy the
# other two get: it attacks with a buff's pulse, whose reach is stated on the
# pulse itself.
#
# Named for its main skill only, like every node that boosts more than one: the
# description names the other two.
name: "Cry Valhalla Boost"
description: "Strengthens Cry Valhalla, Puncture and Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 11 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Cry Valhalla"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Cry Valhalla"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Cry Valhalla"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Puncture"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Puncture"
  min_level: 20
  max_enemies: 1
}
boost {
  skill_name: "Puncture"
  min_level: 40
  effect { ied_pct: 0.20 }
}
boost {
  skill_name: "Advanced Final Attack"
  effect { final_dmg_pct: 0.02 }
  effect_per_level { final_dmg_pct: 0.02 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Advanced Final Attack"
  min_level: 40
  effect { ied_pct: 0.20 }
}
