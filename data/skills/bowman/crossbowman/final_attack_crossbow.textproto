# The extra hit lands on one enemy: GMS's Final Attack has no mobCount of its
# own and its text says "attacks the boss with the highest HP first".
name: "Final Attack: Crossbow"
description:
  "When a direct attack skill lands, there's a chance to trigger additional "
  "hits."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CROSSBOWMAN skill_order: 5 }
final_attack_max_enemies: 1
max_level: 20
required_equip_type: EQUIP_TYPE_CROSSBOW
required_skill {
  skill_name: "Crossbow Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 1.0
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.025
}
