# GMS grants the whole of this at once, and only while a Holy Power skill is
# being used. Here it is permanent and bought a twentieth at a time, ending
# exactly where GMS's one level does. Its HP recovery is left out, along with
# the status resistance, which nothing in this game would resist.
name: "Vessel of Light"
skill_order: 2
description:
  "Amasses the power of light within you. Increases Damage and Attack Power, "
  "and reduces the damage you take."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_PAGE
max_level: 20
base {
  damage_pct: 0.005
  attack: 2
  damage_taken_pct: 0.005
  status_resistance: 0.5
}
per_level {
  damage_pct: 0.005
  attack: 2
  damage_taken_pct: 0.005
  status_resistance: 0.5
}
