# A timed party buff in GMS, always up here. It gives attack because GMS does,
# though magicians attack with the other number.
name: "Bless"
description:
  "Increases the Attack Power, Magic ATT, and Defense of you and nearby party "
  "members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 4 }
exclusive_group: "Blessing"
max_level: 10
required_skill {
  skill_name: "Invincible"
  level: 5
}
base {
  attack: 6
  magic_attack: 6
  def: 30
}
per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
ally_base {
  attack: 6
  magic_attack: 6
  def: 30
}
ally_per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
