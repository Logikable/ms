# Two boosts because the client targets Hurricane, Arrow Blaster and the turret;
# the turret carries its parent's name, so one boost covers both.
name: "Hurricane - Reinforce"
description:
  "Increases damage for Hurricane, Arrow Blaster, and installed Arrow "
  "Blaster."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Hurricane"
  effect { damage_pct: 0.30 }
}
boost {
  skill_name: "Arrow Blaster"
  effect { damage_pct: 0.30 }
}
