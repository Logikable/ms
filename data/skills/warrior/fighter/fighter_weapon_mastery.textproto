# GMS adds 5% damage on top of this for an axe specifically. The mastery and
# the swing speed are the whole skill for us; which of the two weapons is in
# hand only decides whether it applies at all.
name: "Weapon Mastery"
description:
  "Trains your grip until your sword lands where you mean it to, narrowing "
  "your weakest swings toward your best. Also speeds them up. Needs a sword "
  "or an axe in hand."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_FIGHTER
max_level: 10
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
base {
  mastery: 0.14
  attack_speed: 1
}
per_level { mastery: 0.04 }
