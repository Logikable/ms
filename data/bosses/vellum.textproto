name: "Vellum"
difficulties {
  # No Normal: Root Abyss is only fought on Chaos.
  name: "Chaos"
  # One body alone in the arena, like Hilla, Magnus, Arkarium and Cygnus, and
  # the only one that moves. He steps along his row every half minute; it is
  # only visual and doesn't affect the player.
  phases {
    bgm: "AbyssCave"
    spawns {
      mob: "chaos_vellum"
      spots { x: 4 y: 4 }
      walk { interval_ms: 30000 range: RANGE_ROW }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # A third longer than the other three: twice Pierre's HP, behind 200% PDR.
  time_limit_seconds: 1200
  # Level 200. All four Root Abyss bosses unlock together.
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price for this fight, divided by seven,
  # since GMS clears Root Abyss once a week and this game once a day.
  meso: 15000000
  # No EXP for the clear. When the level cap was 200 a character here had
  # nowhere to put it, and these four are fought for their drops.
  drops {
    item: "piece_of_destruction"
    per_kill: 1.0
  }
  drops {
    item: "vellums_soul_shard"
    per_kill: 1.0
  }
}
