# The client's "Number of Explosions: 2" means two mists at once, so an enemy in
# both takes the ten hits twice.
#
# Nothing here places mists, so the final damage keeps GMS's value for two
# explosions.
#
# The passive boosts the mist's mark, not the cast, so it is points on the tick.
name: "Mist Eruption"
description:
  "Permanently increases Poison Mist's continuous damage. Upon using the "
  "skill, nearby Poison Mists explode, dealing fatal poison damage to "
  "enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 2 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
required_skill {
  skill_name: "Poison Mist"
  level: 20
}
base_delay_ms: 660
max_enemies: 12
lines: 20
cooldown_seconds: 10.0
base {
  skill_pct: 0.965
  ied_pct: 0.115
  final_dmg_pct: 0.20
}
per_level {
  skill_pct: 0.015
  ied_pct: 0.015
}
boost {
  skill_name: "Poison Mist"
  dot_skill_pct: 0.315
  dot_skill_pct_per_level: 0.015
}
