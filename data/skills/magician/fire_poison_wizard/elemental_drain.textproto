# GMS reads the damage-over-time effects on nearby enemies and pays final
# damage for each of them. Burns are real here now, but nothing reports how
# many are alight on what a swing can reach, so what is left is the final
# damage, held permanently.
name: "Elemental Drain"
skill_order: 2
description: "Permanently increases your Final Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD
max_level: 10
base { final_dmg_pct: 0.015 }
per_level { final_dmg_pct: 0.015 }
