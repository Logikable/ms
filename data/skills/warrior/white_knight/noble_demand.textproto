# GMS also lowers the enemy's DEF and accuracy; this game lowers no monster's
# DEF and has no accuracy.
#
# Its success rate is dropped: GMS's player recasts until it lands, so the rate
# costs casts, not damage.
name: "Noble Demand"
description:
  "Releases the pride of the Holy Knight, decreasing the Attack Power of "
  "nearby enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 3 }
max_level: 20
base { enemy_attack_pct: 0.30 }
per_level { enemy_attack_pct: 0.01 }
