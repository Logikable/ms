# GMS's 12-second cooldown on a skill worth using every time is a cast interval
# here.
#
# GMS attaches the aura heal to a separate Evil Eye skill this book doesn't
# have. It goes here instead, restated on both tiers above, since a superseded
# skill stops paying.
name: "Evil Eye Shock"
description: "Your Evil Eye shouts, stunning and damaging nearby enemies."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 2 }
max_level: 10
max_enemies: 10
lines: 6
cast_interval_seconds: 12.0
stun {
  duration_seconds: 5.0
  chance: 0.45
}
base {
  skill_pct: 1.23
  regen_hp: 6
  regen_interval_seconds: 24.0
}
per_level {
  skill_pct: 0.03
  regen_hp: 2
}
