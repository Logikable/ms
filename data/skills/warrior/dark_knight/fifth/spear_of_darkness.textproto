# Nine casts instead of 63 lines, so each spear rolls its own mastery and
# criticals.
#
# The 660ms cast is fixed: all six frames have a negative delay, the client's
# mark for a frame attack speed doesn't shorten.
name: "Spear of Darkness"
description: "Hurls a spear of utter darkness at the enemy."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 1 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 660
fixed_delay: true
cooldown_seconds: 10.0
max_enemies: 12
lines: 7
casts: 9
base {
  skill_pct: 4.11
  crit_rate: 1.00
  ied_pct: 0.50
}
per_level { skill_pct: 0.16 }
