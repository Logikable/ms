name: EQUIP_SET_NAME_DAWN_BOSS
# Four slots in GMS (pendant, face, earrings and ring), and this game has only
# the ring. The tiers count against all four, so the set pays nothing yet.
complete_pieces: 4
members {
  slot: EQUIP_SLOT_RING
  # GMS sells a scroll that turns the Boss Accessory ring into a Dawn one, and
  # the two sets then can't share it. There is no conversion here, so the one
  # ring counts for both.
  items { name: "Guardian Angel Ring" }
}
