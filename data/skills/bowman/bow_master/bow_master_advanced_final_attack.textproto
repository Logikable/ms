# GMS states the whole Final Attack, not an increase over the Hunter's, so this
# supersedes it. Its base must beat 40%, which Final Attack: Bow already
# reaches, or the first point would be a step back. GMS starts at 41%; this
# starts at 41.5% so the ladder climbs by an even 1.5%.
#
# It needs the Hunter's bow, so both stop together: a Bow Master holding a
# weapon neither fires with gets neither.
#
# The extra hit lands on ONE enemy the swing reached, not on each. GMS's Final
# Attack has no mobCount or hitbox of its own, and its text names its target:
# "attacks the boss with the highest HP first".
name: "Advanced Final Attack"
description:
  "Permanently increases Attack Power. Greatly increases activation rate and "
  "damage of Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 9 }
final_attack_max_enemies: 1
max_level: 20
exceeds_master_level: true
supersedes_skill_name: "Final Attack: Bow"
required_equip_type: EQUIP_TYPE_BOW
required_skill {
  skill_name: "Final Attack: Bow"
  level: 20
}
base {
  attack: 1
  final_attack_chance: 0.415
  final_attack_pct: 1.53
}
per_level {
  attack: 1
  final_attack_chance: 0.015
  final_attack_pct: 0.03
}
