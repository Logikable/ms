# The wound rides the ENEMY, as GMS's does: the swing leaves a burn, and every
# swing after it lands harder on whatever is still burning. So both halves wait
# on a monster the Hero has actually punctured, rather than on a window over
# the character.
#
# The burn is rolled -- 40 + 2L% on each enemy the swing reached, which is
# certain at master level and only better above it. A boss takes it every time;
# a room takes it on some of what the sweep caught.
#
# So the swing itself is one a Hero rarely spends: the chooser goes back for it
# as the burn nears its end and swings Raging Blow the rest of the time, which
# is the shape GMS has -- puncture, then hold.
#
# The party's share is the same bargain read off the ally: GMS pays them
# ceil(L/3)% where the Hero takes 10 + ceil(L/2)% -- 10% against 25% at master.
name: "Puncture"
description:
  "Pour your swordsman's spirit into a forward-downward strike, leaving a "
  "wound on your enemy that deals continuous damage. While taking continuous "
  "damage, the enemy will also take more damage."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_SWORDSMANSHIP
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 2 }
max_level: 30
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
exceeds_master_level: true
base_delay_ms: 720
max_enemies: 8
lines: 4
required_skill {
  skill_name: "Advanced Combo"
  level: 20
}
base {
  skill_pct: 3.13
  normal_pct: 0.50
  final_dmg_pct_when_afflicted: 0.105
}
per_level {
  skill_pct: 0.03
  final_dmg_pct_when_afflicted: 0.005
}
ally_base { final_dmg_pct_when_afflicted: 0.013 }
ally_per_level { final_dmg_pct_when_afflicted: 0.003 }
dot {
  interval_seconds: 2.0
  duration_seconds: 45.5
  duration_seconds_per_level: 0.5
  lines: 1
  chance: 0.42
  chance_per_level: 0.02
  base { skill_pct: 0.78 }
  per_level { skill_pct: 0.03 }
}
