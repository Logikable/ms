# Phoenix's twin: GMS gives both summons 210+18*L% damage, four enemies and a
# permanent 3*L% DEF, and the Korean DPM calculator uses delay=1710 for both.
#
# What it has that Phoenix doesn't is the freeze: 1 + floor(L/5) seconds in GMS,
# 3 at max. Skill.freeze_seconds has no ladder, so it holds the max value. The
# stun is Phoenix's alone.
name: "Frostprey"
description:
  "Summons a Frostprey that attacks on its own, freezing what it hits. Also "
  "increases DEF."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SNIPER skill_order: 2 }
max_level: 10
max_enemies: 4
freeze_seconds: 3.0
cast_interval_seconds: 1.71
base { skill_pct: 2.28 def_pct: 0.03 }
per_level { skill_pct: 0.18 def_pct: 0.03 }
