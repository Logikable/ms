# Two arrows a pulse at three quarters damage each: half as much again. Written
# as GMS states it, a strike added and damage taken off, instead of one
# multiplier, because the player is buying the second arrow and the page should
# say so.
name: "Hurricane - Split Attack"
description:
  "Increases the number of attacks. Reduces the damage of Hurricane."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 12 }
hyper: true
required_level: 190
max_level: 1
boost {
  skill_name: "Hurricane"
  lines: 1
  effect { final_dmg_pct: -0.25 }
}
