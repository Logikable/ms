# Magic attack and Buff Duration. Buff Duration lengthens a buff but not its
# cooldown, which is what makes a stat that gives nothing alone worth having.
# The V matrix is outside it: GMS marks every node notIncBuffDuration, and
# BuffDurationFor checks v_node instead of each file.
#
# GMS's knockback resistance is dropped: nothing here knocks a character back.
name: "Buff Mastery"
description:
  "Permanently increases Magic ATT and increases the duration of all buffs on "
  "you."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 8 }
max_level: 10
exceeds_master_level: true
base {
  magic_attack: 3
  buff_duration_pct: 0.05
}
per_level {
  magic_attack: 3
  buff_duration_pct: 0.05
}
