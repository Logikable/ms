# GMS gives 2 INT a level over 10 levels. Here it is spread over 5 at 4 each,
# the same 20 total for half the points, like Agile Arms and Agile Bows.
name: "Agile Magic"
description: "Increases Attack Speed and INT."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_WIZARD skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 5 }
max_level: 5
required_skill {
  skill_name: "Spell Mastery"
  level: 5
}
base {
  int: 4
  attack_speed: 2
}
per_level { int: 4 }
