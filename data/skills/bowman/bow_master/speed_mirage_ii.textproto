# GMS drops the strikes Speed Mirage needs from twelve to seven and raises the
# afterimages from three to four. Our Speed Mirage collapses both into one
# rate -- four strikes every four attacks -- and the new pair does not reduce,
# so it is written out: sixteen strikes every seven attacks.
#
# A boost rather than a supersede. Speed Mirage keeps paying, which it must:
# the Wind Arrow bonus is its own and this skill says nothing about it.
name: "Speed Mirage II"
skill_order: 3
description: "Your continued archery training has empowered your Speed Mirage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BOW_MASTER
max_level: 20
exceeds_master_level: true
boosts_skill_name: "Speed Mirage"
boost {
  skill_name: "Speed Mirage"
  lines: 12
  attacks_per_cast: 7
}
base { boosted_skill_pct: 0.82 }
per_level { boosted_skill_pct: 0.02 }
