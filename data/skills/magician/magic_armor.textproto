# Pure defense, 10 a point. GMS stops at 9; one more point brings the magician's
# book to the same 60 every other job gets.
#
# The wiki lists Magic Guard Lv. 3 as a prerequisite. This file sets no
# required_skill, so the description leaves it out.
name: "Magic Armor"
description: "Uses magic to increase DEF."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MAGICIAN skill_order: 3 }
max_level: 10
base {
  def: 10
}
per_level {
  def: 10
}
