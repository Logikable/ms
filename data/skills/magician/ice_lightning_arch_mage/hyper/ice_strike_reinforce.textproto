# GMS attaches these three to Teleport Mastery, which this game doesn't have.
# They go on Ice Strike instead, which is just as useless: a 4th job I/L uses
# Chain Lightning or Frozen Orb, and twenty points of damage on a 3rd job spell
# doesn't change that. The three knowingly ship worthless, as GMS's do.
name: "Ice Strike - Reinforce"
description: "Increases Ice Strike damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 4 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Ice Strike"
  effect { damage_pct: 0.20 }
}
