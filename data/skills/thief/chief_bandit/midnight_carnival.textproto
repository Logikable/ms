# GMS's Phase Dash beats Midnight Carnival at max, 840% to 760% on a shorter
# swing, so here they are one skill: Midnight Carnival's lines, Phase Dash's
# total.
#
# Five enemies against GMS's eight: 360x210 fits five across (see
# Skill.max_enemies).
name: "Midnight Carnival"
description: "Overwhelm enemies with supersonic slashes."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 750
max_enemies: 5
lines: 4
base { skill_pct: 1.72 }
per_level { skill_pct: 0.02 }
