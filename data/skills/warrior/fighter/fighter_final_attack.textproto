# GMS's (100 + 5*floor(L/2))% is a staircase base + per_level can't follow;
# rounding down to the even level is never more than 2.5% off.
#
# The extra hit lands on one enemy: GMS's Final Attack has no mobCount of its
# own and its text says "attacks the boss with the highest HP first".
name: "Final Attack"
description: "Chance to deliver an additional hit after a direct attack skill."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 7 }
final_attack_max_enemies: 1
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
required_skill {
  skill_name: "Weapon Mastery"
  level: 3
}
base {
  final_attack_chance: 0.02
  final_attack_pct: 1.0
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.025
}
