# Only the coins get it. A Shadower's own swing is a different skill and gets
# nothing from this, which is how it applies to the meso and not the thrower.
name: "Meso Explosion - Guardbreak"
description: "Increases Enemy DEF Ignored for Meso Explosion."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 2 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Meso Explosion"
  effect { ied_pct: 0.10 }
}
