# GMS gives 2 STR a level over 10 levels. Spread over 5 at 4 apiece, which ends
# in the same place -- 20 -- for half the points.
name: "Agile Arms"
description: "Increases Attack Speed and STR."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_PAGE skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 6 }
max_level: 5
required_skill {
  skill_name: "Weapon Mastery"
  level: 5
}
base {
  str: 4
  attack_speed: 2
}
per_level { str: 4 }
