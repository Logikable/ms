# GMS's barrier blocks statuses and recharges; only its passive half is kept.
# Nothing inflicts a status or has an element here, so neither lever is used.
name: "Elemental Adaptation"
description: "Permanently increases Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_MAGE skill_order: 3 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_MAGE skill_order: 4 }
max_level: 20
base {
  status_resistance: 1
  elemental_resistance: 0.01
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
