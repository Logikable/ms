# GMS gives it 10 levels at -5-2x%, ending at -25%. Here it ends the same over
# 20 levels, which is where the Cleric's book spends the points its levels give.
#
# Reductions multiply rather than add, so this and Magic Guard's 85% make 89%
# together, not 110% (see character_stats.cc).
name: "Invincible"
description: "Decreases all damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 6 }
max_level: 20
required_skill {
  skill_name: "Heal"
  level: 5
}
base { damage_taken_pct: 0.06 }
per_level { damage_taken_pct: 0.01 }
