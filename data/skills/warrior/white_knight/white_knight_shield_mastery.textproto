# GMS's ten levels are twenty here, every ladder ending where GMS's does.
#
# A guard blocks the whole hit, which is what dodge_chance is. The stun a guard
# causes is dropped.
name: "Shield Mastery"
description:
  "Increases Elemental Resistance, Abnormal Status Resistance, DEF, and "
  "Attack Power when a secondary weapon is equipped, and gives you a chance "
  "to guard."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 6 }
max_level: 20
requires_secondary: true
base {
  status_resistance: 2
  elemental_resistance: 0.02
  def_pct: 1.17
  attack: 1
  dodge_chance: 0.02
}
per_level {
  status_resistance: 2
  elemental_resistance: 0.02
  def_pct: 0.07
  attack: 1
  dodge_chance: 0.02
}
