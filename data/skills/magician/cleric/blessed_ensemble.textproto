# One level in GMS, worth 3% final damage for every Cleric in the party
# besides yourself, and 20% bonus EXP for each of them. There is no party
# here, so both are simply granted, spread over ten levels.
name: "Blessed Ensemble"
skill_order: 2
description: "Blessings increase your Final Damage and the EXP you earn."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_CLERIC
max_level: 10
base {
  final_dmg_pct: 0.003
  exp_pct: 0.02
}
per_level {
  final_dmg_pct: 0.003
  exp_pct: 0.02
}
