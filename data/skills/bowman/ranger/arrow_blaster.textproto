# GMS's 4 stands: the 120x120 hitbox travels along the platform, and the reach
# rule is for boxes that stay put (see Skill.max_enemies).
#
# The turret is a buff, not an auto mode: GMS places it mid-cast for 20+2x
# seconds, so the player pays the 800ms to place it again. An auto mode would
# fire all fight for free.
#
# Neither half uses attack speed: the volley is key-down and the turret a
# summon. So a Ranger gets nothing from Agile Bows, just as in GMS.
name: "Arrow Blaster"
description:
  "Shoot an arrow at a high angle, and set up an Arrow Blaster which fires "
  "arrows automatically."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_BOW
base_delay_ms: 120
fixed_delay: true
max_enemies: 4
hits_per_attack_count: 7
base { skill_pct: 1.24 }
per_level { skill_pct: 0.03 }
buff {
  duration_seconds: 22.0
  duration_seconds_per_level: 2.0
  own_cast_delay_ms: 800
  pulse {
    label: "Turret"
    cast_interval_seconds: 0.21
    max_enemies: 4
    base { skill_pct: 0.66 }
    per_level { skill_pct: 0.01 }
  }
}
