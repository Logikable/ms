# Twenty levels instead of GMS's fourteen, a point a level, ending at the same
# 30%. It multiplies with the character's other reductions instead of adding
# (see AddEffect).
name: "Achilles"
description:
  "Permanently increases your defensive abilities so you take less damage "
  "from enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 7 }
max_level: 20
base { damage_taken_pct: 0.11 }
per_level { damage_taken_pct: 0.01 }
