# GMS's version is Sharp Eyes - Persist, which lengthens the buff. Sharp Eyes is
# permanent here, so it is renamed for the DEF it gives instead.
#
# That DEF is worth nothing on purpose (see SkillEffect.def_pct). It stays with
# the archer: it is not GMS's grant, so GMS's party rule doesn't apply.
name: "Sharp Eyes - Bulwark"
description:
  "Grants Sharp Eyes a bonus to DEF."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 4 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 4 }
hyper: true
required_level: 140
max_level: 1
base { def: 1000 }
