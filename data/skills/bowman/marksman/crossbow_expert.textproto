# The line's mastery skill, with 20 levels instead of GMS's 30 but GMS's top
# figures: 70% mastery, +40 attack and 15% critical damage.
#
# It must not supersede Crossbow Mastery: masteries take the better of the two,
# not the sum, so this beats the Crossbowman's mastery while that skill keeps
# giving its attack speed.
name: "Crossbow Expert"
description: "Increases Crossbow Mastery, Attack Power, and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 7 }
max_level: 20
exceeds_master_level: true
required_equip_type: EQUIP_TYPE_CROSSBOW
required_skill {
  skill_name: "Crossbow Mastery"
  level: 10
}
base {
  mastery: 0.51
  attack: 2
  crit_dmg: 0.055
}
per_level {
  mastery: 0.01
  attack: 2
  crit_dmg: 0.005
}
