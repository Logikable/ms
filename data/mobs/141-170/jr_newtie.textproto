# The first mob of a band set on this game's curve instead of GMS's numbers.
# Leafre's dragon nests were made for an older era and sit a fifth under the
# curve. Every mob from here to 168 follows x1.053 HP, x1.038 EXP and x1.029
# attack per level, the shape the ladder has kept since level 98.
#
# HP rises by the same share as EXP, so EXP per HP stays GMS's. Raising EXP
# alone would have made these maps too cheap.
name: "Jr. Newtie"
level: 145
attack: 3391
max_hp: 1612800
exp: 8748
pdr: 10
drops { item: "egg_shell" per_kill: 0.4 }
drops { item: "frozen_weapon_token" per_kill: 0.0001 }
drops { item: "frozen_secondary_token" per_kill: 0.0001 }
drops { equip: "frozen_gloves" per_kill: 0.00025 }
drops { equip: "frozen_boots" per_kill: 0.00025 }
description: "A group of young dragons that live in the nest. The Jr. Newties cannot leave their nests, but they have the power to attack using a sound wave at a distance."
