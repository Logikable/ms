# GMS's own figures: 210+4x% three times over 20 levels, on one enemy. Single
# target is the whole point: GMS keeps it for bosses and Shuriken Challenge for
# everything else.
#
# 630ms is chosen, not measured: the frame database has no Hermit Triple Throw.
# Quad Star throws four stars in 660ms, so three is one tick less. It must be at
# least this fast to be worth using: at 660 the 30ms rounding makes the swing
# 510ms against Shuriken Challenge's 600, and it loses on one enemy as well as
# on eight.
name: "Triple Throw"
description: "Throw several throwing stars simultaneously."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_HERMIT skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_CLAW
base_delay_ms: 630
max_enemies: 1
lines: 3
base { skill_pct: 2.14 }
per_level { skill_pct: 0.04 }
