name: "Lotus"
page: 2
difficulties {
  # No Easy, since GMS has none.
  name: "Normal"
  phases {
    bgm: "Suu1phase"
    spawns {
      mob: "lotus_phase_1"
      spots { x: 4 y: 2 }
      # Every ~40s a shield of ~0.49% of his HP (namu: 1.58B on Normal's 321.4B,
      # 33.3B on Hard's 6.84T) for 20s; hits deal 10% while it holds (wiki), and
      # what is left heals him.
      self_shield {
        percent: 0.49
        interval_ms: 40000
        duration_ms: 20000
        damage_pct: 10
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu2phase"
    # GMS teleports to a random player every 8s (namu).
    spawns {
      mob: "lotus_phase_2"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP teleport { interval_ms: 8000 } }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu3phase"
    spawns {
      mob: "lotus_phase_3"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP teleport { interval_ms: 8000 } }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Meant to be cleared by a party rather than alone.
  time_limit_seconds: 900
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price, divided by seven (GMS clears him
  # once a week, this game once a day), rounded to the nearest 50k.
  meso: 23200000
  # GMS lists no EXP on any of the three bodies.
  exp: 0
  drops {
    item: "absolab_coin"
    per_kill: 0.5
  }
  drops {
    item: "lotuss_soul_shard"
    per_kill: 1.0
  }
}
