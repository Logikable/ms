# 600ms is GMS's `x`, the one number in its common block the tooltip never uses.
# `t`, the 0.6 seconds added per active Fervent Drain, confirms it: each stack
# buys one more strike.
#
# Twelve enemies stands: the client gives it no hitbox, so the stated cap is the
# reach.
#
# GMS's "only when Ifrit is summoned" is the required skill: summons here are
# permanent, but a book without Ifrit can't have this.
name: "Elemental Fury"
description:
  "Unleash the fury of flame in the form of an enraged spirit. Can only be "
  "used when Ifrit is summoned. Unaffected by attack reflection."
kind: SKILL_KIND_ACTIVE
tags: SKILL_TAG_FIRE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_skill {
  skill_name: "Ifrit"
  level: 20
}
base_delay_ms: 120
cooldown_seconds: 60.0
buff {
  duration_seconds: 3.0
  duration_seconds_per_dot: 0.6
  dot_count_cap: 5
  pulse {
    label: "Enraged Ifrit"
    cast_interval_seconds: 0.6
    lines: 6
    max_enemies: 12
    base { skill_pct: 2.08 }
    per_level { skill_pct: 0.08 }
  }
}
