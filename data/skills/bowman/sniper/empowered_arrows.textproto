# GMS maxes this at 10; stretched to 20 levels ending at the same pair.
name: "Empowered Arrows"
description:
  "Empowers certain attack skills as you use them. Enhances Piercing Arrow."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SNIPER skill_order: 1 }
max_level: 20
required_skill {
  skill_name: "Piercing Arrow"
  level: 20
}
boost {
  skill_name: "Piercing Arrow"
  effect { skill_pct: 1.02 }
  effect_per_level { skill_pct: 0.02 }
}
empowered_form {
  skill_name: "Piercing Arrow"
  casts_per_trigger: 4
  max_enemies: 8
  lines: 6
  base { skill_pct: 2.03 }
  per_level { skill_pct: 0.015 }
}
