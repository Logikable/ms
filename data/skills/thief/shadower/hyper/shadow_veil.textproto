# GMS's own figures: 800% on fifteen enemies, pulsing every 900ms for twelve
# seconds behind a 60-second wait. Thirteen strikes a cast.
#
# A veil hangs in a place and there is no place here, so it becomes a mark on
# what it caught -- Poison Mist's bargain exactly. The cast is the veil's first
# strike and the burn carries the other twelve, which is why its duration is
# 10.8s rather than GMS's 12.
#
# The stealth half is dropped: Advanced Dark Sight here is final damage and
# nothing else, so a better chance of it means nothing.
name: "Shadow Veil"
skill_order: 11
description:
  "Summons a dark ally to deal damage over time."
kind: SKILL_KIND_ATTACK
job_advancement: JOB_ADVANCEMENT_SHADOWER
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 690
max_enemies: 15
lines: 1
cooldown_seconds: 60.0
base { skill_pct: 8.00 }
dot {
  interval_seconds: 0.9
  duration_seconds: 10.8
  lines: 1
  base { skill_pct: 8.00 }
}
