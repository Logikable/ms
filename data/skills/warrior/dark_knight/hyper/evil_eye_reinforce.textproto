# GMS writes this "Damage: +150%", the %Damage stat, not points on a multiplier,
# so it adds to what the character's gear and passives give, and only these five
# swings get it.
#
# Five boosts because the eye's shout has five names across the line, and a
# boost names one skill. Revenge of the Evil Eye covers its own halves: Shock
# III and the Dark Auras share their parent's display name. Radiant Evil is the
# Dark Knight's V node, bought from the matrix.
name: "Evil Eye - Reinforce"
description:
  "Increases damage for Evil Eye of Domination, Evil Eye Shock, Revenge of "
  "the Evil Eye, and Radiant Evil."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 4 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Evil Eye Shock"
  effect { damage_pct: 1.50 }
}
boost {
  skill_name: "Evil Eye Shock II"
  effect { damage_pct: 1.50 }
}
boost {
  skill_name: "Evil Eye of Domination"
  effect { damage_pct: 1.50 }
}
boost {
  skill_name: "Revenge of the Evil Eye"
  effect { damage_pct: 1.50 }
}
boost {
  skill_name: "Radiant Evil"
  effect { damage_pct: 1.50 }
}
