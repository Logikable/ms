# The mastery skill, over 20 levels instead of GMS's 10 so the book costs the 90
# SP a magician's 2nd job levels give. Mastery goes from 12% to 50%, the same
# climb as every other 20-level mastery.
#
# Its other two levers are cut to fit the longer ladder: crit rate still ends at
# GMS's 5%, and magic attack is kept to a point a level.
name: "Spell Mastery"
description: "Increases Magic Mastery, Magic ATT and Critical Rate."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_WIZARD skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_WIZARD skill_order: 7 }
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 7 }
max_level: 20
base {
  mastery: 0.12
  magic_attack: 1
  crit_rate: 0.0025
}
per_level {
  mastery: 0.02
  magic_attack: 1
  crit_rate: 0.0025
}
