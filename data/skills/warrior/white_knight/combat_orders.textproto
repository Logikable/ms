# GMS gives this for eighty seconds at a time to the whole party. Nothing runs
# out here, so it is always up, on the White Knight and everyone with them.
#
# One level for most of the ladder and two at the top: a step, not a slope, so
# per_level holds a ninth, written with enough digits that rounding down lands
# on 2 at level 10. See SkillEffect.skill_level_bonus, and don't shorten the
# number.
#
# Only skills marked exceeds_master_level go past their max level with these
# levels; every other skill stops at its max.
name: "Combat Orders"
description:
  "Grants bonus skill levels to the skills of all party members, including "
  "yourself. 4th job skills that have already "
  "reached the master level can be raised further; other skills can only be "
  "increased to master level. Exceptions: Combat Orders, hyper skills, and "
  "5th job skills cannot be increased."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 4 }
exclusive_group: "Combat Orders"
max_level: 10
required_skill {
  skill_name: "HP Recovery"
  level: 5
}
base { skill_level_bonus: 1.0 }
per_level { skill_level_bonus: 0.11111111111 }
ally_base { skill_level_bonus: 1.0 }
ally_per_level { skill_level_bonus: 0.11111111111 }
