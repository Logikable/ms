# One level in GMS, worth 3% final damage for every Cleric in the party
# besides yourself. There is no party here, so the party is assumed: six
# players, and the skill spread over ten levels at what one of them is worth.
#
# The bonus EXP the other half of the skill grants is left out. It would pay
# the player for something the game has no way to do.
name: "Blessed Ensemble"
skill_order: 2
description: "Increases Final Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_CLERIC
max_level: 10
base { final_dmg_pct: 0.018 }
per_level { final_dmg_pct: 0.018 }
