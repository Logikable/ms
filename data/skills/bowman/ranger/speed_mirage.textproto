# GMS builds this over twelve strikes and then fires three afterimages at once.
# Here it is one afterimage every four, which comes to the same arrows at the
# same rate and needs no burst to model. "Pierces up to 5 enemies" is GMS's
# mobCount, the same field it words as "Max Enemies Hit" elsewhere -- five in
# total, the target among them.
#
# Counted in attacks rather than seconds so the rate holds whatever the
# character is swinging -- which is the whole point of Arrow Blaster counting a
# seventh. See Skill.hits_per_attack_count.
name: "Speed Mirage"
description:
  "Fire arrows fast enough to leave afterimages. After striking enemies with "
  "enough arrow-based attacks, creates afterimages that fire enemy-seeking "
  "arrows before vanishing. These arrows target a single enemy in front of "
  "the afterimage and damage any foes pierced on the way to the target."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 2 }
max_level: 20
max_enemies: 5
lines: 4
attacks_per_cast: 4
base { skill_pct: 3.25 }
per_level { skill_pct: 0.05 }
boost {
  skill_name: "Wind Arrow"
  effect { skill_pct: 0.51 }
  effect_per_level { skill_pct: 0.01 }
}
