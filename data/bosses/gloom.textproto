name: "Gloom"
page: 2
difficulties {
  # GMS's own level (255) is kept, fifteen over the gate.
  name: "Normal"
  phases {
    bgm: "FerociousBattlefield"
    spawns {
      mob: "gloom"
      spots { x: 4 y: 2 }
      giant: true
      # Its tentacles cover the eye, cutting hits to 1/10, but for the ~30s from
      # each strike to the end of the laser after it. A strike comes 55s after
      # the last, and at once at 70% and 40% HP (namu).
      guard {
        damage_pct: 10
        interval_ms: 55000
        open_ms: 30000
        hp_opens: 70
        hp_opens: 40
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    # The two tentacles each strike leaves, stood on as platforms until they
    # retract.
    timed_spots {
      follow_guard: true
      open_ms: 20000
      spots { x: 1 y: 4 }
      spots { x: 7 y: 4 }
      spots { x: 2 y: 3 }
      spots { x: 6 y: 3 }
      spots { x: 2 y: 1 }
      spots { x: 6 y: 1 }
      spots { x: 1 y: 0 }
      spots { x: 7 y: 0 }
    }
    arena_width: 9
    arena_height: 6
  }
  time_limit_seconds: 1200
  unlock_level: 240
  arcane_force: 730
  # Five Intense Power Crystals at GMS's price (59,535,000), divided by seven and
  # rounded to the nearest 50k.
  meso: 42550000
  # GMS lists no EXP on the body.
  exp: 0
  drops {
    item: "glooms_soul_shard"
    per_kill: 1.0
  }
  # Rate and pity are the user's (2026-11-24), the same at every difficulty.
  drops {
    equip: "estella_earrings"
    per_kill: 0.02
    pity: 10
  }
}
