# Twenty added to both halves of Advanced Blessing, for the Bishop and everyone
# with them. A plain grant, not a boost, for the same reason as Holy Symbol -
# Experience: the skill it names is a permanent passive, so this adds to the
# same total.
name: "Advanced Blessing - Ferocity"
description:
  "Increases the Attack Power and Magic ATT Advanced Blessing grants you and "
  "your party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
base {
  attack: 20
  magic_attack: 20
}
ally_base {
  attack: 20
  magic_attack: 20
}
