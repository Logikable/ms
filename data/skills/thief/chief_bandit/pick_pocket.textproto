# Rolled per line: GMS never says so, but four coins from one monster in one
# attack can't happen otherwise.
#
# A meso's value isn't modelled, and GMS doesn't state one either.
name: "Pick Pocket"
description: "Causes Mesos to drop when you attack with your skills."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CHIEF_BANDIT skill_order: 4 }
max_level: 10
base { meso_drop_chance: 0.12 }
per_level { meso_drop_chance: 0.02 }
