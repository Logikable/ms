# GMS's own figures: 800% on fifteen enemies, pulsing every 900ms for twelve
# seconds, on a 60-second cooldown. Thirteen strikes per cast.
#
# A veil hangs in one place and there are no places here, so it becomes a mark
# on what it caught, exactly like Poison Mist. The cast is the veil's first
# strike and the burn carries the other twelve, which is why it lasts 10.8s
# instead of GMS's 12.
#
# The stealth half is dropped: Advanced Dark Sight here is only final damage, so
# a better chance of it means nothing.
name: "Shadow Veil"
description:
  "Summons a dark ally to deal damage over time."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 11 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 690
max_enemies: 15
lines: 1
cooldown_seconds: 60.0
base { skill_pct: 8.00 }
dot {
  interval_seconds: 0.9
  duration_seconds: 10.8
  lines: 1
  base { skill_pct: 8.00 }
}
