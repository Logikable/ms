# GMS calls this Opportunity: a 20% chance of charging two orbs at once. Orbs
# are always full in this game, so that would be worth nothing, and rather than
# ship a row that does nothing while claiming something, it is renamed for the
# DEF it gives instead.
#
# That DEF is also worth nothing, on purpose: DEF stops paying at a share of the
# attacking monster's attack, and a Hero passes that cap on their stats alone.
# See SkillEffect.def_pct, useless by the same design.
name: "Advanced Combo Attack - Barricade"
description:
  "DEF increased for each additional Combo Orb."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 5 }
hyper: true
required_level: 150
max_level: 1
base { def_per_combo_orb: 100 }
