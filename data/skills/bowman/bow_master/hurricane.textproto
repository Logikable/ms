# The bossing swing: one arrow at one enemy, over and over, at a rate no
# weapon can hurry. 120ms is GMS's own figure for it, and `fixed_delay` is
# what a key-down skill is -- see Skill.fixed_delay.
#
# Seven of them count as one attack, exactly as Arrow Blaster's do. Without
# that a swing landing eight times a second would set off every counter in the
# book several times over.
#
# It reaches one enemy, so Arrow Stream wins any map with a crowd on it. What
# keeps this ahead on a lone target is that both Final Attacks roll once per
# SWING: eight rolls a second against Arrow Stream's two.
name: "Hurricane"
description:
  "Launch a tremendous volley of arrows, like a catastrophic rainstorm."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 1 }
max_level: 30
required_equip_type: EQUIP_TYPE_BOW
exceeds_master_level: true
base_delay_ms: 120
fixed_delay: true
hits_per_attack_count: 7
base { skill_pct: 2.63 }
per_level { skill_pct: 0.03 }
boost {
  skill_name: "Arrow Stream"
  effect { skill_pct: 0.50 }
}
