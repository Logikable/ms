name: "Horntail"
difficulties {
  name: "Normal"
  # Two heads fought one at a time before the dragon himself, as in GMS. Each
  # stands in the corner its name says, with the player between them at the
  # top of the arena and a row of clearance above.
  phases {
    spawns { mob: "horntail_left_head" count: 1 }
    spots { x: 7 y: 1 }
    player { x: 4 y: 1 }
    arena_width: 10
    arena_height: 4
  }
  phases {
    spawns { mob: "horntail_right_head" count: 1 }
    spots { x: 1 y: 1 }
    player { x: 4 y: 1 }
    arena_width: 10
    arena_height: 4
  }
  # The whole dragon at once, laid out the way his sprite is: three heads over
  # a pair of hands and the wings, the legs and the tail beneath them, and the
  # player on the floor to the left of all of it.
  phases {
    spawns { mob: "horntail_head_a" count: 1 }
    spawns { mob: "horntail_head_b" count: 1 }
    spawns { mob: "horntail_head_c" count: 1 }
    spawns { mob: "horntail_left_hand" count: 1 }
    spawns { mob: "horntail_wings" count: 1 }
    spawns { mob: "horntail_right_hand" count: 1 }
    spawns { mob: "horntail_legs" count: 1 }
    spawns { mob: "horntail_tails" count: 1 }
    spots { x: 2 y: 1 }
    spots { x: 4 y: 1 }
    spots { x: 6 y: 1 }
    spots { x: 1 y: 2 }
    spots { x: 4 y: 2 }
    spots { x: 7 y: 2 }
    spots { x: 4 y: 3 }
    spots { x: 6 y: 3 }
    player { x: 0 y: 3 }
    arena_width: 9
    arena_height: 4
  }
  reset: RESET_PERIOD_DAILY
  # Twice what the other two allow, and still out of reach at the level he
  # opens at: the field kills him in 10 to 29 minutes on the gear of the day.
  # What the clock is for is the player who comes back twenty levels later.
  time_limit_seconds: 600
  unlock_level: 140
  # Five Intense Power Crystals at what his level fetches, as Zakum's and
  # Hilla's meso is.
  meso: 5062500
  # GMS pays the EXP for the clear and says no boost touches it, so it is
  # here rather than on the eight bodies.
  exp: 4611597
  drops {
    item: "horntails_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "silver_blossom_ring"
    per_kill: 0.5
  }
  drops {
    equip: "horntail_necklace"
    per_kill: 0.5
  }
  drops {
    equip: "dea_sidus_earring"
    per_kill: 0.5
  }
}
