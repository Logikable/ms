# GMS's node 5 is Covering Fire and Swift Surge, neither of which exists here,
# and every other swing in the line is already spoken for. So Final Attack
# takes the page alone, at the 3% a level GMS pays node 5 rather than the 4%
# it pays sharing node 4 with High Speed Shot.
#
# Unlike the Bow Master's, this Final Attack supersedes nothing and is
# superseded by nothing, so it takes GMS's name directly.
name: "Final Attack: Crossbow Boost"
description: "Strengthens Final Attack: Crossbow."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 8 }
v_node: V_NODE_KIND_BOOST
max_level: 60
boost {
  skill_name: "Final Attack: Crossbow"
  effect { final_dmg_pct: 0.03 }
  effect_per_level { final_dmg_pct: 0.03 }
}
boost {
  skill_name: "Final Attack: Crossbow"
  min_level: 20
  effect { crit_rate: 0.05 }
}
boost {
  skill_name: "Final Attack: Crossbow"
  min_level: 40
  effect { ied_pct: 0.20 }
}
