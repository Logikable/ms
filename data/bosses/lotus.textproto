name: "Lotus"
difficulties {
  # No Easy, since GMS has none.
  name: "Normal"
  phases {
    bgm: "Suu1phase"
    spawns {
      mob: "lotus_phase_1"
      spots { x: 4 y: 2 }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu2phase"
    spawns {
      mob: "lotus_phase_2"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu3phase"
    spawns {
      mob: "lotus_phase_3"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Meant to be cleared by a party rather than alone.
  time_limit_seconds: 1500
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price, divided by seven (GMS clears him
  # once a week, this game once a day), rounded to the nearest 50k.
  meso: 23200000
  # GMS lists no EXP on any of the three bodies.
  exp: 0
  drops {
    item: "absolab_coin"
    per_kill: 1.0
  }
  drops {
    item: "lotuss_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  phases {
    bgm: "Suu1phase"
    spawns {
      mob: "hard_lotus_phase_1"
      spots { x: 4 y: 2 }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu2phase"
    spawns {
      mob: "hard_lotus_phase_2"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "Suu3phase"
    spawns {
      mob: "hard_lotus_phase_3"
      spots { x: 4 y: 4 }
      walk { interval_ms: 10000 range: RANGE_ROW_STEP }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 2 y: 2 }
    player_spots { x: 4 y: 2 }
    player_spots { x: 6 y: 2 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 1800
  unlock_level: 210
  # Five Intense Power Crystals at GMS's price (88,935,000), divided by seven and
  # rounded to the nearest 50k, as for Normal.
  meso: 63550000
  # GMS lists no EXP on any of the three bodies.
  exp: 0
  drops {
    item: "absolab_coin"
    per_kill: 1.0
  }
  drops {
    item: "lotuss_soul_shard"
    per_kill: 1.0
  }
  # GMS never published the boxes' odds. Unlike GMS, drop rate raises them.
  drops {
    item: "absolab_weapon_box"
    per_kill: 0.2
  }
  drops {
    item: "absolab_armor_box"
    per_kill: 0.2
  }
}
