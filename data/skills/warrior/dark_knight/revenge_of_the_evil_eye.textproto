# The Evil Eye counterattacks as the player attacks, once every 5 seconds, which
# for a character who never stops is its own clock.
#
# The auras reach 3 enemies where the volley reaches 10, so they can't be one
# attack. The aura heal is restated because this supersedes Shock II.
name: "Revenge of the Evil Eye"
description:
  "An Evil Eye counterattacks the enemy. Your deepened connection with the "
  "Evil Eye enhances Evil Eye Shock."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 6 }
max_level: 30
exceeds_master_level: true
supersedes_skill_name: "Evil Eye Shock II"
required_skill {
  skill_name: "Evil Eye Shock II"
  level: 20
}
max_enemies: 10
lines: 7
cast_interval_seconds: 5.0
base {
  skill_pct: 1.35
  regen_hp: 24
  regen_interval_seconds: 24.0
}
per_level { skill_pct: 0.06 }
auto_mode {
  label: "Shock III"
  cast_interval_seconds: 10.0
  max_enemies: 10
  lines: 7
  base { skill_pct: 3.40 }
  per_level { skill_pct: 0.10 }
}
auto_mode {
  label: "Dark Auras"
  cast_interval_seconds: 10.0
  max_enemies: 3
  lines: 20
  base { skill_pct: 2.20 }
  per_level { skill_pct: 0.07 }
}
