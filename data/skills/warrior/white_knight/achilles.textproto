# Twenty levels rather than GMS's fourteen, a point a level, ending on the same
# 30%. It multiplies with every other reduction the character carries rather
# than summing -- see AddEffect.
name: "Achilles"
skill_order: 6
description:
  "Blows that would have put you down land and stop there. Decreases the "
  "damage you take."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT
max_level: 20
base { damage_taken_pct: 0.11 }
per_level { damage_taken_pct: 0.01 }
