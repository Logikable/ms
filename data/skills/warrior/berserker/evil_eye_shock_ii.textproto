# Replaces Evil Eye Shock instead of adding to it; there is only ever one shout.
# GMS's client gives this skill no hitbox or animation of its own, only a
# restated copy of the base skill's parameters, and Grandis Library calls it an
# "Upgraded Passive" that "increases %Damage of attack".
#
# So the first three points really are a downgrade: level 1 here is 139% against
# a maxed Evil Eye Shock's 150%, and GMS ships that flaw. The stun and the
# 12-second clock are restated, since a superseded skill stops paying; the stun
# chance climbs to 90% at this skill's max.
#
# The aura heal is restated because this supersedes the skill that gave it, and
# is flat because it belongs to the EYE: a louder shout doesn't heal more.
name: "Evil Eye Shock II"
description: "Empowers Evil Eye Shock, increasing its damage."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BERSERKER skill_order: 4 }
max_level: 20
supersedes_skill_name: "Evil Eye Shock"
required_skill {
  skill_name: "Evil Eye Shock"
  level: 10
}
max_enemies: 10
lines: 6
cast_interval_seconds: 12.0
stun {
  duration_seconds: 5.0
  chance: 0.9
}
base {
  skill_pct: 1.39
  regen_hp: 24
  regen_interval_seconds: 24.0
}
per_level { skill_pct: 0.04 }
