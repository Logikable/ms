# GMS caps this at 30. Scaled to 20 levels landing on exactly GMS's level-30
# figures -- 70% mastery, 400 DEF, 40% critical rate, 22% critical damage, 30%
# ignored defence and 35% final damage -- so the book totals 200. The levels
# are coarser, the skill is no stronger.
#
# The critical damage is one line rather than three: GMS pays 7 + floor(L/3),
# which is 17% at its master, and 5% more for the weapon in hand -- and every
# weapon this skill works with was owed that 5%. Folded into the base, so the
# ladder climbs half a point a level and lands on 22%. What is left of the
# weapon bonuses is the blunt weapon's ignored defence, which is the only one
# that ever said anything about the weapon.
#
# The final damage is GMS's own (5+x at 30), which is the number to watch when
# the line is measured against the Dark Knight's Final Pact.
name: "High Paladin"
skill_order: 7
description:
  "Increases Weapon Mastery, DEF, Critical Rate, Critical Damage, Ignore "
  "Defense, and Final Damage through your extensive experience as a Paladin."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_PALADIN
max_level: 20
exceeds_master_level: true
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_BLUNT
required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
required_skill {
  skill_name: "Weapon Mastery"
  level: 10
}
base {
  mastery: 0.51
  def: 115
  crit_rate: 0.115
  crit_dmg: 0.125
  ied_pct: 0.167
  final_dmg_pct: 0.16
}
per_level {
  mastery: 0.01
  def: 15
  crit_rate: 0.015
  crit_dmg: 0.005
  ied_pct: 0.007
  final_dmg_pct: 0.01
}
weapon_bonus {
  required_equip_type: EQUIP_TYPE_TWO_HANDED_BLUNT
  effect { ied_pct: 0.10 }
}
