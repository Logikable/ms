# Reach cut from GMS's 8 to 5. Its hitbox is 360x190 -- one storey of a map,
# holding 5 monsters side by side -- so 8 is a cap GMS never fills and this
# fight would hit every time. See Skill.max_enemies.
#
# GMS pulls and stuns everything it hits. Neither is modelled -- the fight has
# no positions to pull across and no state for a mob to be stunned in -- so
# what is left is a wide, hard swing, which is most of what the skill is.
name: "Spear Sweep"
description: "Swing your spear in a long arc at the enemies around you."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SPEARMAN skill_order: 1 }
max_level: 20
required_equip_type: EQUIP_TYPE_SPEAR
required_equip_type: EQUIP_TYPE_POLEARM
base_delay_ms: 780
max_enemies: 5
lines: 4
base { skill_pct: 0.67 }
per_level { skill_pct: 0.02 }
