# A second Final Attack, as GMS's text describes: a chance of an extra arrow
# worth a multiple of a normal shot. Each source counts as its own chance times
# damage and the two are added, so written this way it combines with Final
# Attack: Bow instead of competing with it.
#
# GMS unlocks the arrowheads with a later skill and lets you switch between
# them. There is nothing to switch here, so only one arrowhead is kept, with
# levels.
#
# The arrow "pursues the enemy" and states no mobCount, so it lands on one enemy
# the swing reached, like Final Attack.
name: "Quiver Cartridge"
description: "Uses a special arrowhead."
kind: SKILL_KIND_PASSIVE
final_attack_max_enemies: 1
placement { job_advancement: JOB_ADVANCEMENT_HUNTER skill_order: 2 }
max_level: 10
final_attack_label: "Magic Arrow"
base {
  final_attack_chance: 0.12
  final_attack_pct: 1.21
}
per_level {
  final_attack_chance: 0.02
  final_attack_pct: 0.11
}
