# A summon that also raises DEF permanently. GMS marks that half "[Passive
# Effects: ...]" and attaches it to the active skill.
#
# 1.71 seconds isn't on the wiki. It is the delay the Korean DPM calculator uses
# for the summon, next to the damage figure for exactly level 10.
#
# The DEF it grants is useless by design, like every % DEF in the game (see
# SkillEffect.def_pct).
name: "Phoenix"
description:
  "Summons a Phoenix to deal Fire damage on its own. Permanently increases "
  "DEF."
kind: SKILL_KIND_AUTO_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 3 }
max_level: 10
max_enemies: 4
cast_interval_seconds: 1.71
base { skill_pct: 2.28 def_pct: 0.03 }
per_level { skill_pct: 0.18 def_pct: 0.03 }
