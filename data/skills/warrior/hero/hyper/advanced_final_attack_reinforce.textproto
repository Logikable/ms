# GMS's "Damage: +10%" is the %Damage stat. It targets a passive by name, which
# a boost normally can't reach: it boosts the extra hit (see SkillBoost.effect).
name: "Advanced Final Attack - Reinforce"
description:
  "Increases the damage of Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 7 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Advanced Final Attack"
  effect { damage_pct: 0.10 }
}
