# The client has an id per dash (400041002 through 400041003-5), and the 6th job
# boost raises the count from 4, which settles the tooltip's "2-4".
#
# One press uses all four dashes, spaced by `cast_interval_ms` so each hits the
# crowd as it then is.
name: "Shadow Assault"
description: "Instantly move to slash enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 1 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 1680
cooldown_seconds: 60.0
max_enemies: 12
lines: 6
casts: 4
cast_interval_ms: 420
base {
  skill_pct: 7.40
  crit_rate: 0.25
  ied_pct: 1.00
}
per_level { skill_pct: 0.20 }
