name: "Pink Bean"
difficulties {
  name: "Normal"
  # The five statues, spread evenly across the arena. Ariel stands a row over
  # the other four, which is the arch his room is built as: the statue worth
  # three of the others is the one out of reach.
  phases {
    spawns { mob: "solomon_the_wise" spots { x: 0 y: 3 } }
    spawns { mob: "hugin" spots { x: 2 y: 3 } }
    spawns { mob: "ariel" spots { x: 4 y: 2 } }
    spawns { mob: "munin" spots { x: 6 y: 3 } }
    spawns { mob: "rex_the_wise" spots { x: 8 y: 3 } }
    # The floor under the statues, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  # The bean himself, alone in the middle of the same room, low over the floor.
  phases {
    spawns { mob: "pink_bean" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # What Horntail and Magnus allow. The statues are 73% of the fight and the
  # gate is ten levels over them, so the clock is on the room rather than on
  # the bean.
  time_limit_seconds: 600
  # The first gate that opens before the fight is comfortable: at 170 the
  # Shadower misses the clock, and the Paladin and the Bow Master make it with
  # seconds to spare. Ten levels later all ten branches clear inside 7:20.
  unlock_level: 170
  # Five Intense Power Crystals at what his level fetches, as every boss's
  # meso is.
  meso: 7022500
  # Paid for the clear, flat and untouched by any EXP bonus, as the other four
  # are. The five statues are worth 3,300,000 of it and the bean 6,290,000.
  exp: 9590000
  drops {
    equip: "black_bean_mark"
    per_kill: 1.0
  }
  drops {
    equip: "golden_clover_belt"
    per_kill: 1.0
  }
  drops {
    equip: "pink_holy_cup"
    per_kill: 1.0
  }
  drops {
    item: "pink_beans_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Chaos"
  # The same five statues, standing where Normal's do and behind 160% PDR
  # apiece: the room is the Ignore DEF gate and the bean behind it is not.
  phases {
    spawns { mob: "chaos_solomon_the_wise" spots { x: 0 y: 3 } }
    spawns { mob: "chaos_hugin" spots { x: 2 y: 3 } }
    spawns { mob: "chaos_ariel" spots { x: 4 y: 2 } }
    spawns { mob: "chaos_munin" spots { x: 6 y: 3 } }
    spawns { mob: "chaos_rex_the_wise" spots { x: 8 y: 3 } }
    # The floor under the statues, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "chaos_pink_bean" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Fifteen minutes, as every fight past Cygnus has.
  time_limit_seconds: 900
  # The level cap, where everything from here to Seren opens.
  unlock_level: 200
  # Five Intense Power Crystals at what GMS prices his, divided by seven: GMS
  # clears him once a week and this game once a day.
  meso: 9150000
  # What Normal pays. GMS gives the Chaos bean the same body EXP as the normal
  # one, so the rung buys gear and a purse rather than a climb.
  exp: 9590000
  # The same four Normal drops. Chaos adds nothing of its own in GMS either.
  drops {
    equip: "black_bean_mark"
    per_kill: 1.0
  }
  drops {
    equip: "golden_clover_belt"
    per_kill: 1.0
  }
  drops {
    equip: "pink_holy_cup"
    per_kill: 1.0
  }
  drops {
    item: "pink_beans_soul_shard"
    per_kill: 1.0
  }
}
