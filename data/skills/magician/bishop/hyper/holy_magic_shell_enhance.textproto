# GMS raises what the shell takes off the attacks it can't block; a boss's hit
# stands in for those here.
name: "Holy Magic Shell - Enhance"
description:
  "Increases Holy Magic Shell's damage reduction rate against attacks that "
  "deal damage in proportion to Max HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 6 }
hyper: true
required_level: 180
max_level: 1
boost {
  skill_name: "Holy Magic Shell"
  shield_boss_damage_taken_pct: 0.05
}
