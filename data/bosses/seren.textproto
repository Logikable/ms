name: "Chosen Seren"
page: 3
difficulties {
  name: "Normal"
  phases {
    bgm: "AwakeningOfOldGod"
    spawns {
      mob: "seren_phase_1"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "SolarDeity-NoonOfJustice"
    # GMS's clock: 120s Noon, 130s Dusk, 40s Midnight and 130s Dawn, from Noon
    # (namu.wiki). GMS shrinks Midnight as players are cursed; nothing here
    # curses.
    sacred_power: 200
    forms { name: "Noon" seconds: 120 hp_bar: HP_BAR_COLOR_GOLD bgm: "SolarDeity-NoonOfJustice" }
    forms { name: "Dusk" seconds: 130 hp_bar: HP_BAR_COLOR_ORANGE bgm: "SolarDeity-TwilightOfFlame" }
    forms { name: "Midnight" seconds: 40 hp_bar: HP_BAR_COLOR_BLUE bgm: "SolarDeity-MidnightOfSilence" }
    forms { name: "Dawn" seconds: 130 hp_bar: HP_BAR_COLOR_VIOLET bgm: "SolarDeity-DawnOfHope" }
    spawns {
      mob: "seren_phase_2"
      spots { x: 4 y: 4 }
      walk {
        interval_ms: 10000
        range: RANGE_ROW_STEP
        dash { interval_ms: 30000 cells: 4 step_ms: 120 }
      }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 1200
  unlock_level: 260
  # GMS asks 150 of phase 1 and 200 of phase 2, at every difficulty.
  sacred_power: 150
  # Five Intense Power Crystals at GMS's price (177,804,375), divided by seven
  # and rounded to the nearest 50k.
  meso: 127000000
  sol_erda_energy: 150
  # GMS lists no EXP on the body.
  exp: 0
  drops {
    item: "serens_soul_shard"
    per_kill: 1.0
  }
  # GMS never published the odds. Dawn is tier 2: 1/10 days x 2, split with
  # Verus Hilla.
  drops {
    equip: "daybreak_pendant"
    per_kill: 0.1
  }
  # Seren is a tier 4 boss: the tier 3 2% over 40 days instead of 20.
  drops {
    item: "black_jade_boss_ring_box"
    per_kill: 0.01
  }
  # The scroll rates are the user's (2026-10-04); GMS publishes none.
  drops {
    item: "premium_scroll_for_accessory"
    per_kill: 0.5
  }
  drops {
    item: "premium_scroll_for_pet"
    per_kill: 0.5
  }
  drops {
    item: "magical_scroll_for_weapon"
    per_kill: 0.1
  }
}
