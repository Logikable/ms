# Only GMS's bullets are kept: this game doesn't value the damage reduction, so
# no double is ever used up, and the 50-second wait and cap of two go.
#
# One enemy per bullet: GMS states no mobCount and the hitbox is empty, (-20,0)
# to (0,0), so the reach rule has nothing to work with.
name: "Silhouette Mirage"
description:
  "Evades enemy attacks by moving fast enough to create illusory doubles of "
  "yourself. Illusory doubles disperse the enemy's attention to inflict "
  "damage on the enemy. Illusory doubles are unaffected by attack reflection."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
auto_mode {
  label: "Illusory Bullets"
  cast_interval_seconds: 7.5
  casts: 5
  lines: 3
  max_enemies: 1
  base { skill_pct: 8.00 }
  per_level { skill_pct: 0.30 }
}
