# GMS puts this on a 12-second cooldown, which for a skill worth firing every
# time it comes back is the same thing as a cast interval -- so that is what it
# becomes here. The stun it also lands is not modelled.
name: "Evil Eye Shock"
description:
  "Your Evil Eye appears and shouts, striking up to ten nearby enemies six "
  "times over. Fights on its own while you swing."
kind: SKILL_KIND_AUTO_ATTACK
job_advancement: JOB_ADVANCEMENT_SPEARMAN
max_level: 10
max_enemies: 10
lines: 6
cast_interval_seconds: 12.0
base { skill_pct: 1.23 }
per_level { skill_pct: 0.03 }
