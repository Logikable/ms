# Cast instead of a swing when the character's HP drops low, exactly like the
# Cleric's Heal (see kHealBelowFraction in fight.cc). GMS's own figures, 20 +
# 3L% of HP, topping out at half instead of the Cleric's full heal.
#
# The penalty for recasting it soon after is dropped: the user asked for it out,
# and a fight paid in expected damage has no clock to apply it to.
name: "HP Recovery"
description: "Instantly recovers your HP."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 2 }
max_level: 10
base_delay_ms: 720
base { heal_pct: 0.23 }
per_level { heal_pct: 0.03 }
