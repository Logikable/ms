# The follow-up shot, written as a swing of its own. GMS offers it during
# Piercing Arrow, Snipe, High Speed Shot and the cartridge, as a window the
# player presses in, and the fight has no such windows: a swing here is picked
# by rate and lands whole. What is left is the cooldown, which is what really
# paces it.
#
# Twelve strikes twice, not twenty-four: GMS states a Strike Count beside the
# attack count, and it fires two bundles of twelve.
#
# The client has no hitbox for it, so the stated ten stands, as with Storm of
# Arrows, where a missing hitbox means the count is the reach.
name: "Surge Bolt"
description:
  "Concentrate and deploy a powerful spirit arrow."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_CROSSBOW
base_delay_ms: 480
cooldown_seconds: 20.0
max_enemies: 10
lines: 12
casts: 2
base {
  skill_pct: 9.10
  ied_pct: 0.50
  crit_rate: 1.0
}
per_level { skill_pct: 0.35 }
