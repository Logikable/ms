# The beat is `subTime 990`, the one number in the block the tooltip never uses.
#
# The seven fixed stars fire every tick, not only at the start: namu says so,
# and firing them once gives 1,013%/s, far below the balance range.
#
# The 30% belongs to the scroll. On the buff it would be a character-wide boss
# bonus for twelve seconds, a much stronger skill.
#
# Detonating it early needs a position, so it is dropped.
name: "Dark Lord's Omen"
description: "Unleash the power of the Dark Lord's insight."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD_V skill_order: 3 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 60.0
buff {
  duration_seconds: 12.0
  pulse {
    label: "Throwing Stars"
    cast_interval_seconds: 0.99
    lines: 6
    max_enemies: 7
    max_pulses: 12
    base {
      skill_pct: 7.27
      boss_pct: 0.30
    }
    per_level { skill_pct: 0.27 }
    fixed_strikes { hits: 7 }
    final_strike {
      label: "Explosion"
      lines: 12
      max_enemies: 12
      base { skill_pct: 16.32 }
      per_level { skill_pct: 0.62 }
    }
  }
}
