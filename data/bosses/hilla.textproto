name: "Hilla"
difficulties {
  name: "Normal"
  # One phase, one monster: she stands alone in the middle of the arena with
  # the player under her, and there is nothing else to kill.
  phases {
    spawns { mob: "hilla" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 300
  unlock_level: 130
  # What GMS pays as an Intense Power Crystal, the same drop nobody keeps that
  # Zakum's meso stands in for: five of them at the price her level fetches.
  meso: 4000000
  # Paid for the clear, flat and untouched by any EXP bonus, as Zakum's and
  # Horntail's are.
  exp: 5820000
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "stone_of_eternal_life"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  # The same lone fight at the numbers GMS gives Hard, and the only body in the
  # game standing behind 100% PDR.
  phases {
    spawns { mob: "hard_hilla" spots { x: 4 y: 4 } }
    # The floor under the boss, walked end to end.
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twice what Normal allows, as every fight past the level-160 gate has.
  time_limit_seconds: 600
  unlock_level: 190
  # Five Intense Power Crystals at what her level fetches, as every boss's
  # meso is -- divided by seven, because GMS prices hers as a week's clear and
  # she is fought here once a day.
  meso: 8050000
  # Paid for the clear, flat and untouched by any EXP bonus.
  exp: 20400000
  drops {
    equip: "will_o_the_wisps"
    per_kill: 1.0
  }
  # The same shard Normal drops: a soul belongs to the boss, not to the rung
  # the player took her at.
  drops {
    item: "hillas_soul_shard"
    per_kill: 1.0
  }
}
