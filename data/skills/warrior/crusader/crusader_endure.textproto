# GMS maxes this at 14 and ends at +30 of each. Stretched over 20 levels to the
# same place, starting at 11 instead of the Berserker's 1: the Hero line's
# version is the stronger one.
#
# Nothing in this game inflicts a status or deals elemental damage, so this
# gives nothing yet. Written in full anyway: the figures belong with the skill,
# and the stats page shows both rows.
name: "Endure"
description:
  "Enhances your Abnormal Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 7 }
max_level: 20
base {
  status_resistance: 11
  elemental_resistance: 0.11
}
per_level {
  status_resistance: 1
  elemental_resistance: 0.01
}
