# The party half is the client's own reading. GMS stores this hyper's 5% in its
# OWN block with no psd flag and no target skill, which is the shape reserved
# for a value folded into the Sharp Eyes buff -- unlike the Arrow Stream and
# Hurricane hypers below, every one of which carries psd and names the skill it
# strengthens. What rides the buff reaches whoever the buff reaches.
#
# GMS states the party on Sharp Eyes's own page rather than here, so the clause
# is written rather than deleted down to.
name: "Sharp Eyes - Guardbreak"
skill_order: 5
description:
  "Grants Sharp Eyes a bonus to Enemy DEF Ignored. Applies to party members."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_BOW_MASTER
hyper: true
required_level: 150
max_level: 1
base { ied_pct: 0.05 }
ally_base { ied_pct: 0.05 }
