# The book's mastery skill, on the ladder every 4th job uses: 51% at level 1 to
# 70% at 20. GMS gives 10+x attack and 5+floor(x/3)% critical damage over 30
# levels; here it has twenty, so attack rises a point a level and critical
# damage climbs from GMS's 5% to 15% over this book's levels.
name: "Dagger Expert"
description: "Increases Dagger Mastery, Attack Power, and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 10 }
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Dagger Mastery"
  level: 10
}
base {
  mastery: 0.51
  attack: 21
  crit_dmg: 0.055
}
per_level {
  mastery: 0.01
  attack: 1
  crit_dmg: 0.005
}
