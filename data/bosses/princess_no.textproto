name: "Princess No"
difficulties {
  name: "Normal"
  # GMS hangs the Eight Trigrams above her, so the floor isn't the only place to
  # stand.
  phases {
    bgm: "Hieijan_nohime"
    spawns { mob: "princess_no" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 8 y: 3 }
    player_spots { x: 1 y: 1 }
    player_spots { x: 7 y: 1 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Fifteen minutes would be a limit nobody beats.
  time_limit_seconds: 1200
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price, divided by seven, since GMS
  # clears her once a week and this game once a day.
  meso: 11550000
  # GMS's own figure: she is fought for the set, not for levels.
  exp: 90000000
  # The whole set in one clear, as GMS drops it.
  drops {
    equip: "kannas_treasure"
    per_kill: 1.0
  }
  drops {
    equip: "ayames_treasure"
    per_kill: 1.0
  }
  drops {
    equip: "hayatos_treasure"
    per_kill: 1.0
  }
  drops {
    item: "princess_nos_soul_shard"
    per_kill: 1.0
  }
  # Fifteen buy a secondary, two weeks of clears: the price the Root Abyss
  # pieces ask for a Fafnir weapon.
  drops {
    item: "captivating_fragment"
    per_kill: 1.0
  }
}
