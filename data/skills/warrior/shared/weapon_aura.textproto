# GMS's aura is an active: 100 HP, up for 70 + 2x seconds on a 120-second
# cooldown. The cooldown is shorter than the duration at every level, so a
# player who uses it keeps it up permanently, which is what a passive is. The HP
# cost goes with the cast that no longer happens.
#
# Both levers are x/5 in GMS, one rounded down and one up: 10 + floor(x/5)%
# Ignore DEF and ceil(x/5)% final damage. Written without the rounding, that is
# a fifth of a point a level on each, so max level lands exactly on GMS's 16%
# and 6% and only the start moves.
#
# The wave is 500 + 20x%, six lines on ten enemies, on its own five-second
# clock. GMS makes as many waves as the triggering skill has lines and pays a
# share of that skill's damage; a flat wave on a clock is the same from the
# fight's side, since a 5th job warrior is always attacking.
name: "Weapon Aura"
description:
  "Infuses your weapon with a portion of your health, granting it a visible "
  "aura and empowering it."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_V skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 6 }
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_V skill_order: 6 }
v_node: V_NODE_KIND_ARCHETYPE
max_level: 30
base {
  ied_pct: 0.102
  final_dmg_pct: 0.002
}
per_level {
  ied_pct: 0.002
  final_dmg_pct: 0.002
}
auto_mode {
  label: "Aura Wave"
  cast_interval_seconds: 5.0
  max_enemies: 10
  lines: 6
  base { skill_pct: 5.20 }
  per_level { skill_pct: 0.20 }
}
