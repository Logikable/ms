# A timed party buff in GMS: 5+x attack, 5+x magic attack and 30x DEF. Nothing
# runs out here, so it is always up, on the Cleric and everyone with them, who
# are the ones GMS casts it on.
#
# This is all the Cleric's magic attack: they have no Meditation, so where the
# other magicians end at +30 this ends at +15. It also gives attack because GMS
# does, though magicians attack with the other number.
name: "Bless"
description:
  "Increases the Attack Power, Magic ATT, and Defense of you and nearby party "
  "members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CLERIC skill_order: 4 }
exclusive_group: "Blessing"
max_level: 10
required_skill {
  skill_name: "Invincible"
  level: 5
}
base {
  attack: 6
  magic_attack: 6
  def: 30
}
per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
ally_base {
  attack: 6
  magic_attack: 6
  def: 30
}
ally_per_level {
  attack: 1
  magic_attack: 1
  def: 30
}
