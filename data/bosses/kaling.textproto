      room { x: 9 width: 9 }
    }
    # Spring of Lost Vitality.
    zones {
      spots: [16, 17, 18, 19, 20, 21, 22, 23, 24]
      room { x: 18 width: 9 }
    }
    arena_width: 27
    arena_height: 6
  }
  phases {
    # Winter of Lost Faith (client map 410007260): the floor, three low
    # platforms and two high ones over their gaps, on even columns.
    bgm: "FadedWinter"
    spawns {
      mob: "extreme_kaling_phase_2"
      spots { x: 4 y: 0 }
      walk { interval_ms: 4000 range: RANGE_ABOVE_PLAYER }
    }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 0 y: 3 }
    player_spots { x: 2 y: 3 }
    player_spots { x: 4 y: 3 }
    player_spots { x: 6 y: 3 }
    player_spots { x: 8 y: 3 }
    player_spots { x: 2 y: 1 }
    player_spots { x: 6 y: 1 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    # Four Seasons of Death (client map 410007300): one floor in three zones, each
    # Peril still over its own (GMS: Qiongqi left, Hundun centre, Taowu
    # right), and Kaling on the top row over whoever she hunts. Only a zone's
    # players reach its Peril; anyone reaches Kaling, who holds at each
    # quarter until another Peril falls.
    bgm: "RuinationOfFourSeasons"
    placement: ZONE_PLACEMENT_PAIRS
    spawns {
      mob: "extreme_frenzied_kaling"
      spots { x: 4 y: 1 }
      walk { interval_ms: 4000 range: RANGE_OVER_PLAYER }
      hp_steps: [75, 50, 25]
      hp_dividers: [25, 50, 75]
    }
    spawns {
      mob: "extreme_death_gripped_taowu"
      zone: 1
      spots { x: 7 y: 3 }
      hp_bars: HP_BAR_COLOR_TEAL
    }
    spawns {
      mob: "extreme_death_gripped_hundun"
      zone: 2
      spots { x: 4 y: 3 }
      hp_bars: HP_BAR_COLOR_PURPLE
    }
    spawns {
      mob: "extreme_death_gripped_qiongqi"
      zone: 3
      spots { x: 1 y: 3 }
      hp_bars: HP_BAR_COLOR_AMBER
    }
    # Two spots to a zone, so a Peril never has more than a pair on it.
    player_spots { x: 3 y: 5 }
    player_spots { x: 5 y: 5 }
    player_spots { x: 6 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 2 y: 5 }
    # Taowu's zone, then Hundun's, then Qiongqi's.
    zones { spots: [2, 3] }
    zones { spots: [0, 1] }
    zones { spots: [4, 5] }
    arena_width: 9
    arena_height: 6
  }
}
