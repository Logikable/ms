# 35 + floor(L/2)% and 6 + L%, straight from GMS. The ignored defence pays
# against a boss and nowhere else: no map mob sets any physical defence, so a
# player farming sees only the final damage.
name: "Armor Break"
description:
  "Pierces the enemy's defenses with the sharpness of a bowman that sees "
  "through the enemy's weakness, and increases Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 10 }
max_level: 10
exceeds_master_level: true
base {
  ied_pct: 0.355
  final_dmg_pct: 0.07
}
per_level {
  ied_pct: 0.005
  final_dmg_pct: 0.01
}
