# GMS gives this to the caster only, while Holy Symbol itself covers the party.
# So it is a plain grant, not a boost: it adds to the same total the named skill
# pays into, and the two simply add.
name: "Holy Symbol - Experience"
description: "Increases your EXP earned when using Holy Symbol."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 7 }
hyper: true
required_level: 140
max_level: 1
base { exp_pct: 0.20 }
