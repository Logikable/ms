# All of it is damage_taken_pct at 1.00 (see BuffOption::damage_taken_pct).
#
# GMS doesn't allow invincibility skills in a skill sequence, so this would
# really play its 900ms; it still costs the flat 120ms, since one cast every 300
# seconds isn't worth a way to express it.
name: "Sacrosanctity"
description:
  "Call upon the heavens to protect you from all attacks for a short time."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 300.0
buff {
  duration_seconds: 30.0
  base { damage_taken_pct: 1.00 }
}
