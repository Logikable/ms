# GMS climbs ceil(L/4)% per orb, a staircase base + per_level cannot walk.
# Straightened to a quarter of a percent a level, which ends where the
# staircase does: 5% an orb, 25% with the ring full.
#
# The orbs are Combo Attack's and stay Combo Attack's -- this skill prices them
# and does not count them, so raising the count later is one edit.
name: "Combo Synergy"
skill_order: 3
description:
  "Every orb you carry leans into the blow. Increases Final Damage for each "
  "Combo Orb."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_CRUSADER
max_level: 20
base { final_dmg_pct_per_combo_orb: 0.0025 }
per_level { final_dmg_pct_per_combo_orb: 0.0025 }
