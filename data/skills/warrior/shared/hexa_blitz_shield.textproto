# GMS's HEXA node (500001015) is only the shield and can't detonate; its
# damage is a strike on every landed direct attack (500001016/18/20, a 1.8s
# cooldown), made a passive here. Nothing here spends HP, so the shield goes.
#
# The strike runs on its own 1.8s clock, as Weapon Aura's wave does: the same
# from the fight's side, since a 6th job warrior is always attacking.
name: "HEXA Blitz Shield"
description:
  "Harnesses your own Lifeforce. An ethereal blade slashes enemies when an "
  "attack lands. Unaffected by attack reflection."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO_VI skill_order: 9 }
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_VI skill_order: 9 }
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT_VI skill_order: 9 }
hexa_node: HEXA_NODE_KIND_ARCHETYPE
max_level: 30
required_skill { skill_name: "Blitz Shield" level: 30 }
supersedes_skill_name: "Blitz Shield"
auto_mode {
  label: "Ethereal Blade"
  cast_interval_seconds: 1.8
  max_enemies: 15
  lines: 6
  base { skill_pct: 0.63 }
  per_level { skill_pct: 0.14 }
}
line_overrides {
  line: JOB_PAGE
  skill {
    description:
      "Harnesses your own Lifeforce. Smashes the Hammer of Light down on "
      "enemies when an attack lands. Unaffected by attack reflection."
    auto_mode {
      label: "Hammer of Light"
      cast_interval_seconds: 1.8
      max_enemies: 15
      lines: 6
      base { skill_pct: 1.48 }
      per_level { skill_pct: 0.28 }
    }
  }
}
line_overrides {
  line: JOB_SPEARMAN
  skill {
    description:
      "Harnesses your own Lifeforce. Accelerates the spear of darkness to "
      "pierce through enemies when the attack lands. Unaffected by attack "
      "reflection."
    auto_mode {
      label: "Spear of Darkness"
      cast_interval_seconds: 1.8
      max_enemies: 15
      lines: 6
      base { skill_pct: 1.12 }
      per_level { skill_pct: 0.24 }
    }
  }
}
