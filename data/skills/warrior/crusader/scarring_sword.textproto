# The skill Chance Attack depends on, and the only thing in the game that scars
# a monster. GMS calls it piercing the enemy; the word here comes from the
# sword, since "pierce" already means an arrow going through a row of enemies.
#
# GMS runs it for 80 + 6*L seconds for an MP cost, with nothing stopping the
# player recasting it straight away, so it is simply always up, like every buff
# of that kind. The levels buy the chance each line scars its target, which
# reaches 100% at max.
#
# Its accuracy half is dropped: this game has no accuracy. What is left is the
# attack reduction, which works like any other and adds to the character's
# others (see SkillEffect.enemy_attack_pct).
name: "Scarring Sword"
description:
  "Infuses the sword with spirit, which leaves an indelible scar on the "
  "enemy, weakening its attacks."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 5 }
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
base {
  scar_chance: 0.43
  scar_seconds: 20.0
  enemy_attack_pct_when_scarred: 0.11
}
per_level {
  scar_chance: 0.03
  enemy_attack_pct_when_scarred: 0.01
}
