# GMS's own: 670% eight times on 15 enemies, once a minute. The delay is ours,
# like Megiddo Flame's: 660ms is what every other cast in this book takes.
#
# GMS also gives the party a buff that saves them from one killing blow, with
# its own ten-minute cooldown. Dropped: nothing here survives a hit it wasn't
# going to survive, and it would only matter against a boss that kills the
# player outright, which doesn't exist yet.
name: "Heaven's Door"
description: "Knocks on the door to the heavens to punish enemies."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 2 }
hyper: true
required_level: 160
max_level: 1
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
max_enemies: 15
lines: 8
cooldown_seconds: 60.0
base { skill_pct: 6.70 }
