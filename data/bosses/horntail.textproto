name: "Horntail"
difficulties {
  name: "Normal"
  # Two heads fought one at a time before the dragon himself, as in GMS. Each
  # stands at the edge its name says, at the top of the arena, with the player
  # at that same end rather than in the middle.
  phases {
    bgm: "CaveOfHontale"
    spawns { mob: "horntail_left_head" spots { x: 8 y: 0 } }
    # Three along the top and three along the bottom, running from under the
    # head out across the floor.
    player_spots { x: 6 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 6 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 5 y: 0 }
    player_spots { x: 5 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "horntail_right_head" spots { x: 0 y: 0 } }
    # The same six, mirrored, since this head is in the other corner.
    player_spots { x: 2 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 2 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 3 y: 0 }
    player_spots { x: 3 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  # The whole dragon at once, laid out like his sprite: three heads above a pair
  # of hands and the wings, with the legs and tail below them, and the player on
  # the floor to the left.
  phases {
    bgm: "HonTale"
    spawns { mob: "horntail_head_a" spots { x: 2 y: 0 } }
    spawns { mob: "horntail_head_b" spots { x: 4 y: 0 } }
    spawns { mob: "horntail_head_c" spots { x: 6 y: 0 } }
    spawns { mob: "horntail_left_hand" spots { x: 2 y: 2 } }
    spawns { mob: "horntail_wings" spots { x: 4 y: 2 } }
    spawns { mob: "horntail_right_hand" spots { x: 6 y: 2 } }
    spawns { mob: "horntail_legs" spots { x: 4 y: 4 } }
    spawns { mob: "horntail_tails" spots { x: 6 y: 4 } }
    # Down both edges of the arena, level with the heads, hands and legs: the
    # dragon fills the middle, so the player goes around him.
    player_spots { x: 0 y: 4 }
    player_spots { x: 0 y: 0 }
    player_spots { x: 8 y: 0 }
    player_spots { x: 0 y: 2 }
    player_spots { x: 8 y: 2 }
    player_spots { x: 8 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # Twice what the other two allow, and still out of reach at his unlock level:
  # the field kills him in 10 to 29 minutes with the gear available then. The
  # time limit is for the player who comes back twenty levels later.
  time_limit_seconds: 600
  unlock_level: 150
  # Five Intense Power Crystals at his level's price, like Zakum's and Hilla's
  # meso.
  meso: 5062500
  # GMS pays the EXP for the clear and says no bonus affects it, so it is here
  # rather than on the eight bodies.
  exp: 4611597
  drops {
    item: "horntails_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "silver_blossom_ring"
    per_kill: 1.0
  }
  drops {
    equip: "horntail_necklace"
    per_kill: 1.0
  }
  drops {
    equip: "dea_sidus_earring"
    per_kill: 1.0
  }
}
# The same three phases at GMS's Chaos numbers: 26.6B across the fight, every
# part behind 50% PDR.
difficulties {
  name: "Chaos"
  phases {
    bgm: "CaveOfHontale"
    spawns { mob: "chaos_horntail_left_head" spots { x: 8 y: 0 } }
    # Three along the top and three along the bottom, running from under the
    # head out across the floor.
    player_spots { x: 6 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 6 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 5 y: 0 }
    player_spots { x: 5 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    spawns { mob: "chaos_horntail_right_head" spots { x: 0 y: 0 } }
    # The same six, mirrored, since this head is in the other corner.
    player_spots { x: 2 y: 0 }
    player_spots { x: 4 y: 0 }
    player_spots { x: 2 y: 4 }
    player_spots { x: 4 y: 4 }
    player_spots { x: 3 y: 0 }
    player_spots { x: 3 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  phases {
    bgm: "HonTale"
    spawns { mob: "chaos_horntail_head_a" spots { x: 2 y: 0 } }
    spawns { mob: "chaos_horntail_head_b" spots { x: 4 y: 0 } }
    spawns { mob: "chaos_horntail_head_c" spots { x: 6 y: 0 } }
    spawns { mob: "chaos_horntail_left_hand" spots { x: 2 y: 2 } }
    spawns { mob: "chaos_horntail_wings" spots { x: 4 y: 2 } }
    spawns { mob: "chaos_horntail_right_hand" spots { x: 6 y: 2 } }
    spawns { mob: "chaos_horntail_legs" spots { x: 4 y: 4 } }
    spawns { mob: "chaos_horntail_tails" spots { x: 6 y: 4 } }
    # Down both edges of the arena, level with the heads, hands and legs: the
    # dragon fills the middle, so the player goes around him.
    player_spots { x: 0 y: 4 }
    player_spots { x: 0 y: 0 }
    player_spots { x: 8 y: 0 }
    player_spots { x: 0 y: 2 }
    player_spots { x: 8 y: 2 }
    player_spots { x: 8 y: 4 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # The same as every fight past the level-160 gate.
  time_limit_seconds: 600
  unlock_level: 190
  # Five Intense Power Crystals at GMS's price for Chaos Horntail, like every
  # boss's meso. Much less than Arkarium's and Hard Hilla's for far more HP, but
  # that is GMS's own number and it is kept.
  meso: 6760000
  # Paid for the clear, flat and unaffected by EXP bonuses, like the other
  # seven. GMS pays this one the least of the late bosses despite its length;
  # the clear is for the necklace and the shard.
  exp: 8473319
  # Normal's drops, with the Chaos necklace instead of the plain one. The shard
  # is the same, since a soul belongs to the boss, not the difficulty.
  drops {
    item: "horntails_soul_shard"
    per_kill: 1.0
  }
  drops {
    equip: "silver_blossom_ring"
    per_kill: 1.0
  }
  drops {
    equip: "chaos_horntail_necklace"
    per_kill: 1.0
  }
  drops {
    equip: "dea_sidus_earring"
    per_kill: 1.0
  }
}
