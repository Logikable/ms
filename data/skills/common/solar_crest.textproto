# The first clear of Seren opens it, at either difficulty; GMS asks a level 260
# quest and a Nodestone. There is no HP cost, as for True Arachnid Reflection.
#
# Mitra's Fire hits up to 15 enemies, then the Flame Emblem burns up to two
# every 2.1s for 51s, harder when only one is in reach: a lone boss takes the
# On One Enemy number, a two-part one the shared number on both.
name: "Solar Crest"
description:
  "Mitra's power manifests the searing heat of the sun as a blazing inferno. "
  "The flame emblem is unaffected by attack reflection."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 4 }
v_node: V_NODE_KIND_COMMON
unlock_boss: "seren"
max_level: 30
# masonym's frames, 720 + 60.
base_delay_ms: 780
cooldown_seconds: 230.0
max_enemies: 15
lines: 12
base { skill_pct: 7.8 }
per_level { skill_pct: 0.3 }
buff {
  duration_seconds: 51.0
  pulse {
    label: "Flame Emblem"
    cast_interval_seconds: 2.1
    lines: 6
    max_enemies: 2
    base { skill_pct: 2.08 }
    per_level { skill_pct: 0.08 }
    lone_skill_pct: 2.86
    lone_skill_pct_per_level: 0.11
  }
}
# v272's per-job damage, from the client's attackInfo (400001059). The Hero,
# Fire/Poison and Bishop keep the shared numbers.
line_overrides {
  line: JOB_PAGE
  skill {
    base { skill_pct: 13.25 }
    per_level { skill_pct: 0.51 }
    buff {
      pulse {
        base { skill_pct: 3.42 }
        per_level { skill_pct: 0.14 }
        lone_skill_pct: 4.77
        lone_skill_pct_per_level: 0.19
      }
    }
  }
}
