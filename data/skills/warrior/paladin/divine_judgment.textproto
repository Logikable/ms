# A brand is on the ENEMY, as in GMS: every Blast that hits one brands it, and
# the fifth brand detonates on that enemy alone, on top of the strike that
# triggered it. So a boss with several bodies gives several detonations, and a
# monster that dies at four brands gives none, which suits a bossing passive.
#
# GMS's own ladder, 502+4x%. At max the detonation is 6220% against Blast's
# 3400%, so a Blast that triggers one lands nearly twice what the four before
# did. It is the first number to trim if the Paladin outgrows the Dark Knight.
#
# Its 20% Ignore DEF is the point of the skill. It applies to this swing only,
# which is what ied_pct on an attack means (see WithoutSwingLevers).
name: "Divine Judgment"
description:
  "Marks enemies struck by your Blast skill with a Divine Brand. Upon "
  "reaching the max number of stacks, the Divine Brands detonate, inflicting "
  "additional damage that ignores some of the enemy's Defense."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN skill_order: 3 }
max_level: 30
exceeds_master_level: true
required_skill {
  skill_name: "Blast"
  level: 5
}
empowered_form {
  skill_name: "Blast"
  casts_per_trigger: 5
  brands_each_enemy: true
  lines: 10
  base {
    skill_pct: 5.06
    ied_pct: 0.20
  }
  per_level { skill_pct: 0.04 }
}
