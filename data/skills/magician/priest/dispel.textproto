# Gives nothing per level, on purpose. Nothing in this game inflicts a
# condition, so there is nothing to remove; the skill is kept for a boss that
# will, and for its Vengeance form, Triumph Feather. cures_conditions lets its
# page say what it does instead of looking empty.
name: "Dispel"
description: "Removes the abnormal conditions afflicting you."
kind: SKILL_KIND_PASSIVE
tags: SKILL_TAG_BENEVOLENCE
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 4 }
max_level: 10
base { cures_conditions: true }
