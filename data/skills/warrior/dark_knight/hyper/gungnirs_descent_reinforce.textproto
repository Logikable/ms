# GMS writes it "Damage: +20%": the %Damage stat for one swing, adding to what
# the character already has, not points on the skill's multiplier.
name: "Gungnir's Descent - Reinforce"
description: "Increases Gungnir's Descent's damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 10 }
hyper: true
required_level: 150
max_level: 1
boost {
  skill_name: "Gungnir's Descent"
  effect { damage_pct: 0.20 }
}
