# Nothing here has a position, so GMS's six zones are one rain.
#
# Four rains per cycle: a 40-second battle analysis counts 29 uses and 203 hits,
# seven lines a rain and 32 rains.
#
# The rain grows with the enemies the swing hits, not its own reach: GMS says
# "if currently attacking more than one enemy", and against Zakum or Horntail
# its own reach would give the fifteen-line rain meant for farming.
#
# Magic Arrow's doubling is read as doubling the rate. GMS words it against
# Quiver Cartridge, whose 30% doubled is Enchanted Quiver's 60%, which would
# give nothing to the only class that can cast this.
name: "Storm of Arrows"
description:
  "Arrows shot into the sky fall like rain. Unaffected by attack reflection."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER_V skill_order: 1 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 41.0
  duration_seconds_per_level: 1.0
  base { final_dmg_pct: 0.155 }
  per_level { final_dmg_pct: 0.005 }
  boost {
    skill_name: "Enchanted Quiver"
    final_attack_chance_mult: 2.0
  }
  pulse {
    label: "Arrow Rain"
    cast_interval_seconds: 5.0
    casts: 4
    max_enemies: 10
    lines: 7
    lines_per_extra_enemy: 2
    max_extra_lines: 8
    base { skill_pct: 7.80 }
    per_level { skill_pct: 0.30 }
  }
}
