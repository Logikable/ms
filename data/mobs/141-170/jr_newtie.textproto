# The head of a band that is on the game's curve rather than on GMS's own
# numbers. Leafre's dragon nests were written for their own era and sag a
# fifth under it; every mob from here to 168 sits on x1.053 HP / x1.038 EXP /
# x1.029 attack per level, the shape the ladder has held since level 98.
#
# HP is lifted by the same share as EXP, so the EXP a kill pays per point of
# HP stays GMS's -- lifting EXP alone would have made these maps cheap.
name: "Jr. Newtie"
level: 145
attack: 3391
max_hp: 1612800
exp: 8748
pdr: 10
drops { item: "egg_shell" per_kill: 0.4 }
drops { item: "frozen_weapon_token" per_kill: 0.0001 }
drops { item: "frozen_secondary_token" per_kill: 0.0001 }
drops { equip: "frozen_gloves" per_kill: 0.00025 }
drops { equip: "frozen_boots" per_kill: 0.00025 }
description: "A group of young dragons that live in the nest. The Jr. Newties cannot leave their nests, but they have the power to attack using a sound wave at a distance."
