# GMS states the whole Final Attack, so this supersedes Final Attack: Bow. GMS
# starts at 41%; 41.5% makes the ladder climb by an even 1.5%.
#
# The extra hit lands on one enemy: GMS's Final Attack has no mobCount of its
# own and its text says "attacks the boss with the highest HP first".
name: "Advanced Final Attack"
description:
  "Permanently increases Attack Power. Greatly increases activation rate and "
  "damage of Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 9 }
final_attack_max_enemies: 1
max_level: 20
exceeds_master_level: true
supersedes_skill_name: "Final Attack: Bow"
required_equip_type: EQUIP_TYPE_BOW
required_skill {
  skill_name: "Final Attack: Bow"
  level: 20
}
base {
  attack: 1
  final_attack_chance: 0.415
  final_attack_pct: 1.53
}
per_level {
  attack: 1
  final_attack_chance: 0.015
  final_attack_pct: 0.03
}
