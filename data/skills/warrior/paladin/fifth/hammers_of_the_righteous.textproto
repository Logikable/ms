# The Paladin's second class node: a ring of hammers that pulses every 0.63
# seconds for thirty seconds, on the same 30-of-60 window as Divine Echo. Shaped
# like Darkness Aura's aura, but nothing is released from it: the cast raises
# the ring, and the ring is the whole skill.
#
# 0.63s is the user's own measurement from a video, and the client agrees: the
# hit effect is seven frames of 90ms. attackDelay says 1800 and is not the
# rate: GMS's Phoenix states 3000 against a measured 1.71, so a summon's
# attackDelay overstates in both.
#
# GMS also attaches five of these to Vessel of Light for free, sharing its
# duration. Vessel of Light is a permanent passive here, so that half would keep
# the ring up forever and leave the active with nothing to add. Dropped; the
# timed ring is the skill.
name: "Hammers of the Righteous"
description:
  "Summons a whirling bulwark of righteous hammers to strike down nearby "
  "enemies. Unaffected by attack reflection."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_PALADIN_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
base_delay_ms: 120
cooldown_seconds: 60.0
buff {
  duration_seconds: 30.0
  pulse {
    label: "Hammers"
    cast_interval_seconds: 0.63
    lines: 4
    max_enemies: 8
    base { skill_pct: 5.46 }
    per_level { skill_pct: 0.21 }
  }
}
