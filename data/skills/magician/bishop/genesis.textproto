# GMS: 174+5x% ten times on 15 enemies every 30 seconds, plus 5+floor(x/2)%
# critical rate while it is in the air. Both ends are GMS's, stretched over 20
# levels instead of 30.
#
# The critical rate applies to this swing only and doesn't carry over, as GMS
# states on the skill itself rather than under a passive heading.
name: "Genesis"
description:
  "A holy ray of light shines down from the sky, dealing tremendous holy "
  "damage."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_HOLY
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 3 }
max_level: 20
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 660
max_enemies: 15
lines: 10
cooldown_seconds: 30.0
base {
  skill_pct: 1.815
  crit_rate: 0.048
}
per_level {
  skill_pct: 0.075
  crit_rate: 0.008
}
