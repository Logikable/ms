# GMS's shell: a set number of hits fully blocked, and a heal on cast that
# reaches the party too. The 90-second cooldown is GMS's own.
#
# The blocks go from 5 to 15, more than one a level, hence the fractional step,
# rounded down when read.
#
# GMS exempts attacks that deal a share of the target's Max HP and reduces them
# instead. Nothing here deals damage that way, so a boss's hit stands in for
# one: never blocked, and 10% less while the shell is up.
name: "Holy Magic Shell"
description:
  "Create a shield that blocks a set number of attacks on you and your party "
  "members, and restores a percentage of everyone's HP. Attacks that deal "
  "damage in proportion to Max HP are not blocked, and deal reduced damage "
  "instead."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 2 }
max_level: 20
base_delay_ms: 120
cooldown_seconds: 90.0
buff {
  duration_seconds: 10.25
  duration_seconds_per_level: 0.25
  base { heal_pct: 0.31 }
  per_level { heal_pct: 0.01 }
  ally_base { heal_pct: 0.31 }
  ally_per_level { heal_pct: 0.01 }
  shield {
    party: true
    hits: 5.5
    hits_per_level: 0.5
    boss_damage_taken_pct: 0.10
  }
}
