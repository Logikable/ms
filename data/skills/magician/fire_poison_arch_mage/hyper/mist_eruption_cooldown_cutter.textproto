# Halves the cooldown, from ten seconds to five. GMS also cuts two more seconds
# when a cast sets off five mists at once; nothing here places mists, so the
# count can't change and that half has nothing to count.
name: "Mist Eruption - Cooldown Cutter"
description: "Reduces Mist Eruption's cooldown."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 12 }
hyper: true
required_level: 190
max_level: 1
boost {
  skill_name: "Mist Eruption"
  cooldown_pct: 0.50
}
