# 3030ms is the client's, the same clock as Ifrit and Bahamut. GMS states no
# freeze duration for it, so it uses the family's.
#
# Spell Mastery stops counting: a character uses the better of two masteries,
# never their sum.
name: "Elquines"
description:
  "Summon Elquines. Elquines can attack multiple enemies at once. Attacks "
  "from Elquines freeze enemies. Permanently increases Spell Mastery."
kind: SKILL_KIND_AUTO_ATTACK
tags: SKILL_TAG_ICE
freeze_seconds: 8.0
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 5 }
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Spell Mastery"
  level: 10
}
max_enemies: 3
lines: 3
cast_interval_seconds: 3.0
base {
  skill_pct: 0.70
  mastery: 0.51
}
per_level {
  skill_pct: 0.03
  mastery: 0.01
}
