# A plain passive in modern GMS: the combo orb and max-enemy penalty were
# removed years ago.
name: "Enrage"
description:
  "Focuses your rage into your combo orbs to deal powerful damage to enemies."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 7 }
max_level: 30
exceeds_master_level: true
required_skill {
  skill_name: "Advanced Combo"
  level: 20
}
base {
  final_dmg_pct: 0.105
  crit_dmg: 0.0985
}
per_level {
  final_dmg_pct: 0.005
  crit_dmg: 0.0035
}
