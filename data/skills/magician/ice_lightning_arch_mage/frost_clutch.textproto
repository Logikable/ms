# One lever, flat: the final damage it comes to. GMS hangs this on Freezing
# Crush's ice stacks, which the engine now counts -- so the per-stack shape is
# open, and this file has not been rewritten to it.
#
# It does not pass its master level. GMS masters this at 1 and does not mark it
# for Combat Orders, so there is no level above the top for a grant to reach.
name: "Frost Clutch"
skill_order: 9
description: "A tightening grip of frost permanently increases your Final Damage."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE
max_level: 10
base { final_dmg_pct: 0.005 }
per_level { final_dmg_pct: 0.005 }
