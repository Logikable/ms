# 120ms, not the 900ms animation: buffs are cast from a skill sequence, which
# paces every skill in it the same way.
#
# GMS restores HP on a hit, not every hit, and gives no chance; the expected
# value is what an expected-damage fight can use, so it heals a share of HP on
# every swing. What it really gives a Dark Knight is the ability to keep
# attacking while Final Pact's cooldown runs.
name: "Dark Thirst"
description:
  "Channels your inner vampire to increase Attack Power and sap life from "
  "enemies."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 60.0
buff {
  duration_seconds: 20.0
  base {
    attack: 50
    hp_recover_pct: 0.09
  }
}
