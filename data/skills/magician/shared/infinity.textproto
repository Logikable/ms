# The reason to reach the class: 91% final damage, plus a tenth of HP back every
# five seconds whether the fight is going well or not.
#
# Combat Orders doesn't reach it, so it has no exceeds_master_level. GMS climbs
# it in steps of five levels to 30; twenty even levels reach the same 91%.
name: "Infinity"
description: "Bolsters the spirit to enhance your magic and recover HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 4 }
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE skill_order: 5 }
placement { job_advancement: JOB_ADVANCEMENT_BISHOP skill_order: 5 }
max_level: 20
base {
  final_dmg_pct: 0.15
  regen_pct: 0.10
  regen_interval_seconds: 5.0
}
per_level { final_dmg_pct: 0.04 }
