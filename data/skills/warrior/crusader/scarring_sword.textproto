# GMS calls it piercing the enemy; "pierce" already means an arrow through a row
# of enemies here, so the word comes from the sword.
#
# Nothing stops GMS's player recasting it, so it is always up. Its accuracy half
# is dropped: this game has no accuracy.
name: "Scarring Sword"
description:
  "Infuses the sword with spirit, which leaves an indelible scar on the "
  "enemy, weakening its attacks."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_CRUSADER skill_order: 5 }
max_level: 20
required_equip_type: EQUIP_TYPE_ONE_HANDED_SWORD
required_equip_type: EQUIP_TYPE_TWO_HANDED_SWORD
required_equip_type: EQUIP_TYPE_ONE_HANDED_AXE
required_equip_type: EQUIP_TYPE_TWO_HANDED_AXE
base {
  scar_chance: 0.43
  scar_seconds: 20.0
  enemy_attack_pct_when_scarred: 0.11
}
per_level {
  scar_chance: 0.03
  enemy_attack_pct_when_scarred: 0.01
}
