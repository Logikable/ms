name: "Magnus"
difficulties {
  name: "Normal"
  phases {
    bgm: "thefinalWar"
    spawns { mob: "magnus" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 600
  # Ahead of Pink Bean because he is the easier fight: unlocked at 170, half the
  # branches cleared him that day, while Pink Bean at 160 took until 168.
  unlock_level: 160
  # Five Intense Power Crystals at his level's price.
  meso: 12960000
  exp: 5300000
  drops {
    equip: "crystal_ventus_badge"
    per_kill: 1.0
  }
  drops {
    equip: "royal_black_metal_shoulder"
    per_kill: 1.0
  }
  drops {
    item: "magnuss_soul_shard"
    per_kill: 1.0
  }
}
difficulties {
  name: "Hard"
  phases {
    bgm: "thefinalWar"
    spawns { mob: "hard_magnus" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  time_limit_seconds: 900
  unlock_level: 200
  # Five Intense Power Crystals at GMS's price, divided by seven, since GMS
  # clears him once a week and this game once a day.
  meso: 13600000
  exp: 22000000
  # GMS pays Hard in Tyrant gear, a set this game doesn't have.
  drops {
    equip: "crystal_ventus_badge"
    per_kill: 1.0
  }
  drops {
    equip: "royal_black_metal_shoulder"
    per_kill: 1.0
  }
  drops {
    item: "magnuss_soul_shard"
    per_kill: 1.0
  }
}
