# Rolled once per swing, not per line: "when attacking" means the attack, and
# per line the recovery would multiply by the line count. Combat doesn't track
# MP, so that half is dropped.
name: "Mortal Blow"
description: "Chance to deal additional damage to an enemy and recover HP."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SNIPER skill_order: 5 }
max_level: 10
proc {
  chance: 0.01
  chance_per_level: 0.01
  base {
    damage_pct: 0.02
    hp_recover_pct: 0.01
  }
  per_level { damage_pct: 0.02 }
}
