# GMS runs this for 80 + 6*L seconds off an MP cost. There is no MP to spend
# and nothing runs out, so it simply stands.
#
# The attack is the party's, as GMS writes it -- "Attack Power of Party Members
# Including Yourself". The shelter and the reflection are the Fighter's alone.
name: "Spirit Blade"
description:
  "The sword and the spirit are united to improve the Attack Power of party "
  "members including yourself, and reflect a multiple of the damage that you "
  "receive."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_FIGHTER skill_order: 4 }
max_level: 20
base {
  attack: 11
  damage_taken_pct: 0.11
  damage_reflect_pct: 1.2
}
per_level {
  attack: 1
  damage_taken_pct: 0.01
  damage_reflect_pct: 0.2
}
ally_base { attack: 11 }
ally_per_level { attack: 1 }
