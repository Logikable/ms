# GMS maxes this at 10 with 25% of both. Stretched to 20 levels for the book's
# budget, ending at the same pair.
#
# The attack is a percentage of all attack, from gear and skills alike, and the
# Ignore DEF combines with the gear's multiplicatively instead of adding.
name: "Marksmanship"
description:
  "When attacking, ignores a portion of enemy DEF. Permanently increases your "
  "Attack Power."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 8 }
max_level: 20
base { ied_pct: 0.06 attack_pct: 0.06 }
per_level { ied_pct: 0.01 attack_pct: 0.01 }
