# The I/L Arch Mage's, unchanged: the largest single lever any book grants,
# over 20 levels rather than GMS's 30. Combat Orders does not carry it -- GMS
# lets it, and two free levels of this were not worth handing over.
name: "Infinity"
skill_order: 5
description:
  "A bolstered spirit permanently increases your Final Damage and steadily "
  "restores your HP."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE
max_level: 20
base {
  final_dmg_pct: 0.15
  regen_pct: 0.10
  regen_interval_seconds: 5.0
}
per_level { final_dmg_pct: 0.04 }
