# GMS reapplies this every 24-4*floor(L/4) seconds for 20+4L seconds, so it is
# almost always up, and there are no buff timers here anyway, so it just is.
#
# Party members get half, as GMS states, rounded down where the lever is a whole
# number. The DEF loses nine points at the top of its ladder because of that,
# which nobody will notice: DEF caps long before that.
#
# GMS's magic attack alongside the weapon attack is dropped: no warrior weapon
# has any, so it would be a row of zeroes.
name: "Hex of the Evil Eye"
description: "Your Evil Eye buffs you and your party members."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BERSERKER skill_order: 5 }
max_level: 20
base {
  attack: 2
  def: 25
  crit_rate: 0.005
}
per_level {
  attack: 2
  def: 25
  crit_rate: 0.005
}
ally_base {
  attack: 1
  def: 12
  crit_rate: 0.0025
}
ally_per_level {
  attack: 1
  def: 12
  crit_rate: 0.0025
}
