# The eye's own aura heals a flat 24 HP every 24 seconds, nothing against a 4th
# job HP bar, which is the whole reason this exists. The share sits BESIDE that
# pulse instead of replacing it: two fountains are two pulses here, and the flat
# one adds nothing at this level.
name: "Evil Eye - Aura Reinforce"
description: "Increases the amount healed by the Evil Eye."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_DARK_KNIGHT skill_order: 6 }
hyper: true
required_level: 180
max_level: 1
base {
  regen_pct: 0.10
  regen_interval_seconds: 24.0
}
