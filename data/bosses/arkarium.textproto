name: "Arkarium"
difficulties {
  name: "Normal"
  # One body alone in the middle of his arena, like Hilla and Magnus.
  phases {
    bgm: "AltarOfAkayrum"
    spawns { mob: "arkarium" spots { x: 4 y: 4 } }
    player_spots { x: 4 y: 5 }
    player_spots { x: 0 y: 5 }
    player_spots { x: 8 y: 5 }
    player_spots { x: 2 y: 5 }
    player_spots { x: 6 y: 5 }
    arena_width: 9
    arena_height: 6
  }
  reset: RESET_PERIOD_DAILY
  # The same as Horntail, Magnus and Pink Bean. He has nearly twice Pink Bean's
  # HP and 90% PDR, so the time limit is a real part of the fight.
  time_limit_seconds: 600
  unlock_level: 180
  # Five Intense Power Crystals at his level's price, like every boss's meso.
  meso: 12602500
  # Paid for the clear, flat and unaffected by EXP bonuses, like the other five.
  # Five times Pink Bean's, the same gap GMS has between the two.
  exp: 50000000
  drops {
    equip: "dominator_pendant"
    per_kill: 1.0
  }
  drops {
    item: "arkariums_soul_shard"
    per_kill: 1.0
  }
}
