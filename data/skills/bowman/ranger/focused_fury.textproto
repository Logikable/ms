# GMS splits this in two: a permanent 20 status resistance, and a buff that
# builds another 100 while the Ranger keeps attacking. A Ranger is always
# attacking, so here the two are one figure, which is where the 6 a level comes
# from.
#
# Nothing in this game inflicts a status or element, so neither figure is used.
# Both are on the stats page so the SP isn't spent blind.
name: "Focused Fury"
description: "Permanently increases Status Resistance and Elemental Resistance."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 6 }
max_level: 20
base { status_resistance: 6 elemental_resistance: 0.01 }
per_level { status_resistance: 6 elemental_resistance: 0.01 }
