# Hits are lines, so a fast multi-line swing keeps it up. Nothing counts while
# the window is up, which caps its uptime however fast the character attacks.
name: "Mortal Blow"
description:
  "If the attack hits a certain number of times, the damage increases."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_RANGER skill_order: 5 }
max_level: 10
buff {
  base { damage_pct: 0.08 }
  per_level { damage_pct: 0.03 }
  duration_seconds: 5.0
  charge_lines: 30
}
