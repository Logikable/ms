# GMS's own twenty points. The coins are thrown, not swung, so a boost aimed at
# Meso Explosion applies where the throw is calculated (see FoldMesoExplosion).
name: "Meso Explosion - Reinforce"
description: "Increases Meso Explosion's damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Meso Explosion"
  effect { damage_pct: 0.20 }
}
