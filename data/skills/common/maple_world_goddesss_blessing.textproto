# The one node that gives nothing by itself. It multiplies Maple Warrior: GMS's
# "increases stat bonuses as Maple Warrior by 400%" counts the base hundred, so
# 15% of pure stat becomes 60%, not 75%. The value here is what is added to that
# hundred: 10% a level, 300% at max.
#
# GMS won't let a character without Maple Warrior cast it. Nothing needs to
# check here: four times nothing is nothing, and every book has Maple Warrior
# anyway.
#
# Damage is GMS's 5 + floor(x/2)%, ending at 20%. It keeps that top with a
# simple half a point a level, so only the start moves, as Decent Holy Symbol
# does.
name: "Maple World Goddess's Blessing"
description:
  "The Maple World Goddess's Blessing increases all stats and damage. Can "
  "only be used when you have Maple Warrior."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_COMMON skill_order: 1 }
v_node: V_NODE_KIND_COMMON
max_level: 30
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 60.0
  base {
    ap_stat_bonus_pct: 0.10
    damage_pct: 0.055
  }
  per_level {
    ap_stat_bonus_pct: 0.10
    damage_pct: 0.005
  }
}
