# GMS maxes this at 4 for 40% critical rate and 70% magic mastery; here the same
# tops over ten levels, four points of crit and two of mastery a level.
#
# The mastery doesn't stack with Spell Mastery's 50%; no masteries stack. The
# character uses the better one, which is this from level 2.
name: "Holy Focus"
description: "Permanently increases your Critical Rate and Magic Mastery."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_PRIEST skill_order: 8 }
max_level: 10
base {
  crit_rate: 0.04
  mastery: 0.52
}
per_level {
  crit_rate: 0.04
  mastery: 0.02
}
