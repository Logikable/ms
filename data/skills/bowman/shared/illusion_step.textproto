# GMS maxes this at 30 with 80 DEX, 30% avoidability and 20% less damage taken.
# Compressed to 10 levels ending at all three, so each point is worth three of
# GMS's and the skill is no stronger.
#
# The avoidability is the flat kind (GMS's Bonus Avoidability Chance, a roll
# that cancels the whole hit), which is what dodge_chance is. It combines with
# Evasion Boost's as two separate rolls, so together they give 51%, not 60%.
# Knockback resistance is left out: no mob knocks back.
name: "Illusion Step"
description:
  "Greatly increases your DEX and Avoidability, and reduces damage taken."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BOW_MASTER skill_order: 8 }
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 8 }
max_level: 10
exceeds_master_level: true
base {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
per_level {
  dex: 8
  dodge_chance: 0.03
  damage_taken_pct: 0.02
}
