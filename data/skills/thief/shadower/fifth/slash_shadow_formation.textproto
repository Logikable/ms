# The client spaces the nine allies 900 down to 120ms apart, then the leader
# lands at 4170ms. One ignoreMobpdpR of 100 covers the whole skill.
#
# The nine land together, not spaced with cast_interval_ms: spaced, the leader
# would land nine times, and BarrageStrikes would price the 3.7-second beat at
# 0.29 of a strike.
#
# GMS skips the 600ms cast while Assassinate or Cruel Stab is running, which for
# a Shadower is always (see waives_cast).
name: "Slash Shadow Formation"
description:
  "Team up with dark allies in a special formation to perform a joint attack. "
  "Unaffected by the effects of Shadow Partner."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_SHADOWER_V skill_order: 4 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_DAGGER
base_delay_ms: 600
waives_cast: true
cooldown_seconds: 120.0
max_enemies: 6
lines: 11
casts: 9
skips_mirror: true
base {
  skill_pct: 7.33
  ied_pct: 1.00
}
per_level { skill_pct: 0.28 }
extra_hit {
  label: "Leader's Slash"
  max_enemies: 8
  lines: 15
  casts: 8
  base { skill_pct: 8.20 }
  per_level { skill_pct: 0.30 }
}
