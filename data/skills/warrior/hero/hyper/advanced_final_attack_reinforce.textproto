# GMS writes it "Damage: +10%", the %Damage stat, not points on the Final
# Attack's multiplier, so it adds to what the character already has and only the
# extra hits get it.
#
# It targets Advanced Final Attack by name even though that is a passive, which
# a boost normally can't reach. It boosts the extra hit, not a swing; see
# SkillBoost.effect.
name: "Advanced Final Attack - Reinforce"
description:
  "Increases the damage of Advanced Final Attack."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_HERO skill_order: 7 }
hyper: true
required_level: 140
max_level: 1
boost {
  skill_name: "Advanced Final Attack"
  effect { damage_pct: 0.10 }
}
