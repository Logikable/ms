# HP and EXP both lifted 21.6% off GMS's numbers. Leafre's dragon nests
# were written for their own era and sit a fifth under the curve the rest of
# the game runs on; EXP alone would have made the map unusually cheap, so the
# HP goes with it and the EXP a kill pays per point of HP stays GMS's.
name: "Jr. Newtie"
level: 145
attack: 3331
max_hp: 1612800
exp: 8748
drops { item: "egg_shell" per_kill: 0.4 }
