# GMS's MP buff and permanent passive are added and always on.
#
# GMS's damage reduction by missing HP is dropped: it pays most when nearly
# dead, and a fight that heals every beat never stays there.
name: "Cross Surge"
description: "Increases Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BERSERKER skill_order: 2 }
max_level: 20
base { final_dmg_pct: 0.225 }
per_level { final_dmg_pct: 0.025 }
