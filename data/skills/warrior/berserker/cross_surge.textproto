# GMS splits this in two: a buff worth 10+floor(L/2)% final damage that costs MP
# and runs on a timer, and a permanent passive worth 2L+10%. Nothing here uses
# MP or times it, so the two are added and always on: 22.5% at level 1, up to
# 70% at 20.
#
# GMS's other half reduces damage taken by a share of the character's missing
# HP. That is dropped: it pays most when nearly dead, and a fight that heals a
# tenth of HP every beat never stays there.
name: "Cross Surge"
description: "Increases Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BERSERKER skill_order: 2 }
max_level: 20
base { final_dmg_pct: 0.225 }
per_level { final_dmg_pct: 0.025 }
