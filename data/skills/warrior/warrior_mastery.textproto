# The HP is the whole skill for us: its other effects (speed, jump, max speed,
# knockback resistance) are things this game doesn't model. It ends where GMS
# ends it, at 20 HP a character level, but climbs there a point at a time rather
# than handing over most of the value with the first point.
name: "Warrior Mastery"
skill_order: 3
description:
  "The groundwork every warrior is built on. Permanently increases Max HP."
kind: SKILL_KIND_PASSIVE
job_advancement: JOB_ADVANCEMENT_SWORDMAN
max_level: 20
base {
  max_hp_per_level: 1
}
per_level {
  max_hp_per_level: 1
}
