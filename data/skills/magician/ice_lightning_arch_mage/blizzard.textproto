# Two skills on one ladder: the screen-wide swing on a 45-second cooldown, and a
# Final Attack that follows every other swing while it recharges. It freezes the
# room it hits, as GMS says, for eight seconds, like the rest of the family; GMS
# states no number of its own. The fight uses Chain Lightning in between, which
# is why this one can hit so hard.
#
# The Final Attack falls on one enemy, as GMS states, which is the usual rule.
# See Skill.final_attack_max_enemies.
name: "Blizzard"
description:
  "Summon spears of ice from the sky, showering multiple enemies with a nasty "
  "blizzard to freeze them. Upon attacking, permanently grants a chance to "
  "damage a single enemy with a Blizzard."
kind: SKILL_KIND_ATTACK
tags: SKILL_TAG_ICE
freeze_seconds: 8.0
placement { job_advancement: JOB_ADVANCEMENT_ICE_LIGHTNING_ARCH_MAGE skill_order: 2 }
max_level: 30
final_attack_label: "Blizzard"
required_equip_type: EQUIP_TYPE_STAFF
exceeds_master_level: true
base_delay_ms: 900
max_enemies: 15
lines: 12
cooldown_seconds: 45.0
final_attack_max_enemies: 1
base {
  skill_pct: 2.14
  final_attack_chance: 0.02
  final_attack_pct: 1.04
}
per_level {
  skill_pct: 0.03
  final_attack_chance: 0.02
  final_attack_pct: 0.04
}
