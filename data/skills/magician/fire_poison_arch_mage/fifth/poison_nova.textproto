# The F/P's second class node, and the branch's other half: DoT Punisher pays
# off the poison already laid, and this one sets up a nuke and then detonates
# it.
#
# Fifteen clouds spread out in a ring, and GMS says each enemy takes only one,
# so the cast is a plain wide swing, not a scattered one: twelve lines on each
# of up to fifteen enemies. The reach is the cloud count, so a sixteenth enemy
# is untouched.
#
# The detonation is where the damage is, and it has no key of its own. GMS
# leaves the clouds up and lets Mist Eruption set them off, so it is a magazine
# used by that press: one charge, gone with the clouds whether used or not,
# costing nothing beyond the button the player was pressing anyway. Fifteen
# bursts spread over twelve enemies, no more than GMS's three on any one, so a
# lone boss takes three of the fifteen and the rest hit nothing.
#
# GMS's "1 sec. or more after" isn't modelled and can't matter: Poison Nova's
# own 660ms plus Mist Eruption's cooldown is always longer than a second.
#
# The clouds' lifetime isn't published. Ten seconds is the length of the burn
# they lay, which is the same thing, since the cloud IS the poison.
name: "Poison Nova"
description:
  "Releases a poisonous cloud that spreads in all directions, striking "
  "nearby enemies. You can detonate the cloud to inflict additional damage. "
  "Unaffected by attack reflection."
kind: SKILL_KIND_ATTACK
placement { job_advancement: JOB_ADVANCEMENT_FIRE_POISON_ARCH_MAGE_V skill_order: 2 }
v_node: V_NODE_KIND_JOB
max_level: 30
required_equip_type: EQUIP_TYPE_STAFF
base_delay_ms: 660
cooldown_seconds: 25.0
max_enemies: 15
lines: 12
base { skill_pct: 2.60 }
per_level { skill_pct: 0.10 }
dot {
  interval_seconds: 1.0
  duration_seconds: 10.0
  lines: 1
  base { skill_pct: 3.12 }
  per_level { skill_pct: 0.12 }
}
buff {
  duration_seconds: 10.0
  raised_on_cast: true
  magazine {
    label: "Nova Detonation"
    spent_by_skill_name: "Mist Eruption"
    charges: 1
    max_enemies: 12
    lines: 12
    scatter {
      hits: 15
      max_hits_per_enemy: 3
    }
    base { skill_pct: 7.02 }
    per_level { skill_pct: 0.27 }
  }
}
