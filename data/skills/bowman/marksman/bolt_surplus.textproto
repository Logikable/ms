# GMS: "+1 attack to all multi-hit skills. Does not apply to Summon, 5th Job
# Common, or certain skills." Each exclusion follows from how swings work here:
# a summon fires on its own clock and a Final Attack has no line count, so the
# lever needs no list.
#
# The extra strike is worth most on the shortest swings: a ninth more on Snipe's
# nine lines, a fifth more on Piercing Arrow II's five.
name: "Bolt Surplus"
description:
  "Increases the number of attacks for all multi-hit skills and Final Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 9 }
max_level: 10
exceeds_master_level: true
base {
  final_dmg_pct: 0.06
  bonus_attack_lines: 1
}
per_level { final_dmg_pct: 0.01 }
