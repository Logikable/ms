# 120ms, not the 960ms animation: buffs are cast from a skill sequence, which
# paces every skill in it the same way.
#
# Four levers for forty seconds with a cooldown three times that, the broadest
# buff either archer gets; the Bow Master's Concentration has two.
name: "Bullseye Shot"
description:
  "Hone in on the enemy's weak spot for a devastating shot."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 1 }
hyper: true
required_level: 140
max_level: 1
base_delay_ms: 120
cooldown_seconds: 120.0
buff {
  duration_seconds: 40.0
  base {
    damage_pct: 0.20
    crit_rate: 0.20
    crit_dmg: 0.10
    ied_pct: 0.20
  }
}
