# Cast instead of a swing when HP drops below kHealBelowFraction (fight.cc),
# like the Cleric's Heal.
#
# The penalty for recasting it soon after is dropped, as the user asked.
name: "HP Recovery"
description: "Instantly recovers your HP."
kind: SKILL_KIND_ACTIVE
placement { job_advancement: JOB_ADVANCEMENT_WHITE_KNIGHT skill_order: 2 }
max_level: 10
base_delay_ms: 720
base { heal_pct: 0.23 }
per_level { heal_pct: 0.03 }
