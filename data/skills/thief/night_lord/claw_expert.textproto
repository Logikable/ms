# The book's mastery skill, on the ladder every 4th job uses: 51% at level 1 to
# 70% at 20. GMS gives x attack and floor(x/3)% critical damage over 30 levels;
# here it has twenty, so attack rises a point a level and critical damage is
# flat at GMS's top.
name: "Claw Expert"
description: "Increases Claw Mastery, Attack Power, and Critical Damage."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_NIGHT_LORD skill_order: 10 }
max_level: 20
exceeds_master_level: true
required_skill {
  skill_name: "Claw Mastery"
  level: 10
}
base {
  mastery: 0.51
  attack: 11
  crit_dmg: 0.10
}
per_level {
  mastery: 0.01
  attack: 1
}
