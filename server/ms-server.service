# The systemd user unit that runs the server on the box. tools/deploy_server.sh
# installs it at ~/.config/systemd/user/ms-server.service.
#
# The user needs lingering turned on (`sudo loginctl enable-linger <user>`), or
# the service stops when the last login session ends.

[Unit]
Description=MapleStory idle game server
After=network-online.target

[Service]
ExecStart=%h/ms/ms_server --port=21711 --log_dir=%h/ms/logs
Restart=always
RestartSec=2
# On SIGTERM the server stops taking connections, sends every client a
# maintenance notice, and exits once they have all disconnected.
KillSignal=SIGTERM
TimeoutStopSec=360

[Install]
WantedBy=default.target
