# The one hyper of the three that leaves the fragment alone, which the data
# already does: the fragment is the opening hit, and it lands on the two
# enemies it names however wide the arrow goes.
#
# The empowered form's explosion is not that fragment. GMS gives it the same
# reach as the arrow it ends -- ten to the arrow's ten -- so it follows the
# arrow out to twelve here, as an extra hit always reaches whatever the swing
# reached.
name: "Piercing Arrow - Spread"
description:
  "Increases the max number of enemies hit by Piercing Arrow, Piercing Arrow "
  "II, Empowered Piercing Arrow, and Empowered Piercing Arrow II. Doesn't "
  "apply to the Arrow Fragments generated when Piercing Arrow lands."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_MARKSMAN skill_order: 8 }
hyper: true
required_level: 165
max_level: 1
boost {
  skill_name: "Piercing Arrow"
  max_enemies: 2
  reach: BOOST_REACH_BOTH
}
boost {
  skill_name: "Piercing Arrow II"
  max_enemies: 2
  reach: BOOST_REACH_BOTH
}
