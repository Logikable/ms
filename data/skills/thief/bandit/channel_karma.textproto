# GMS gives 11+x attack over 19 levels, ending at 30. Here it is the same 12 to
# 30 over 10 levels.
#
# Its knockback resistance is dropped: nothing in this game knocks the player
# back.
name: "Channel Karma"
description: "Increases your Attack Power."
kind: SKILL_KIND_PASSIVE
placement { job_advancement: JOB_ADVANCEMENT_BANDIT skill_order: 5 }
max_level: 10
base { attack: 12 }
per_level { attack: 2 }
